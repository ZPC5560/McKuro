<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:ic="using:FluentIcons.Avalonia"
             x:Class="McKuro.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />

        <!-- 全站统一的「透明底图标按键」(主页昵称旁的账号切换 / 启动页右下角的资源分级切换 /
             启动页左上角的游戏功能菜单):按键底完全透明,只有按键上的图标呈半透明;
             悬停才浮出一点玻璃底作为可点反馈。
             尺寸/圆角/内边距由使用处自己设(局部属性优先于本样式),外观一处改全站生效。
             前景色<b>也</b>由使用处自己设:压在自有玻璃底上的用主题令牌(McKuroTextOnWallpaper),
             直接压在视频上的用不随主题翻转的 McKuroTextOnVideo + VideoTextChrome 反向投影阴影。 -->
        <Style Selector="Button.mcChrome">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource McKuroTextOnWallpaper}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mcChrome:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipFillHover}" />
        </Style>
        <Style Selector="Button.mcChrome ic|FluentIcon">
            <Setter Property="Opacity" Value="0.72" />
        </Style>
        <Style Selector="Button.mcChrome:pointerover ic|FluentIcon">
            <Setter Property="Opacity" Value="0.95" />
        </Style>

        <!-- 全站统一的「浮层面板」材质:启动页功能菜单、资源等级展开面板、账号切换弹窗、
             版本选择弹窗共用同一份面色 + 描边 + 圆角。
             之前每个面板各自重述一遍背景(两层不透明叠加 / 单层 DialogSurface / SemiColorBg2…),
             于是"展开后的材质"彼此不一致(2026-10 用户反馈) —— 收敛成一处,以后改一处全站同步。
             个别面板要更大的圆角或外边距,用局部属性覆盖即可(局部优先于样式)。 -->
        <Style Selector="Border.mcPanel">
            <Setter Property="Background" Value="{DynamicResource McKuroDialogSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource McKuroSwitchChipStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
    </Application.Styles>

    <!--
      McKuro 语义材质：壁纸动态色板功能已移除，改为按明暗主题(跟随系统/浅色/深色)静态切换。
      Dark/Light 两套资源通过 ThemeDictionaries 自动跟随 RequestedThemeVariant，
      与 Semi 主题一致，设置页切换主题后即时生效，无需代码刷新。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="McKuroAccent" Color="#5A8DEE" />
                    <SolidColorBrush x:Key="McKuroAccentHover" Color="#78A2F1" />
                    <SolidColorBrush x:Key="McKuroBackdropBase" Color="#070C18" />
                    <SolidColorBrush x:Key="McKuroBackdropTint" Color="#9E050A18" />
                    <!-- 系统材质模式(Mica/Acrylic/毛玻璃):涂抹层弱化,露出 OS 原生背景 -->
                    <SolidColorBrush x:Key="McKuroBackdropTintMaterial" Color="#6E050A18" />
                    <SolidColorBrush x:Key="McKuroNavFillMaterial" Color="#3D141D32" />
                    <SolidColorBrush x:Key="McKuroContentTintMaterial" Color="#59050A18" />
                    <SolidColorBrush x:Key="McKuroGlassFill" Color="#94141D32" />
                    <SolidColorBrush x:Key="McKuroGlassFillStrong" Color="#C611192D" />
                    <SolidColorBrush x:Key="McKuroGlassStroke" Color="#70CDE0FA" />
                    <SolidColorBrush x:Key="McKuroNavDivider" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="McKuroTextOnWallpaper" Color="#F5F8FF" />
                    <SolidColorBrush x:Key="McKuroTextMuted" Color="#BFCCE2" />
                    <SolidColorBrush x:Key="McKuroAccentGlow" Color="#565A8DEE" />
                    <SolidColorBrush x:Key="McKuroNavFill" Color="#C611192D" />
                    <SolidColorBrush x:Key="McKuroContentTint" Color="#9E050A18" />
                    <!-- 浮层弹窗面:不透明(半透明 ContentTint 叠在页面文字上会透出,且 Avalonia 12.1 无窗口内 backdrop 模糊 API) -->
                    <SolidColorBrush x:Key="McKuroDialogFill" Color="#FF18223A" />
                    <!-- 通知卡片/Toast 面:用不透明面色。
                         原先用 ExperimentalAcrylicBorder + DynamicResource Material:该组合在把卡片加入可视树时
                         (SetParent → DynamicResourceExpression.ActualThemeVariantChanged → UpdateMaterialSubscription)
                         会在 Avalonia 12.1.2 内抛 NullReferenceException,且是未处理异常 → 进程直接终止,
                         表现为"通知一来软件就卡死/消失"。原材质 TintOpacity=0.88、MaterialOpacity=0.85,
                         等效观感已接近不透明,故改为等效面色后视觉几乎不变,并彻底消除该崩溃路径。 -->
                    <SolidColorBrush x:Key="McKuroCardFill" Color="#E618223A" />
                    <SolidColorBrush x:Key="McKuroCardStroke" Color="#59FFFFFF" />
                    <BoxShadows x:Key="McKuroCardShadow">0 14 40 0 #8C000000</BoxShadows>
                    <SolidColorBrush x:Key="McKuroHomeScrim" Color="#48070C18" />
                    <!-- 桥接 Semi 基础表面/主色，让业务页半透明玻璃与 McKuro 语义一致(对齐原 ThemePaletteService) -->
                    <SolidColorBrush x:Key="SemiColorBg0" Color="#070C18" />
                    <SolidColorBrush x:Key="SemiColorBg1" Color="#94141D32" />
                    <SolidColorBrush x:Key="SemiColorBg2" Color="#94141D32" />
                    <SolidColorBrush x:Key="SemiColorBg3" Color="#C611192D" />
                    <SolidColorBrush x:Key="SemiColorText1" Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="SemiColorText2" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="SemiColorText3" Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="SemiColorPrimary" Color="#5A8DEE" />
                    <SolidColorBrush x:Key="SemiColorPrimaryHover" Color="#78A2F1" />
                    <!-- 图标底板(技能/共鸣链等白色线稿图标需深底才可见);暗色主题用深板岩蓝 -->
                    <SolidColorBrush x:Key="McKuroIconPlate" Color="#FF33445E" />
                    <!-- 数值输入框面(深色主题):比卡片面更暗 + 可见描边,与卡片拉开层级 -->
                    <SolidColorBrush x:Key="McKuroInputFill" Color="#CC0B1223" />
                    <SolidColorBrush x:Key="McKuroInputStroke" Color="#4DFFFFFF" />
                    <SolidColorBrush x:Key="McKuroInputStrokeHover" Color="#80CDE0FA" />
                    <!-- 判定徽章语义色(UP/歪/保底规则):tint 胶囊底 + 文字色,暗色提亮文字保证可读 -->
                    <SolidColorBrush x:Key="McKuroSuccess" Color="#73D13D" />
                    <SolidColorBrush x:Key="McKuroSuccessTint" Color="#1A52C41A" />
                    <SolidColorBrush x:Key="McKuroDanger" Color="#FF7875" />
                    <SolidColorBrush x:Key="McKuroDangerTint" Color="#29F53F3F" />
                    <SolidColorBrush x:Key="McKuroInfo" Color="#4096FF" />
                    <SolidColorBrush x:Key="McKuroInfoTint" Color="#241677FF" />
                    <SolidColorBrush x:Key="McKuroWarning" Color="#FFC53D" />
                    <SolidColorBrush x:Key="McKuroWarningTint" Color="#29FA8C16" />
                    <!-- 全息战略「已通关/满档」的金色:
                         暗色主题用亮金(#FFD24D 在深底上对比充足),
                         亮色主题必须压暗(#B8860B 系),否则浅底上的黄字几乎看不见
                         —— 用户实测反馈「当期难度文本在白色主题下不明显」。 -->
                    <SolidColorBrush x:Key="McKuroHoloGold" Color="#FFD24D" />
                    <SolidColorBrush x:Key="McKuroHoloGoldSoft" Color="#E0B94E" />
                    <SolidColorBrush x:Key="McKuroHoloPipEmpty" Color="#4A4E58" />
                    <!-- 账号/版本切换按键与列表项:
                         按键本身透明底(仅悬停给一点反馈),列表项用极淡的中性面;
                         选中项用「主题强调色」淡染底 + 强调色描边 + 高对比文字(对齐 Haiyu 的蓝框选中),
                         不再用整块反色硬底——纯黑/纯白大块在浅色面板上非常刺眼。 -->
                    <SolidColorBrush x:Key="McKuroSwitchChipFill" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="McKuroSwitchChipFillHover" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="McKuroSwitchChipStroke" Color="#2AFFFFFF" />
                    <SolidColorBrush x:Key="McKuroSwitchChipSelectedFill" Color="#3D5A8DEE" />
                    <SolidColorBrush x:Key="McKuroSwitchChipSelectedStroke" Color="#B48FB8F0" />
                    <SolidColorBrush x:Key="McKuroSwitchChipSelectedText" Color="#F5F8FF" />
                    <!-- 弹窗面板面色:比 McKuroGlassFillStrong 更透一档(70%),让系统材质透出来,
                         同时保证列表文字仍有一层稳定底,不会直接压在壁纸/Live2D 上 -->
                    <SolidColorBrush x:Key="McKuroDialogSurface" Color="#B3141D32" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="McKuroAccent" Color="#5A8DEE" />
                    <SolidColorBrush x:Key="McKuroAccentHover" Color="#4F7CD1" />
                    <SolidColorBrush x:Key="McKuroBackdropBase" Color="#EEF3FA" />
                    <SolidColorBrush x:Key="McKuroBackdropTint" Color="#94F6F9FD" />
                    <!-- 系统材质模式(Mica/Acrylic/毛玻璃):涂抹层弱化,露出 OS 原生背景 -->
                    <SolidColorBrush x:Key="McKuroBackdropTintMaterial" Color="#73EEF3FA" />
                    <SolidColorBrush x:Key="McKuroNavFillMaterial" Color="#45FFFFFF" />
                    <SolidColorBrush x:Key="McKuroContentTintMaterial" Color="#8CF6F9FD" />
                    <SolidColorBrush x:Key="McKuroGlassFill" Color="#ACFFFFFF" />
                    <SolidColorBrush x:Key="McKuroGlassFillStrong" Color="#DAFFFFFF" />
                    <SolidColorBrush x:Key="McKuroGlassStroke" Color="#64627D" />
                    <SolidColorBrush x:Key="McKuroNavDivider" Color="#29000000" />
                    <SolidColorBrush x:Key="McKuroTextOnWallpaper" Color="#19202E" />
                    <SolidColorBrush x:Key="McKuroTextMuted" Color="#4E5B70" />
                    <SolidColorBrush x:Key="McKuroAccentGlow" Color="#345A8DEE" />
                    <SolidColorBrush x:Key="McKuroNavFill" Color="#DAFFFFFF" />
                    <SolidColorBrush x:Key="McKuroContentTint" Color="#94F6F9FD" />
                    <!-- 浮层弹窗面:不透明(半透明 ContentTint 叠在页面文字上会透出,且 Avalonia 12.1 无窗口内 backdrop 模糊 API) -->
                    <SolidColorBrush x:Key="McKuroDialogFill" Color="#FFFFFFFF" />
                    <!-- 通知卡片/Toast 面:浅色主题等效面色(理由同暗色主题:Acrylic + DynamicResource 会崩溃) -->
                    <SolidColorBrush x:Key="McKuroCardFill" Color="#F2FFFFFF" />
                    <SolidColorBrush x:Key="McKuroCardStroke" Color="#8CFFFFFF" />
                    <BoxShadows x:Key="McKuroCardShadow">0 12 36 0 #42000000</BoxShadows>
                    <SolidColorBrush x:Key="McKuroHomeScrim" Color="#26EEF3FA" />
                    <SolidColorBrush x:Key="SemiColorBg0" Color="#EEF3FA" />
                    <SolidColorBrush x:Key="SemiColorBg1" Color="#ACFFFFFF" />
                    <SolidColorBrush x:Key="SemiColorBg2" Color="#ACFFFFFF" />
                    <SolidColorBrush x:Key="SemiColorBg3" Color="#DAFFFFFF" />
                    <SolidColorBrush x:Key="SemiColorText1" Color="#E6000000" />
                    <SolidColorBrush x:Key="SemiColorText2" Color="#99000000" />
                    <SolidColorBrush x:Key="SemiColorText3" Color="#66000000" />
                    <SolidColorBrush x:Key="SemiColorPrimary" Color="#5A8DEE" />
                    <SolidColorBrush x:Key="SemiColorPrimaryHover" Color="#4F7CD1" />
                    <!-- 图标底板(技能/共鸣链等白色线稿图标需深底才可见):
                         亮色主题用中等板岩蓝而非近黑——原 #33455C→#1C2836 渐变在浅色卡片上过重(用户反馈)。
                         白描线在中板岩蓝上对比度足够,同时不再"压一块黑"。 -->
                    <SolidColorBrush x:Key="McKuroIconPlate" Color="#FF6B85B8" />
                    <!-- 数值输入框面(亮色主题):设置页卡片接近纯白,填纯白会"看不见框",
                         故用淡灰底 + 清晰描边,读数与可编辑性都一目了然 -->
                    <SolidColorBrush x:Key="McKuroInputFill" Color="#FFF2F5F9" />
                    <SolidColorBrush x:Key="McKuroInputStroke" Color="#FFD8DFEA" />
                    <SolidColorBrush x:Key="McKuroInputStrokeHover" Color="#FFA9B6CC" />
                    <!-- 判定徽章语义色(亮色主题:文字用深色调保证白底可读) -->
                    <SolidColorBrush x:Key="McKuroSuccess" Color="#389E0D" />
                    <SolidColorBrush x:Key="McKuroSuccessTint" Color="#1A52C41A" />
                    <SolidColorBrush x:Key="McKuroDanger" Color="#CF1322" />
                    <SolidColorBrush x:Key="McKuroDangerTint" Color="#1AF53F3F" />
                    <SolidColorBrush x:Key="McKuroInfo" Color="#0958D9" />
                    <SolidColorBrush x:Key="McKuroInfoTint" Color="#1A1677FF" />
                    <SolidColorBrush x:Key="McKuroWarning" Color="#D48806" />
                    <SolidColorBrush x:Key="McKuroWarningTint" Color="#1AFA8C16" />
                    <!-- 全息战略金色:亮色主题压暗(理由见暗色主题同类注释) -->
                    <SolidColorBrush x:Key="McKuroHoloGold" Color="#B8860B" />
                    <SolidColorBrush x:Key="McKuroHoloGoldSoft" Color="#9A7209" />
                    <SolidColorBrush x:Key="McKuroHoloPipEmpty" Color="#C9CDD6" />
                    <!-- 账号/版本切换按键:亮色主题下的同族令牌(理由见暗色主题同类注释) -->
                    <SolidColorBrush x:Key="McKuroSwitchChipFill" Color="#0D000000" />
                    <SolidColorBrush x:Key="McKuroSwitchChipFillHover" Color="#1F000000" />
                    <SolidColorBrush x:Key="McKuroSwitchChipStroke" Color="#1A000000" />
                    <SolidColorBrush x:Key="McKuroSwitchChipSelectedFill" Color="#261677FF" />
                    <SolidColorBrush x:Key="McKuroSwitchChipSelectedStroke" Color="#CC1677FF" />
                    <SolidColorBrush x:Key="McKuroSwitchChipSelectedText" Color="#0F2B5B" />
                    <!-- 弹窗面板面色:理由见暗色主题同名令牌(亮色主题用 78% 白) -->
                    <SolidColorBrush x:Key="McKuroDialogSurface" Color="#C7FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!--
              以下令牌<b>故意放在 ThemeDictionaries 之外</b>:它们描述的是「压在视频/壁纸上」这个物理场景,
              与用户在设置里选的明暗主题无关。亮色主题下启动页视频照样可能是暗场景,
              若前景跟着主题翻成深色,就会"黑字压黑视频"完全看不见(2026-10 用户反馈)。
              配合 chrome:VideoTextChrome.Shadow 的反向投影阴影,浅色字在亮背景上同样可读。
            -->
            <SolidColorBrush x:Key="McKuroTextOnVideo" Color="#F5F8FF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
