<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.PlayTimeView"
             x:DataType="vm:PlayTimeViewModel">
    <UserControl.Resources>
        <vm:IntensityBrushConverter x:Key="IntensityBrush" />
        <vm:IntToGridRowConverter x:Key="RowConv" />
        <vm:IntToGridColConverter x:Key="ColConv" />
        <vm:PercentToHeightConverter x:Key="PctOfHeight" />
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="20,16,20,16" Spacing="16">
            <!-- 标题 -->
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="Timer" IconVariant="Regular" IconSize="Size24" VerticalAlignment="Center" />
                    <TextBlock Text="游玩统计" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}" />
            </StackPanel>

            <!-- 统计卡 -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
                <Border CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="总游玩时长" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Text="{Binding TotalHoursText}" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource SemiColorPrimary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="今日游玩" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Text="{Binding TodayHoursText}" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource SemiColorPrimary}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                    <StackPanel Spacing="4">
                        <TextBlock Text="记录天数" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Text="{Binding RecordDaysText}" FontSize="26" FontWeight="Bold"
                                   Foreground="{DynamicResource SemiColorPrimary}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 最近 7 天每日时长柱状 -->
            <Border CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="最近 7 天每日游玩时长" FontSize="15" FontWeight="Bold" />
                    <ItemsControl ItemsSource="{Binding Last7Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" ColumnSpacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlayDayItem">
                                <StackPanel Spacing="6" HorizontalAlignment="Center">
                                    <Border Height="120" Width="44" CornerRadius="6"
                                            Background="{DynamicResource SemiColorBg3}"
                                            VerticalAlignment="Bottom">
                                        <Border Height="{Binding BarHeight, Converter={StaticResource PctOfHeight}}"
                                                CornerRadius="6"
                                                Background="{DynamicResource SemiColorPrimary}"
                                                VerticalAlignment="Bottom" />
                                    </Border>
                                    <TextBlock Text="{Binding HoursText}" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               HorizontalAlignment="Center" />
                                    <!-- 当天每次独立时段(合并相邻会话),单行,超长省略 -->
                                    <TextBlock Text="{Binding SessionsText}" FontSize="10"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               HorizontalAlignment="Center" TextWrapping="Wrap"
                                               MaxLines="2" MaxWidth="70" TextTrimming="CharacterEllipsis">
                                        <ToolTip.Tip>
                                            <TextBlock Text="{Binding SessionsText}" FontSize="11" />
                                        </ToolTip.Tip>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 最近 7 天时段热力图(7 行 × 24 小时) -->
            <Border CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="最近 7 天游玩时间区间(7×24 小时热力)" FontSize="15" FontWeight="Bold" />
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                        <!-- 行标签(最近 7 天日期) -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3" Margin="0,0,8,0">
                            <ItemsControl ItemsSource="{Binding Last7Days}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlayDayItem">
                                        <TextBlock Text="{Binding Label}" FontSize="10" Height="16"
                                                   Foreground="{DynamicResource SemiColorText2}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- 热力格(24 列,每行一天;UniformGrid 行优先填充) -->
                        <Border Grid.Row="0" Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding HourlyCells}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="7" Columns="24" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PlayHourCell">
                                        <Border Width="16" Height="16" CornerRadius="2" Margin="1"
                                                Background="{Binding Intensity, Converter={StaticResource IntensityBrush}}">
                                            <ToolTip.Tip>
                                                <TextBlock Text="{Binding Tip}" FontSize="11" />
                                            </ToolTip.Tip>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <!-- 小时刻度(0-23) -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="1,4,0,0">
                            <TextBlock Text="0" FontSize="9" Width="18" Foreground="{DynamicResource SemiColorText3}" />
                            <TextBlock Text="6" FontSize="9" Width="18" Foreground="{DynamicResource SemiColorText3}" />
                            <TextBlock Text="12" FontSize="9" Width="18" Foreground="{DynamicResource SemiColorText3}" />
                            <TextBlock Text="18" FontSize="9" Width="18" Foreground="{DynamicResource SemiColorText3}" />
                            <TextBlock Text="23" FontSize="9" Width="18" Foreground="{DynamicResource SemiColorText3}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 最近 7 天游玩分析报告(关键指标 + 行为洞察 + 自动总结 + 逐日明细) -->
            <Border CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ic:FluentIcon Icon="DocumentText" IconVariant="Regular" IconSize="Size16" VerticalAlignment="Center" />
                            <TextBlock Text="最近 7 天游玩分析报告" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="10" Padding="10,3"
                                Background="{DynamicResource SemiColorBg3}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReportSummaryText}" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText2}" />
                        </Border>
                    </Grid>

                    <!-- 关键指标:日均 / 最长单次 / 连续游玩 / 最活跃日 -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <Border CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="日均时长" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                <TextBlock Text="{Binding WeeklyReport.AvgPerDayText}" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                <TextBlock Text="按有游玩的天平均" FontSize="10" Foreground="{DynamicResource SemiColorText3}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="最长单次" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                <TextBlock Text="{Binding WeeklyReport.LongestSessionText}" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                <TextBlock Text="{Binding WeeklyReport.LongestSessionDayText}" FontSize="10"
                                           Foreground="{DynamicResource SemiColorText3}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="连续游玩" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                <TextBlock Text="{Binding WeeklyReport.StreakText}" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                <TextBlock Text="截至今天" FontSize="10" Foreground="{DynamicResource SemiColorText3}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="最活跃日" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                <TextBlock Text="{Binding WeeklyReport.PeakDayText}" FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                <TextBlock Text="{Binding WeeklyReport.PeakDayDetail}" FontSize="10"
                                           Foreground="{DynamicResource SemiColorText3}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 行为洞察:时段偏好 / 作息规律 / 游玩方式 / 周内趋势 -->
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                        <Border CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="时段偏好" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                <TextBlock Text="{Binding WeeklyReport.HabitTag}" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                <TextBlock Text="{Binding WeeklyReport.HabitDetail}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SemiColorText3}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="作息规律" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                <TextBlock Text="{Binding WeeklyReport.RegularityTag}" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                <TextBlock Text="{Binding WeeklyReport.RegularityDetail}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SemiColorText3}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="游玩方式" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                <TextBlock Text="{Binding WeeklyReport.StyleTag}" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                <TextBlock Text="{Binding WeeklyReport.StyleDetail}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SemiColorText3}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="14,12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="周内趋势" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                <TextBlock Text="{Binding WeeklyReport.TrendTag}" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                <TextBlock Text="{Binding WeeklyReport.TrendDetail}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource SemiColorText3}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 自动生成的本周总结 -->
                    <Border CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="16,12"
                            BorderBrush="{DynamicResource SemiColorPrimary}" BorderThickness="3,0,0,0">
                        <StackPanel Spacing="6">
                            <TextBlock Text="本周总结" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource SemiColorPrimary}" />
                            <TextBlock Text="{Binding WeeklyReport.SummaryText}" FontSize="13" TextWrapping="Wrap"
                                       LineHeight="22" Foreground="{DynamicResource SemiColorText1}" />
                        </StackPanel>
                    </Border>

                    <!-- 逐日明细 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                        <TextBlock Text="逐日明细" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="每次开始玩到结束独立统计,相邻会话(≤60min)合并为同一时段" FontSize="11"
                                   Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding ReportRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PlayTimeReportRow">
                                <Border Padding="12,10" CornerRadius="10" Margin="0,0,0,8"
                                        Background="{DynamicResource SemiColorBg3}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <!-- 日期 + 星期 + 今天/昨天 -->
                                        <StackPanel Grid.Column="0" Spacing="2" Width="76">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" />
                                                <TextBlock Text="{Binding Weekday}" FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding DayTag}" FontSize="10"
                                                       Foreground="{DynamicResource SemiColorPrimary}"
                                                       IsVisible="{Binding HasDayTag}" />
                                        </StackPanel>
                                        <!-- 时段 + 时长条 -->
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SessionsText}" FontSize="12"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       TextWrapping="Wrap" />
                                            <Border Width="160" Height="4" CornerRadius="2"
                                                    Background="{DynamicResource SemiColorBg1}"
                                                    HorizontalAlignment="Left">
                                                <Border Width="{Binding DurationWidth}" Height="4" CornerRadius="2"
                                                        Background="{DynamicResource SemiColorPrimary}"
                                                        HorizontalAlignment="Left" />
                                            </Border>
                                        </StackPanel>
                                        <!-- 当天总时长 -->
                                        <TextBlock Grid.Column="2" Text="{Binding HoursText}" FontSize="16"
                                                   FontWeight="Bold" Foreground="{DynamicResource SemiColorPrimary}"
                                                   VerticalAlignment="Center" MinWidth="48"
                                                   TextAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
