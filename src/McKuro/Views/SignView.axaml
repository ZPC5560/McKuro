<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:kuro="using:McKuro.Core.Models.Kuro"
             xmlns:controls="using:McKuro.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="700"
             x:Class="McKuro.Views.SignView"
             x:DataType="vm:SignViewModel">
    <UserControl.Resources>
        <vm:SignedOpacityConverter x:Key="SignedOpacity" />
        <vm:SerialNumPlusOneConverter x:Key="SerialNumPlusOne" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- 标题行:左标题 + 右侧账号信息与操作(账号信息按需求移至标题栏右边) -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,8">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="CalendarCheckmark" IconVariant="Regular" IconSize="Size24" VerticalAlignment="Center" />
                    <TextBlock Text="签到" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- 账号信息(登录/切号/登出后经 RolesRefreshRequestedMessage 自动刷新) -->
                <TextBlock Text="{Binding AccountText}" FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsLoggedIn}" />
                <Button Content="刷新角色" Command="{Binding RefreshRolesCommand}"
                        FontSize="12" Padding="8,2"
                        IsVisible="{Binding IsLoggedIn}" />
                <Button Content="游戏签到" Classes="primary"
                        Command="{Binding SignAllCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding IsLoggedIn}" />
                <Button Content="库街区每日任务" Command="{Binding ExecuteDailyCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        IsVisible="{Binding IsLoggedIn}" />
                <!-- 未登录:引导去账号页 -->
                <Button Content="前往「账号」页登录" Classes="primary"
                        Command="{Binding GoAccountCommand}"
                        IsVisible="{Binding !IsLoggedIn}" />
            </StackPanel>
        </Grid>

        <!-- 签到设置(自设置页迁移到功能页;常显,执行时自行校验登录)。
             AutoSignEnabled 同时控制启动后与每日 8:00 两个时机(DailyTaskScheduler),故只留一个开关 -->
        <Border Grid.Row="1" Margin="20,0,20,10" Padding="16" CornerRadius="12"
                Background="{DynamicResource SemiColorBg2}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="自动游戏签到(启动后 + 每日 8:00)" IsChecked="{Binding AutoSignEnabled}" />
                <CheckBox Content="自动执行库街区每日任务" IsChecked="{Binding AutoKuroClientTaskEnabled}" />
            </StackPanel>
        </Border>

        <!-- 签到奖励格子 + 今日状态(参照 WutheringWavesTool goodsView) -->
        <Border Grid.Row="2" Margin="20,0,20,10" Padding="16" CornerRadius="12"
                Background="{DynamicResource SemiColorBg2}"
                IsVisible="{Binding IsLoggedIn}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <!-- 左:签到奖励格子 -->
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:FluentIcon Icon="Gift" IconVariant="Regular" IconSize="Size16" VerticalAlignment="Center" />
                            <TextBlock Text="签到奖励" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding TodaySignText}" FontSize="12"
                                   Foreground="{DynamicResource SemiColorPrimary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SignCountText}" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <!-- 奖励格子内部滚动(MaxHeight≈3 行):页面高度留给底部角色签到状态,
                         31 格全量展开会把底部行挤出视口 -->
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SignGoods}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="kuro:SignInGoodsItem">
                                <Border Width="76" Height="90" CornerRadius="8" Margin="0,0,8,8"
                                        Background="{DynamicResource SemiColorBg3}"
                                        Opacity="{Binding IsSigned, Converter={StaticResource SignedOpacity}}">
                                    <Grid RowDefinitions="Auto,*,Auto">
                                        <!-- 序号(serialNum+1 补零) -->
                                        <TextBlock Grid.Row="0" Margin="6,4,0,0" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   Text="{Binding SerialNum, Converter={StaticResource SerialNumPlusOne}}" />
                                        <!-- 物品图 -->
                                        <Border Grid.Row="1" Width="48" Height="48" CornerRadius="6"
                                                ClipToBounds="True" HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                            <controls:AsyncImage ImageUrl="{Binding GoodsUrl}"
                                                                 Width="48" Height="48" Stretch="UniformToFill" />
                                        </Border>
                                        <!-- 数量 -->
                                        <TextBlock Grid.Row="2" HorizontalAlignment="Center" Margin="0,0,0,4"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="{DynamicResource SemiColorText2}">
                                            <Run Text="×" /><Run Text="{Binding GoodsNum}" />
                                        </TextBlock>
                                        <!-- 已签角标 -->
                                        <Border Grid.Row="1" CornerRadius="8" Padding="5,1"
                                                Background="{DynamicResource SemiColorPrimary}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                IsVisible="{Binding IsSigned}">
                                            <ic:FluentIcon Icon="Checkmark" IconVariant="Regular" IconSize="Size12"
                                                           Foreground="White" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
                <!-- 右:签到统计(参照 WutheringWavesTool signHistoryListView) -->
                <Border Grid.Column="1" Width="200" CornerRadius="10"
                        Background="{DynamicResource SemiColorBg3}" Padding="12,10">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,8">
                            <ic:FluentIcon Icon="DataLine" IconVariant="Regular" IconSize="Size16" VerticalAlignment="Center" />
                            <TextBlock Text="签到统计" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListBox Grid.Row="1" ItemsSource="{Binding SignHistory}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="kuro:SignRecordItem">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,2">
                                        <Border Width="22" Height="22" CornerRadius="4" ClipToBounds="True"
                                                Background="{DynamicResource SemiColorBg2}">
                                            <controls:AsyncImage ImageUrl="{Binding GoodsUrl}"
                                                                 Width="22" Height="22" Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center"
                                                   Text="{Binding GoodsName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" FontSize="12" FontWeight="Bold"
                                                   VerticalAlignment="Center">
                                            <Run Text="×" /><Run Text="{Binding GoodsNum}" />
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 角色列表 -->
        <Grid Grid.Row="3" Margin="20,0,20,16" IsVisible="{Binding IsLoggedIn}">
            <ListBox ItemsSource="{Binding Roles}" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:RoleSignItem">
                        <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,8"
                                Background="{DynamicResource SemiColorBg2}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Width="36" Height="36" CornerRadius="8"
                                        Background="{DynamicResource SemiColorBg3}">
                                    <controls:AsyncImage ImageUrl="{Binding HeadUrl}"
                                                         Width="36" Height="36" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding RoleName}" FontSize="15" FontWeight="Bold" />
                                        <Border CornerRadius="6" Background="{DynamicResource SemiColorPrimary}"
                                                Padding="6,1">
                                            <TextBlock Text="{Binding GameName}" FontSize="10"
                                                       Foreground="White" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}">
                                        <Run Text="{Binding ServerName}" />
                                        <Run Text=" · Lv." /><Run Text="{Binding Level}" />
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13"
                                           Foreground="{DynamicResource SemiColorText2}"
                                           Text="{Binding SignStatus}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 未登录空状态 -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    IsVisible="{Binding !IsLoggedIn}">
            <TextBlock Text="登录后即可一键签到鸣潮全部角色(登录入口在「账号」页)" FontSize="16"
                       Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
