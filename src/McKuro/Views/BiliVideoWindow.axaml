<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="920" d:DesignHeight="560"
        x:Class="McKuro.Views.BiliVideoWindow"
        Title="视频播放"
        Width="920" Height="560"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Background="#FF10141A">
  <!-- 应用内B站视频播放窗口:内嵌平台 WebView(macOS=WkWebViewControl,Windows=WebView2Control)
       加载B站官方播放器嵌入页(player.bilibili.com),自动播放,免浏览器跳转加载。 -->
  <Panel>
    <ContentPresenter x:Name="WebViewHost" />
    <Panel x:Name="LoadingOverlay" Background="#FF10141A" ZIndex="10">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="正在加载视频…" FontSize="15" Foreground="#FFC9D1D9" HorizontalAlignment="Center" />
        <TextBlock Text="加载完成后自动播放" FontSize="12" Foreground="#FF667085" HorizontalAlignment="Center" />
      </StackPanel>
    </Panel>
  </Panel>
</Window>
