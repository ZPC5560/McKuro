<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:controls="using:McKuro.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Margin="25" Spacing="12" MaxWidth="760" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                <ic:FluentIcon Icon="Settings" IconVariant="Regular" IconSize="Size24" VerticalAlignment="Center" />
                <TextBlock Text="设置" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
            </StackPanel>

            <!-- 跨平台能力提示：让平台差异在界面上可理解、可预期。 -->
            <Border CornerRadius="12" Background="{DynamicResource McKuroGlassFill}"
                    BorderBrush="{DynamicResource McKuroGlassStroke}" BorderThickness="1" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource McKuroAccent}">
                        <TextBlock Text="⌘" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="White" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="当前平台：" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PlatformNameText}" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding PlatformCapabilityText}" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 游戏目录 -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="Folder" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="游戏安装目录" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="用于更新/安装/抽卡日志解析,目录应包含 Wuthering Waves.exe" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" MinWidth="320">
                        <TextBox Grid.Column="0" Text="{Binding GameRootDir}"
                                 PlaceholderText="例如: D:\Kuro\Wuthering Waves"
                                 VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseGameDirCommand}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 服务器渠道 -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="Server" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="服务器渠道" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="自动检测失败时可手动指定(官服 / B站 / WeGame / 国际服)" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Width="200" VerticalAlignment="Center"
                              ItemsSource="{Binding ServerTypes}"
                              SelectedIndex="{Binding SelectedServerIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 游戏修复:跳过校验文件(对齐 Haiyu SkipVerifyFiles) -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                            <ic:FluentIcon Icon="Wrench" IconVariant="Regular" IconSize="Size20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock Text="游戏修复 · 跳过校验文件" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="修复游戏时跳过这些文件(如日志/配置,避免被还原);相对游戏目录的路径,正斜杠分隔" FontSize="12"
                                       Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                      OffContent="保留跳过文件" OnContent="删除跳过文件"
                                      IsChecked="{Binding AutoSkipVerifyDelete, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding SkipVerifyInput}"
                                 PlaceholderText="例如: Client/Saved/Logs/Client.log" />
                        <Button Grid.Column="1" Content="添加" Command="{Binding AddSkipVerifyFileCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding SkipVerifyFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                                    <Border Grid.Column="0" Padding="10,5" CornerRadius="6"
                                            Background="{DynamicResource SemiColorBg3}">
                                        <TextBlock Text="{Binding}" FontSize="12" FontFamily="Consolas,monospace"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <Button Grid.Column="1" Padding="8,4" FontSize="11"
                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveSkipVerifyFileCommand}"
                                            CommandParameter="{Binding}">
                                        <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="未配置跳过文件" FontSize="12" Foreground="{DynamicResource SemiColorText3}"
                               IsVisible="{Binding !SkipVerifyFiles.Count}" />
                </StackPanel>
            </Border>

            <!-- 下载并发 -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="Flash" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="并发下载数" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="同时下载的文件数(1~32)" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" Width="200" VerticalAlignment="Center"
                                   Value="{Binding DownloadConcurrency, Mode=TwoWay}"
                                   Minimum="1" Maximum="32" />
                </Grid>
            </Border>

            <!-- 下载限速(对齐 Haiyu LimitSpeed) -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="TopSpeed" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="下载速度限制 (MB/s)" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="0 = 不限速(对齐 Haiyu 的下载限速设置)" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <NumericUpDown Grid.Column="2" Width="200" VerticalAlignment="Center"
                                   Value="{Binding LimitSpeedMbps, Mode=TwoWay}"
                                   Minimum="0" Maximum="1024" />
                </Grid>
            </Border>

            <!-- 游戏启动参数(对齐 Haiyu StartGameOption) -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="10">
                    <Border Grid.Row="0" Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="Rocket" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="游戏启动参数" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="对齐 Haiyu:命令行追加 -dx11 -slno 及自定义参数" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Text="DX11 启动" FontSize="13" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" HorizontalAlignment="Left"
                                      IsChecked="{Binding UseDx11, Mode=TwoWay}" />
                    </Grid>
                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Text="禁用 DLSS" FontSize="13" VerticalAlignment="Center" />
                        <ToggleSwitch Grid.Column="1" HorizontalAlignment="Left"
                                      IsChecked="{Binding DisableDlss, Mode=TwoWay}" />
                    </Grid>
                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Text="自定义参数" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding StartGameArguments, Mode=TwoWay}"
                                 PlaceholderText="如 -notexturestreaming" />
                    </Grid>
                    <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Text="启动文件" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding StartGameExeName, Mode=TwoWay}"
                                 PlaceholderText="留空自动:Wuthering Waves.exe → Client-Win64-Shipping.exe" />
                    </Grid>
                </Grid>
            </Border>

            <!-- 启动后最小化 -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="ArrowMinimize" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="启动游戏后最小化主窗口" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="启动游戏后自动最小化到任务栏(对齐 Haiyu 启动后可关闭主界面)" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                  IsChecked="{Binding MinimizeOnLaunch, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 个性化：壁纸、动态色板和玻璃性能档位 -->
            <Border CornerRadius="14"
                    Background="{DynamicResource McKuroGlassFillStrong}"
                    BorderBrush="{DynamicResource McKuroGlassStroke}"
                    BorderThickness="1"
                    Padding="20">
                <Grid ColumnDefinitions="180,*,Auto" ColumnSpacing="18">
                    <Border Width="180" Height="102" CornerRadius="12" ClipToBounds="True"
                            Background="{DynamicResource McKuroBackdropBase}"
                            BorderBrush="{DynamicResource McKuroGlassStroke}" BorderThickness="1">
                        <Grid>
                            <controls:AsyncImage ImageUrl="{Binding WallpaperPath}"
                                                 Stretch="UniformToFill"
                                                 HorizontalAlignment="Stretch"
                                                 VerticalAlignment="Stretch" />
                            <Border Background="{DynamicResource McKuroBackdropTint}" />
                            <TextBlock Text="默认背景" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource McKuroTextOnWallpaper}"
                                       IsVisible="{Binding !HasWallpaper}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
                        <TextBlock Text="主页个性化" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="更换壁纸后，应用强调色、导航选中态和玻璃表面会自动同步。普通数据页会使用轻量全局模糊。"
                                   FontSize="12" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding WallpaperStatusText}" FontSize="12"
                                   Foreground="{DynamicResource McKuroAccent}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="选择壁纸" Classes="primary" Command="{Binding SelectWallpaperCommand}" />
                            <Button Content="恢复默认" Command="{Binding ResetWallpaperCommand}" />
                            <Button Content="打开目录" Command="{Binding OpenWallpaperDirCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="12" MinWidth="150" VerticalAlignment="Center">
                        <StackPanel Spacing="3">
                            <TextBlock Text="动态配色" FontSize="12" />
                            <ToggleSwitch IsChecked="{Binding DynamicPaletteEnabled, Mode=TwoWay}"
                                          OnContent="开启" OffContent="关闭" />
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="玻璃效果" FontSize="12" />
                            <ComboBox ItemsSource="{Binding GlassQualities}"
                                      SelectedIndex="{Binding GlassQualityIndex, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 背景视频封面 -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="Video" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="背景视频封面" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="游戏页播放官方宣传视频;未安装 VLC 时自动回退为静态封面图" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                  IsChecked="{Binding BackgroundVideoEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 主题(对齐 Haiyu 设置主题) -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="PaintBrush" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="主题" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="跟随系统 / 浅色 / 深色(选择后即时生效)" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Width="200" VerticalAlignment="Center"
                              ItemsSource="{Binding Themes}"
                              SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 自动游戏签到(打开软件后自动签到) -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="CalendarCheckmark" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="打开软件自动签到" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="启动软件后自动执行游戏签到(每天 8:00 也会自动签到;与签到页开关同步)" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                  IsChecked="{Binding AutoSignEnabled, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 应用自更新(对齐 Haiyu UpdateAppViewModel) -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                        <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                            <ic:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock FontSize="15" FontWeight="SemiBold">
                                <Run Text="应用自更新" /><Run Text="  " /><Run Text="{Binding CurrentAppVersionText}" FontSize="12" Foreground="{DynamicResource SemiColorText3}" />
                            </TextBlock>
                            <TextBlock Text="GitHub 仓库 (owner/repo),留空禁用;Release 需含 exe 安装包" FontSize="12"
                                       Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <TextBlock Text="仓库" FontSize="13" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding AppUpdateRepo, Mode=TwoWay}"
                                 PlaceholderText="如 leck995/WutheringWavesTool" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="检查更新" Command="{Binding CheckAppUpdateCommand}"
                                IsEnabled="{Binding !AppUpdateChecking}" />
                        <Button Content="下载并安装" Classes="primary" Command="{Binding DownloadAppUpdateCommand}"
                                IsVisible="{Binding AppUpdateAvailable}"
                                IsEnabled="{Binding !AppUpdateDownloading}" />
                        <Button Content="跳过此版本" Command="{Binding SkipAppUpdateCommand}"
                                IsVisible="{Binding AppUpdateAvailable}" />
                        <ProgressBar Width="160" Height="6" VerticalAlignment="Center"
                                     Value="{Binding AppUpdateProgress}" Minimum="0" Maximum="100"
                                     IsVisible="{Binding AppUpdateDownloading}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AppUpdateVersionText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource SemiColorPrimary}" />
                    <TextBlock Text="{Binding AppUpdateStatusText}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
            </Border>

            <!-- 界面语言 -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                        <ic:FluentIcon Icon="Globe" IconVariant="Regular" IconSize="Size20"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="界面语言" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="重启后生效" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2" Width="200" VerticalAlignment="Center"
                              ItemsSource="{Binding Languages}"
                              SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" />
                </Grid>
            </Border>

            <!-- 操作(所有设置改动即时自动保存,无需手动保存) -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                <Button Content="打开日志目录"
                        Command="{Binding OpenLogDirCommand}"
                        ToolTip.Tip="{Binding LogDirText}" />
                <TextBlock Text="{Binding StatusText}" FontSize="13"
                           Foreground="{DynamicResource SemiColorPrimary}"
                           VerticalAlignment="Center" />
                <TextBlock Text="设置改动后自动保存" FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
