<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- 欢迎横幅 -->
        <Border Grid.Row="0"
                CornerRadius="10"
                Background="{DynamicResource SemiColorPrimary}"
                Padding="30,32"
                Margin="0,0,0,20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="8">
                    <TextBlock Text="🌊 McKuro · 鸣潮启动器"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="安装状态" FontSize="12" Foreground="#AAFFFFFF" />
                            <TextBlock Text="{Binding InstallStateText}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Text="服务器渠道" FontSize="12" Foreground="#AAFFFFFF" />
                            <TextBlock Text="{Binding ServerTypeText}" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AccountText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                    <Button Content="刷新数据"
                            Background="#33FFFFFF"
                            BorderThickness="0"
                            Foreground="White"
                            Command="{Binding RefreshDailyCommand}"
                            IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 每日数据(体力/活跃度/周本/电台/周度游历) -->
        <Grid Grid.Row="1" RowDefinitions="Auto,*" ColumnDefinitions="*,*,*" ColumnSpacing="16" RowSpacing="16">
            <Border Grid.Column="0" CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                <StackPanel Spacing="4">
                    <TextBlock Text="状态" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{DynamicResource SemiColorText2}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Grid.ColumnSpan="2" CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="16" />
                    <TextBlock Text="每日数据来自库街区(需登录账号)" FontSize="13"
                               Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
            </Border>

            <!-- 5 项每日数据卡片 -->
            <Border Grid.Row="1" Grid.ColumnSpan="3" CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="今日数据" FontSize="16" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding DailyItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5" ColumnSpacing="16" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DailyItem">
                                <Border CornerRadius="12" Background="{DynamicResource SemiColorBg3}" Padding="14">
                                    <StackPanel Spacing="10">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Icon}" FontSize="18" />
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding ValueText}" FontSize="20" FontWeight="Bold"
                                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="12"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Value="{Binding Percent}"
                                                         Height="8" CornerRadius="4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
