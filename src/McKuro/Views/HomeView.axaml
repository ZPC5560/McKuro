<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:controls="using:McKuro.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="720"
             x:Class="McKuro.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <UserControl.Styles>
        <!-- 半透明描边按钮(参考 InternalBeyond .splash-action-btn) -->
        <Style Selector="Button.splashBtn">
            <Setter Property="Background" Value="{DynamicResource McKuroGlassFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource McKuroGlassStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="{DynamicResource McKuroTextOnWallpaper}" />
            <Setter Property="Padding" Value="22,9" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.splashBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource McKuroGlassFillStrong}" />
            <Setter Property="BorderBrush" Value="{DynamicResource McKuroAccentHover}" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!-- ═══ 背景:由 MainWindow 提供壁纸，这里只叠加轻量氛围遮罩与动态强调色 ═══ -->
        <Panel IsHitTestVisible="False">
            <Border Background="{DynamicResource McKuroHomeScrim}" />
            <!-- 右上冷色光晕 -->
            <Ellipse Width="920" Height="920" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-420,-320,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#2AFFFFFF" Offset="0" />
                        <GradientStop Color="#14FFFFFF" Offset="0.55" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <!-- 左下淡蓝光晕 -->
            <Ellipse Width="760" Height="760" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-280,0,0,-340">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#22FFFFFF" Offset="0" />
                        <GradientStop Color="#10FFFFFF" Offset="0.6" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Panel>

        <!-- ═══ 左上角:账号 + 刷新数据(半透明胶囊) ═══ -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,22,0,0"
                CornerRadius="18" Background="{DynamicResource McKuroGlassFill}"
                BorderBrush="{DynamicResource McKuroGlassStroke}" BorderThickness="1" Padding="18,7">
            <StackPanel Orientation="Horizontal" Spacing="14">
                <TextBlock Text="{Binding AccountText}" FontSize="13.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource McKuroTextOnWallpaper}" VerticalAlignment="Center" />
                <Button Command="{Binding RefreshDailyCommand}"
                        IsEnabled="{Binding !IsBusy}" Classes="splashBtn"
                        Padding="14,6" CornerRadius="14">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size16" VerticalAlignment="Center" />
                        <TextBlock Text="刷新数据" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ═══ 主内容 ═══ -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="96,0,40,0" Opacity="{Binding RevealOpacity}">
                <Grid.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.9" />
                    </Transitions>
                </Grid.Transitions>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="56">
                    <!-- ─── 左:欢迎标题区(splash-left) ─── -->
                    <StackPanel Grid.Column="0" MaxWidth="460" VerticalAlignment="Center" Spacing="0">
                        <!-- 签名行 -->
                        <TextBlock Text="MCKURO · 鸣潮启动器" FontSize="12" FontWeight="Light"
                                   LetterSpacing="3" Foreground="{DynamicResource McKuroTextMuted}" />
                        <!-- 发光发丝分隔线 -->
                        <Border Width="36" Height="1" Margin="0,22,0,26" HorizontalAlignment="Left"
                                Background="{DynamicResource McKuroAccent}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Color="#A8CCF8" Opacity="0.8" />
                            </Border.Effect>
                        </Border>
                        <!-- 大标题(衬线斜体感 + 首字母高亮) -->
                        <TextBlock FontFamily="Georgia, 'Times New Roman', serif" FontStyle="Italic"
                                   FontSize="46" FontWeight="Light" LetterSpacing="2" Foreground="{DynamicResource McKuroTextOnWallpaper}"
                                   TextWrapping="Wrap">
                            <Run Text="W" FontWeight="Bold" Foreground="{DynamicResource McKuroAccent}" /><Run Text="elcome to" />
                            <Run Text=" " />
                            <Run Text="M" FontWeight="Bold" Foreground="{DynamicResource McKuroAccent}" /><Run Text="cKuro" />
                        </TextBlock>
                        <!-- 描述文字(宋体感、行高 2、部分白色高亮) -->
                        <TextBlock Margin="0,30,0,0" FontSize="15.5" LineHeight="2" Foreground="{DynamicResource McKuroTextMuted}"
                                   TextWrapping="Wrap">
                            <Run Text="潮起潮落，回声常在。" />
                            <Run Text="管理你的冒险、角色与数据。" Foreground="{DynamicResource McKuroTextOnWallpaper}" FontWeight="SemiBold" />
                        </TextBlock>
                        <!-- 次要描述(细体、浅色) -->
                        <TextBlock Margin="0,8,0,0" FontSize="13" FontWeight="Light" Foreground="{DynamicResource McKuroTextMuted}"
                                   TextWrapping="Wrap" Text="游戏启动 · 抽卡分析 · 角色数据 · 每日数据一览" />
                        <!-- 安装状态 / 服务器渠道 -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                            <TextBlock Text="{Binding InstallStateText}" FontSize="12" Foreground="{DynamicResource McKuroTextMuted}" />
                            <TextBlock Text="·" FontSize="12" Foreground="{DynamicResource McKuroTextMuted}" />
                            <TextBlock Text="{Binding ServerTypeText}" FontSize="12" Foreground="{DynamicResource McKuroTextMuted}" />
                        </StackPanel>
                        <!-- 半透明描边按钮 -->
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,34,0,0">
                            <Button Content="进入游戏" Classes="splashBtn" Command="{Binding GoLauncherCommand}" />
                            <Button Content="抽卡分析" Classes="splashBtn" Command="{Binding GoGachaCommand}" />
                            <Button Content="角色数据" Classes="splashBtn" Command="{Binding GoRolesCommand}" />
                        </StackPanel>
                        <!-- 跳过/提示小字 -->
                        <TextBlock Margin="0,18,0,0" FontSize="12" FontWeight="Light" Foreground="{DynamicResource McKuroTextMuted}"
                                   Text="{Binding StatusText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- ─── 右:每日数据(半透明卡片) ─── -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock Text="今日数据" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding DailyItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DailyItem">
                                        <Border Width="160" Height="102" Margin="0,0,12,12" CornerRadius="12"
                                                Background="{DynamicResource McKuroGlassFill}" BorderBrush="{DynamicResource McKuroGlassStroke}" BorderThickness="1"
                                                Padding="12,10" ClipToBounds="True">
                                            <StackPanel Spacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <!-- 官方图标(有 URL 时优先显示),否则 Fluent 图标兜底 -->
                                                    <controls:AsyncImage ImageUrl="{Binding ImageUrl}"
                                                                         Width="22" Height="22"
                                                                         Stretch="Uniform"
                                                                         IsVisible="{Binding ImageUrl, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                                    <ic:FluentIcon Icon="{Binding Icon}" IconVariant="Regular" IconSize="Size20"
                                                                   IsVisible="{Binding ImageUrl, Converter={x:Static conv:StringConverters.IsNullOrEmpty}}" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource McKuroTextOnWallpaper}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding ValueText}" FontSize="18" FontWeight="Bold"
                                                               Foreground="{DynamicResource McKuroAccent}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding PercentText}" FontSize="11"
                                                               Foreground="{DynamicResource McKuroTextMuted}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                               IsVisible="{Binding HasTotal}" />
                                                </Grid>
                                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}"
                                                             Height="5" CornerRadius="2.5"
                                                             IsVisible="{Binding HasTotal}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
