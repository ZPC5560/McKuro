<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:loc="clr-namespace:McKuro.Services"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.AccountView"
             x:DataType="vm:AccountViewModel">
    <UserControl.Resources>
        <!-- 接口登录状态点颜色:绿=登录正常,橙=异常登录,灰=未登录 -->
        <vm:LoginDotBrushConverter x:Key="LoginDotBrush" />
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="25" Spacing="12" MaxWidth="820" HorizontalAlignment="Left">
            <!-- 标题(右侧:同一账号判定徽标,自动判定仅提醒不强制登出) -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ic:FluentIcon Icon="Person" IconVariant="Regular" IconSize="Size24" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Localize Key=Nav.Account}" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Localize Key=Account.Subtitle}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 判定徽标(自动;悬停查看完整判定结果) -->
                <Grid Grid.Column="1" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding SameAccountStatus}">
                    <!-- 同一账号(强调色) -->
                    <Border CornerRadius="8" Padding="10,4" Background="#D9481F" IsVisible="{Binding SameAccountIsSame}">
                        <TextBlock Text="{Binding SameAccountStatus}" FontSize="12" Foreground="White"
                                   MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <!-- 不同账号(警示色) -->
                    <Border CornerRadius="8" Padding="10,4" Background="#B98900" IsVisible="{Binding SameAccountIsDifferent}">
                        <TextBlock Text="{Binding SameAccountStatus}" FontSize="12" Foreground="White"
                                   MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    </Border>
                    <!-- 信息不足(中性) -->
                    <Border CornerRadius="8" Padding="10,4" Background="{DynamicResource SemiColorBg3}"
                            IsVisible="{Binding SameAccountIsUnknown}">
                        <TextBlock Text="{Binding SameAccountStatus}" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   MaxWidth="320" TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
            </Grid>

            <!-- 登录账号堆叠卡片:三个接口账号以标签堆叠展示,登录完自动切下一个,也可手动点击切换 -->
            <!-- 各标签后的状态点:绿=登录正常,橙=异常登录(会话失效),灰=未登录 -->
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="0">
                <TabControl SelectedIndex="{Binding SelectedLoginCard}" Padding="20" Background="Transparent">
                    <!-- 卡片 1:库街区账号(多账号切换 + 登录) -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{loc:Localize Key=Account.Kuro}" VerticalAlignment="Center" />
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding KuroLoginState, Converter={StaticResource LoginDotBrush}}">
                                    <ToolTip.Tip>
                                        <TextBlock Text="{loc:Localize Key=Account.KuroDotLegend}" FontSize="11" />
                                    </ToolTip.Tip>
                                </Ellipse>
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                                    <ic:FluentIcon Icon="Person" IconVariant="Regular" IconSize="Size20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{loc:Localize Key=Account.Kuro}" FontSize="15" FontWeight="Bold" />
                                    <TextBlock Text="{loc:Localize Key=Account.KuroDesc}" FontSize="12"
                                               Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Content="{loc:Localize Key=Account.KuroLoginBtn}" Classes="primary" Command="{Binding ToggleKuroLoginCommand}" />
                                    <Button Content="{loc:Localize Key=Account.Logout}" Command="{Binding LogoutCommand}" IsVisible="{Binding HasKuroLogin}" />
                                </StackPanel>
                            </Grid>

                            <!-- 多账号切换(无已保存账号时隐藏,避免出现空下拉) -->
                            <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasKuroAccounts}">
                                <TextBlock Text="{loc:Localize Key=Account.Current}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                <ComboBox Width="320"
                                          ItemsSource="{Binding AccountOptions}"
                                          SelectedIndex="{Binding SelectedAccountIndex, Mode=TwoWay}"
                                          ToolTip.Tip="{loc:Localize Key=Account.SwitchTip}" />
                            </StackPanel>

                            <!-- 登录表单(标签 + 两列字段,避免拥挤单行;参考 Vercel 登录设计) -->
                            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="20,18"
                                    IsVisible="{Binding IsKuroLoginOpen}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{loc:Localize Key=Account.KuroLoginPanel}" FontSize="12.5"
                                               Foreground="{DynamicResource SemiColorText3}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{loc:Localize Key=Account.Mobile}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBox PlaceholderText="{loc:Localize Key=Account.MobilePh}" Text="{Binding MobileInput}" />
                                                <Button Grid.Column="1" Content="{Binding SmsButtonText}" Command="{Binding SendSmsCommand}"
                                                        IsEnabled="{Binding CanSendSms}" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Text="{loc:Localize Key=Account.SmsCode}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBox PlaceholderText="{loc:Localize Key=Account.SmsPh}" Text="{Binding VerifyCodeInput}" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="{loc:Localize Key=Account.SmsLogin}" Classes="primary" Command="{Binding LoginWithSmsCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{Binding SmsStatusText}" FontSize="12"
                                               Foreground="{DynamicResource SemiColorText3}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- 卡片 2:云鸣潮账号 -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{loc:Localize Key=Account.Cloud}" VerticalAlignment="Center" />
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding CloudLoginState, Converter={StaticResource LoginDotBrush}}">
                                    <ToolTip.Tip>
                                        <TextBlock Text="{loc:Localize Key=Account.CloudDotLegend}" FontSize="11" />
                                    </ToolTip.Tip>
                                </Ellipse>
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                                    <ic:FluentIcon Icon="Cloud" IconVariant="Regular" IconSize="Size20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{loc:Localize Key=Account.Cloud}" FontSize="15" FontWeight="Bold" />
                                    <TextBlock Text="{loc:Localize Key=Account.CloudDesc}" FontSize="12"
                                               Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CloudAccountText}" FontSize="12" Margin="0,0,4,0"
                                               Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center" />
                                    <Button Content="{loc:Localize Key=Account.LoginBtn}" Classes="primary" Command="{Binding ToggleCloudLoginCommand}"
                                            IsVisible="{Binding !IsCloudLoggedIn}" />
                                    <Button Content="{loc:Localize Key=Account.Logout}" Command="{Binding CloudLogoutCommand}"
                                            IsVisible="{Binding IsCloudLoggedIn}" />
                                </StackPanel>
                            </Grid>

                            <!-- 登录表单(标签 + 两列字段;可折叠,未登录时自动展开) -->
                            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="20,18"
                                    IsVisible="{Binding IsCloudLoginOpen}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{loc:Localize Key=Account.CloudLoginPanel}" FontSize="12.5"
                                               Foreground="{DynamicResource SemiColorText3}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{loc:Localize Key=Account.Mobile}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBox PlaceholderText="{loc:Localize Key=Account.MobilePh}" Text="{Binding CloudMobile}" />
                                                <Button Grid.Column="1" Content="{Binding CloudSmsButtonText}" Command="{Binding SendCloudSmsCommand}"
                                                        IsEnabled="{Binding CanSendCloudSms}" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Text="{loc:Localize Key=Account.SmsCode}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBox PlaceholderText="{loc:Localize Key=Account.SmsPh}" Text="{Binding CloudCode}" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="{loc:Localize Key=Account.SmsLogin}" Classes="primary" Command="{Binding CloudLoginCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{Binding CloudStatusText}" FontSize="12"
                                               Foreground="{DynamicResource SemiColorText3}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>

                    <!-- 卡片 3:官方养成评级(mcguide) -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{loc:Localize Key=Account.Guide}" VerticalAlignment="Center" />
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding GuideLoginState, Converter={StaticResource LoginDotBrush}}">
                                    <ToolTip.Tip>
                                        <TextBlock Text="{loc:Localize Key=Account.GuideDotLegend}" FontSize="11" />
                                    </ToolTip.Tip>
                                </Ellipse>
                            </StackPanel>
                        </TabItem.Header>
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border Width="44" Height="44" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                                    <ic:FluentIcon Icon="ChatBubblesQuestion" IconVariant="Regular" IconSize="Size20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="{loc:Localize Key=Account.Guide}" FontSize="15" FontWeight="Bold" />
                                    <TextBlock Text="{loc:Localize Key=Account.GuideDesc}" FontSize="12"
                                               Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding GuideStatusText}" FontSize="12" Margin="0,0,4,0" MaxWidth="260"
                                               Foreground="{DynamicResource SemiColorPrimary}" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                                    <Button Content="{loc:Localize Key=Account.LoginBtn}" Classes="primary" Command="{Binding ToggleGuideLoginCommand}"
                                            IsVisible="{Binding !GuideLoggedIn}" />
                                    <Button Content="{loc:Localize Key=Account.Logout}" Command="{Binding GuideLogoutCommand}"
                                            IsVisible="{Binding GuideLoggedIn}" />
                                </StackPanel>
                            </Grid>

                            <!-- 登录表单(标签 + 两列字段;可折叠,未登录时自动展开) -->
                            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg3}" Padding="20,18"
                                    IsVisible="{Binding IsGuideLoginOpen}">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{loc:Localize Key=Account.GuideLoginPanel}" FontSize="12.5"
                                               Foreground="{DynamicResource SemiColorText3}" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <StackPanel Spacing="7">
                                            <TextBlock Text="{loc:Localize Key=Account.Mobile}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBox PlaceholderText="{loc:Localize Key=Account.MobilePh}" Text="{Binding GuideMobile}" />
                                                <Button Grid.Column="1" Content="{Binding GuideSmsButtonText}"
                                                        Command="{Binding SendGuideSmsCommand}"
                                                        IsEnabled="{Binding CanSendGuideSms}" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="7">
                                            <TextBlock Text="{loc:Localize Key=Account.SmsCode}" FontSize="13" Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBox PlaceholderText="{loc:Localize Key=Account.SmsPh}" Text="{Binding GuideCode}" />
                                        </StackPanel>
                                    </Grid>
                                    <Button Content="{loc:Localize Key=Account.SmsLogin}" Classes="primary" Command="{Binding GuideLoginCommand}"
                                            HorizontalAlignment="Stretch" />
                                    <TextBlock Text="{Binding GuideSmsText}" FontSize="12"
                                               Foreground="{DynamicResource SemiColorText3}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 操作状态(切换/登录/退出的结果提示) -->
            <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="4,0,0,0"
                       Foreground="{DynamicResource SemiColorText3}"
                       TextWrapping="Wrap" IsVisible="{Binding StatusText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
