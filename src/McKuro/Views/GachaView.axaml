<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:gacha="using:McKuro.Core.Models.Gacha"
             xmlns:controls="using:McKuro.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.GachaView"
             x:DataType="vm:GachaViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 云鸣潮登录(抽卡记录接口通道,优先于本地日志) -->
        <Border Grid.Row="0" Margin="20,8,20,4" Padding="10,8" CornerRadius="10"
                Background="{DynamicResource SemiColorBg2}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ic:FluentIcon Icon="Cloud" IconVariant="Regular" IconSize="Size16" VerticalAlignment="Center" />
                    <TextBlock Text="云鸣潮" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 未登录:手机号 + 验证码 + 登录 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding !IsCloudLoggedIn}">
                    <TextBox Width="120" PlaceholderText="手机号" Text="{Binding CloudMobile}" />
                    <Button Content="{Binding CloudSmsButtonText}" Command="{Binding SendCloudSmsCommand}"
                            IsEnabled="{Binding CanSendCloudSms}" />
                    <TextBox Width="100" PlaceholderText="验证码" Text="{Binding CloudCode}" />
                    <Button Content="登录" Command="{Binding CloudLoginCommand}" Classes="primary" />
                    <TextBlock Text="{Binding CloudStatusText}" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText3}" />
                </StackPanel>
                <!-- 已登录:账号名 + 退出 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsCloudLoggedIn}">
                    <TextBlock Text="{Binding CloudAccountText}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource SemiColorPrimary}" />
                    <TextBlock Text="已登录,同步优先走云鸣潮接口" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText3}" />
                    <Button Content="退出" Command="{Binding CloudLogoutCommand}" FontSize="11" Padding="8,2" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="优先接口,失败自动回退本地日志" FontSize="11"
                           Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <!-- 标题 + 玩家选择 + 同步按钮 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="20,16,20,12" ColumnSpacing="10">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="Gauge" IconVariant="Regular" IconSize="Size24" VerticalAlignment="Center" />
                    <TextBlock Text="抽卡分析" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding PlayerIdText, StringFormat=玩家: {0}}" FontSize="12"
                               Foreground="{DynamicResource SemiColorPrimary}" />
                </StackPanel>
            </StackPanel>
            <!-- 玩家切换:支持多账号查看与"全部账号"聚合 -->
            <ComboBox Grid.Column="1"
                      Width="160"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding PlayerIds}"
                      SelectedItem="{Binding SelectedPlayerId, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="同步" Classes="primary"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <!-- 视图切换(0=综合分析[默认] 1=统计卡片 2=详细分析 3=表格) -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedViewIndex}" Padding="0" Background="Transparent">
            <TabItem Header="综合分析">
                <Grid ColumnDefinitions="380,*">
            <!-- 左侧:卡池 + 五星列表 -->
            <Border Grid.Column="0"
                    Margin="0,0,5,10"
                    Padding="12"
                    Background="{DynamicResource SemiColorBg2}"
                    CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto,*">
                    <ComboBox ItemsSource="{Binding Pools}"
                              SelectedItem="{Binding SelectedPool, Mode=TwoWay}"
                              Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="gacha:PoolStats">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="1"
                               Margin="4,0,4,8"
                               FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}">
                        <Run Text="平均出货: " /><Run Text="{Binding StarAvgValue, StringFormat={}{0:0.#}}" /><Run Text=" 抽" />
                        <Run Text="  ·  " /><Run Text="{Binding SelectedPool.CurrentUpPityText}" />
                    </TextBlock>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <!-- 已垫行:出五星(不论歪/UP)后刷新为角色行;列结构与角色行一致保持等长 -->
                            <Border Margin="0,4"
                                    Padding="10"
                                    CornerRadius="8"
                                    Background="{DynamicResource SemiColorBg3}"
                                    IsVisible="{Binding ShowCurrentPityRow}">
                                <Grid ColumnDefinitions="Auto,*,44" RowDefinitions="Auto,Auto">
                                    <!-- 空图标占位(无图片),与角色行图标同列同宽 -->
                                    <Border Grid.RowSpan="2"
                                            Width="36" Height="36"
                                            CornerRadius="6"
                                            Background="{DynamicResource SemiColorBg2}" />
                                    <StackPanel Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="已垫" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedPool.CurrentPity}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding SelectedPool.CurrentPity, Converter={x:Static vm:PityColorConverter.Instance}}" />
                                    </StackPanel>
                                    <!-- 进度条:列结构与角色行(*,56)一致,保持等长 -->
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,56" Margin="8,2,0,0">
                                        <ProgressBar Minimum="0" Maximum="80"
                                                     Height="8"
                                                     CornerRadius="4"
                                                     Value="{Binding CurrentPityBarValue}"
                                                     Foreground="{Binding SelectedPool.CurrentPity, Converter={x:Static vm:PityColorConverter.Instance}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding FiveStarEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gacha:FiveStarEntry">
                                    <Border Margin="0,4"
                                            Padding="10"
                                            Background="{DynamicResource SemiColorBg3}"
                                            CornerRadius="8">
                                        <Grid ColumnDefinitions="Auto,*,44" RowDefinitions="Auto,Auto">
                                            <Border Grid.RowSpan="2"
                                                    Width="36" Height="36"
                                                    CornerRadius="6"
                                                    Background="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagBgConverter.Instance}}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <controls:AsyncImage ImageUrl="{Binding IconUrl}"
                                                                         Width="36" Height="36"
                                                                         Stretch="UniformToFill" />

                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Record.Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2"
                                                    Grid.RowSpan="2"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Background="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagConverter.Instance}}"
                                                    IsVisible="{Binding IsOffBanner, Converter={x:Static vm:UpFlagVisibleConverter.Instance}}">
                                                <TextBlock FontSize="11" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           Text="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagTextConverter.Instance}}" />
                                            </Border>
                                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,56" Margin="8,2,0,0">
                                                <ProgressBar Minimum="0" Maximum="80"
                                                             Height="8"
                                                             CornerRadius="4"
                                                             Value="{Binding PityBarValue}"
                                                             Foreground="{Binding Pity, Converter={x:Static vm:PityColorConverter.Instance}}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="6,0,0,0"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Pity, Converter={x:Static vm:PityColorConverter.Instance}}"
                                                           ToolTip.Tip="{Binding FiveStarGapText}"
                                                           Text="{Binding Pity}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧:统计条 + 图表 -->
            <Grid Grid.Column="1" Margin="5,0,0,10">
                <ScrollViewer>
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- 统计条 (8 列) -->
                        <Border Grid.ColumnSpan="3" CornerRadius="10" Padding="10,14"
                                Background="{DynamicResource SemiColorBg2}">
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="总抽数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalPulls}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="称号" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Designation}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource SemiColorPrimary}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="双金次数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DoubleCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="歪的次数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CrookedTotal}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="综合评分" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Score}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="平均出货" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                        <Run Text="{Binding AvgPulls}" /><Run Text=" 抽" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="出货率" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                        <Run Text="{Binding ActualFiveStarRate}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="7" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="记录天数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                        <Run Text="{Binding Days}" /><Run Text=" 天" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 统计图(三图合一:下拉切换 保底状态/出货占比/各卡池占比,环形) -->
                        <Border Grid.Row="1" Grid.ColumnSpan="3" CornerRadius="10" Padding="12"
                                Background="{DynamicResource SemiColorBg2}">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{Binding ChartTitle}" FontSize="13"
                                               FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                              ItemsSource="{Binding ChartOptions}"
                                              SelectedIndex="{Binding SelectedChartIndex, Mode=TwoWay}" />
                                </Grid>

                                <!-- 面板0:保底状态 -->
                                <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0"
                                            IsVisible="{Binding SelectedChartIndex, Converter={x:Static vm:IndexEqualsConverter.Instance}, ConverterParameter=0}">
                                    <TextBlock Text="{Binding GuaranteeHeader}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}" />
                                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding GuaranteeSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                    <Path Data="{Binding Data}" Fill="{Binding Brush}" Stretch="None" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding TotalFiveStars}" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="五星" FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding GuaranteeSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,10,2">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 面板1:出货占比 -->
                                <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0"
                                            IsVisible="{Binding SelectedChartIndex, Converter={x:Static vm:IndexEqualsConverter.Instance}, ConverterParameter=1}">
                                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding StarRatioSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                    <Path Data="{Binding Data}" Fill="{Binding Brush}" Stretch="None" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding TotalPulls}" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="总抽数" FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding StarRatioSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,10,2">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 面板2:各卡池抽数占比 -->
                                <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0"
                                            IsVisible="{Binding SelectedChartIndex, Converter={x:Static vm:IndexEqualsConverter.Instance}, ConverterParameter=2}">
                                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding PoolSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                    <Path Data="{Binding Data}" Fill="{Binding Brush}" Stretch="None" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding TotalPulls}" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="总抽数" FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PoolSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,10,2">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="70" />
                                                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 每日抽数平滑面积图(自绘:平滑曲线 + 左侧单位刻度 + 网格线) -->
                        <Border Grid.Row="2" Grid.ColumnSpan="3" CornerRadius="10" Padding="12"
                                Background="{DynamicResource SemiColorBg2}">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="每日抽数" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <controls:TimeLineChart Grid.Row="1" Height="170" Margin="0,2,0,0"
                                                        Values="{Binding TimeLineCounts}"
                                                        Labels="{Binding TimeLineLabels}"
                                                        Tips="{Binding TimeLineTips}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
            </Grid>
            </TabItem>

            <!-- 视图2:统计卡片(Java CardCommon) -->
            <TabItem Header="统计卡片">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Pools}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gacha:PoolStats">
                                <Border Margin="6" Padding="14" CornerRadius="10" MinWidth="250"
                                        Background="{DynamicResource SemiColorBg2}">
                                    <StackPanel Spacing="6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="Bold" />
                                            <TextBlock Text="{Binding TotalPulls, StringFormat=总抽: {0}}" FontSize="13" Foreground="#64B5F6" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText3}">
                                            <Run Text="{Binding StartDate}" /><Run Text=" ~ " /><Run Text="{Binding EndDate}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#4CAF50" Text="{Binding CurrentPity, StringFormat=SSR 垫抽: {0} 抽}" />
                                        <TextBlock FontSize="12" Foreground="#E57373" Text="{Binding AveragePity, StringFormat=SSR 平均: {0:0} 抽}" />
                                        <TextBlock FontSize="12" Foreground="#FF8000">
                                            <Run Text="SSR: " /><Run Text="{Binding FiveStarCount}" /><Run Text="  SR: " /><Run Text="{Binding FourStarCount}" /><Run Text="  R: " /><Run Text="{Binding ThreeStarCount}" />
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="#FF8000" Text="{Binding UpCount, StringFormat=UP 数: {0}}" IsVisible="{Binding UpCount, Converter={x:Static vm:GreaterThanZeroConverter.Instance}}" />
                                        <TextBlock FontSize="12" Foreground="#64B5F6" Text="{Binding OffBannerRate, StringFormat=不歪率: {0:P1}}" IsVisible="{Binding CanJudgeUp}" />
                                        <Separator Height="1" Margin="0,2" />
                                        <TextBlock Text="五星列表" FontSize="11" Foreground="{DynamicResource SemiColorText3}" />
                                        <ItemsControl ItemsSource="{Binding FiveStarEntries}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Spacing="3" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gacha:FiveStarEntry">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Record.Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                                        <TextBlock Text="{Binding Pity, StringFormat={}{0}抽}" FontSize="11" Foreground="{Binding Pity, Converter={x:Static vm:PityColorConverter.Instance}}"
                                                                    ToolTip.Tip="{Binding FiveStarGapText}" />
                                                        <Border CornerRadius="3" Padding="4,1"
                                                                Background="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagConverter.Instance}}"
                                                                IsVisible="{Binding IsOffBanner, Converter={x:Static vm:UpFlagVisibleConverter.Instance}}">
                                                            <TextBlock Text="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagTextConverter.Instance}}" FontSize="9" Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- 视图3:详细分析(Java CardDetail) -->
            <TabItem Header="详细分析">
                <Grid ColumnDefinitions="380,*">
                    <Border Grid.Column="0" Margin="0,0,5,0" Padding="12" CornerRadius="10"
                            Background="{DynamicResource SemiColorBg2}">
                        <Grid RowDefinitions="Auto,*">
                            <!-- 竖列卡池切换按键(替代原下拉框;池名 + 抽数) -->
                            <ListBox Grid.Row="0" ItemsSource="{Binding PoolTabs}"
                                     SelectedItem="{Binding SelectedDetailPool, Mode=TwoWay}"
                                     Margin="0,0,0,8" Background="Transparent" BorderThickness="0"
                                     MaxHeight="240" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="gacha:PoolStats">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding TotalPulls, StringFormat={}{0} 抽}"
                                                       FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding FiveStarEntries}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="gacha:FiveStarEntry">
                                            <Border Margin="0,4" Padding="10" CornerRadius="8" Background="{DynamicResource SemiColorBg3}">
                                                <Grid ColumnDefinitions="Auto,*,100" RowDefinitions="Auto,Auto">
                                                    <Border Grid.RowSpan="2" Width="44" Height="44" CornerRadius="22" ClipToBounds="True"
                                                            Background="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagBgConverter.Instance}}">
                                                        <Grid>
                                                            <controls:AsyncImage ImageUrl="{Binding IconUrl}" Width="44" Height="44" Stretch="UniformToFill" />

                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                        <TextBlock Text="{Binding Record.Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Record.Time}" FontSize="10" Foreground="{DynamicResource SemiColorText3}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                                                        <TextBlock Text="{Binding Pity}" FontSize="12" FontWeight="Bold"
                                                                    ToolTip.Tip="{Binding FiveStarGapText}"
                                                                   Foreground="{Binding Pity, Converter={x:Static vm:PityColorConverter.Instance}}" HorizontalAlignment="Right" />
                                                        <Border CornerRadius="3" Padding="5,1" Background="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagConverter.Instance}}"
                                                                IsVisible="{Binding IsOffBanner, Converter={x:Static vm:UpFlagVisibleConverter.Instance}}">
                                                            <TextBlock Text="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagTextConverter.Instance}}" FontSize="9" Foreground="White" />
                                                        </Border>
                                                    </StackPanel>
                                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="80" Height="6" CornerRadius="3"
                                                                 Margin="8,4,0,0" Value="{Binding PityBarValue}"
                                                                 Foreground="{Binding Pity, Converter={x:Static vm:PityColorConverter.Instance}}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Margin="5,0,0,0" Padding="12" CornerRadius="10" Background="{DynamicResource SemiColorBg2}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding SelectedPool.DisplayName, StringFormat=卡池: {0}}" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="总抽数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock Text="{Binding SelectedPool.TotalPulls}" FontSize="20" FontWeight="Bold" />
                            <Separator Height="1" />
                            <TextBlock Text="稀有度分布" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Foreground="#FF8000"><Run Text="五星: " /><Run Text="{Binding SelectedPool.FiveStarCount}" /></TextBlock>
                            <TextBlock FontSize="12" Foreground="#A855F7"><Run Text="四星: " /><Run Text="{Binding SelectedPool.FourStarCount}" /></TextBlock>
                            <TextBlock FontSize="12" Foreground="#22D3EE"><Run Text="三星: " /><Run Text="{Binding SelectedPool.ThreeStarCount}" /></TextBlock>
                            <Separator Height="1" />
                            <TextBlock Text="详细统计" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock FontSize="12" Foreground="#E57373"><Run Text="五星平均: " /><Run Text="{Binding SelectedPool.AveragePity, StringFormat={}{0:0}}" /><Run Text=" 抽" /></TextBlock>
                            <TextBlock FontSize="12" Foreground="#FF8000"><Run Text="UP 数: " /><Run Text="{Binding SelectedPool.UpCount}" /></TextBlock>
                            <TextBlock FontSize="12" Foreground="#64B5F6" IsVisible="{Binding SelectedPool.CanJudgeUp}"><Run Text="不歪率: " /><Run Text="{Binding SelectedPool.OffBannerRate, StringFormat={}{0:P1}}" /></TextBlock>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText3}"><Run Text="当前垫: " /><Run Text="{Binding SelectedPool.CurrentPity}" /><Run Text=" 抽" /></TextBlock>
                             <TextBlock FontSize="12" Foreground="#64B5F6" Text="{Binding SelectedPool.CurrentUpPityText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 视图4:表格(Java CardTableShow) -->
            <TabItem Header="表格">
                <Grid RowDefinitions="Auto,*,Auto">
                    <ComboBox Grid.Row="0" ItemsSource="{Binding TablePoolTypes}" SelectedItem="{Binding SelectedTablePool, Mode=TwoWay}" Margin="0,0,0,8" />
                    <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="10">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding TableRecords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gacha:GachaPullEntry">
                                        <Border Margin="0,6" Padding="12,10"
                                                Background="{DynamicResource SemiColorBg3}" CornerRadius="6">
                                            <Grid ColumnDefinitions="2*,65,70,1*,55,65,160">
                                                <TextBlock Text="{Binding Record.Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Record.QualityLevel, StringFormat={}{0}星}" FontSize="14"
                                                           Foreground="{Binding Record.QualityLevel, Converter={x:Static vm:QualityColorConverter.Instance}}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Record.ResourceType}" FontSize="14" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Record.CardPoolType}" FontSize="14" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding BannerText}" FontSize="13" Foreground="#FF8000" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding FiveStarGapText}" FontSize="13" Foreground="#E57373" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding Record.Time}" FontSize="13" Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0" ColumnSpacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding TableFirstCommand}" IsEnabled="{Binding CanTablePrev}" Padding="6,2">
                                <ic:FluentIcon Icon="ChevronDoubleLeft" IconVariant="Regular" IconSize="Size16" />
                            </Button>
                            <Button Command="{Binding TablePrevCommand}" IsEnabled="{Binding CanTablePrev}" Padding="6,2">
                                <ic:FluentIcon Icon="ChevronLeft" IconVariant="Regular" IconSize="Size16" />
                            </Button>
                            <TextBlock Text="{Binding TableCurrentPage, StringFormat={}{0} / }" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="{Binding TableTotalPages}" VerticalAlignment="Center" FontSize="12" />
                            <Button Command="{Binding TableNextCommand}" IsEnabled="{Binding CanTableNext}" Padding="6,2">
                                <ic:FluentIcon Icon="ChevronRight" IconVariant="Regular" IconSize="Size16" />
                            </Button>
                            <Button Command="{Binding TableLastCommand}" IsEnabled="{Binding CanTableNext}" Padding="6,2">
                                <ic:FluentIcon Icon="ChevronDoubleRight" IconVariant="Regular" IconSize="Size16" />
                            </Button>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="90" VerticalAlignment="Center"
                                  ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding TablePageSize, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" Text="{Binding TableTotalCount, StringFormat=共 {0} 条}" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>
</UserControl>
