<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:gacha="using:McKuro.Core.Models.Gacha"
             xmlns:controls="using:McKuro.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.GachaView"
             x:DataType="vm:GachaViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- 云鸣潮登录状态(登录表单已迁移到「账号」页) -->
        <Border Grid.Row="0" Margin="20,6,20,2" Padding="10,6" CornerRadius="10"
                Background="{DynamicResource SemiColorBg2}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <ic:FluentIcon Icon="Cloud" IconVariant="Regular" IconSize="Size16" VerticalAlignment="Center" />
                    <TextBlock Text="云鸣潮" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
                <!-- 已登录:账号名 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsCloudLoggedIn}">
                    <TextBlock Text="{Binding CloudAccountText}" FontSize="12" FontWeight="Bold"
                               VerticalAlignment="Center" Foreground="{DynamicResource SemiColorPrimary}" />
                    <TextBlock Text="已登录 · 同步优先(退出登录在「账号」页)" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText3}" />
                </StackPanel>
                <!-- 未登录:引导去账号页 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding !IsCloudLoggedIn}">
                    <TextBlock Text="未登录 · 云接口同步需先在「账号」页登录云鸣潮(本地日志解析不受影响)"
                               FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText3}" />
                    <Button Content="前往「账号」页" Command="{Binding GoAccountCommand}"
                            FontSize="11" Padding="8,2" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="接口优先,本地兜底" FontSize="11"
                           Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <!-- 标题 + 玩家选择 + 同步按钮 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="20,8,20,6" ColumnSpacing="10">
            <StackPanel Spacing="1">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="Gauge" IconVariant="Regular" IconSize="Size24" VerticalAlignment="Center" />
                    <TextBlock Text="抽卡分析" FontSize="20" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding StatusText}" FontSize="11"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding PlayerIdText, StringFormat=玩家: {0}}" FontSize="11"
                               Foreground="{DynamicResource SemiColorPrimary}" />
                </StackPanel>
            </StackPanel>
            <!-- 玩家切换:支持多账号查看与"全部账号"聚合 -->
            <ComboBox Grid.Column="1"
                      Width="160"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding PlayerIds}"
                      SelectedItem="{Binding SelectedPlayerId, Mode=TwoWay}" />
            <Button Grid.Column="2" Content="同步" Classes="primary"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <!-- 视图切换(0=综合分析[默认] 1=统计卡片 2=表格) -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedViewIndex}" Padding="0" Background="Transparent" FontSize="13">
            <TabItem Header="综合分析">
                <Grid ColumnDefinitions="380,*">
            <!-- 左侧:卡池 + 五星列表 -->
            <Border Grid.Column="0"
                    Margin="0,0,5,10"
                    Padding="12"
                    Background="{DynamicResource SemiColorBg2}"
                    CornerRadius="10">
                <Grid RowDefinitions="Auto,*">
                    <!-- 卡池选择 + 当前池摘要(同排,省一行) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,8">
                        <ComboBox ItemsSource="{Binding Pools}"
                                  SelectedItem="{Binding SelectedPool, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="gacha:PoolStats">
                                    <TextBlock Text="{Binding DisplayName}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   ToolTip.Tip="当前池平均出货与 UP 后垫抽">
                            <Run Text="平均 " /><Run Text="{Binding StarAvgValue, StringFormat={}{0:0.#}}" /><Run Text=" 抽 · " /><Run Text="{Binding SelectedPool.CurrentUpPityText}" />
                        </TextBlock>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden">
                        <StackPanel>
                            <!-- 已垫行:出五星(不论歪/UP)后刷新为角色行;列结构与角色行一致保持等长 -->
                            <Border Margin="0,2"
                                    Padding="8,7"
                                    CornerRadius="8"
                                    Background="{DynamicResource SemiColorBg3}"
                                    IsVisible="{Binding ShowCurrentPityRow}">
                                <Grid ColumnDefinitions="Auto,*,44" RowDefinitions="Auto,Auto">
                                    <!-- 空图标占位(无图片),与角色行图标同列同宽 -->
                                    <Border Grid.RowSpan="2"
                                            Width="32" Height="32"
                                            CornerRadius="6"
                                            Background="{DynamicResource SemiColorBg2}" />
                                    <StackPanel Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="已垫" FontSize="13" FontWeight="Bold" />
                                        <TextBlock Text="{Binding SelectedPool.CurrentPity}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{Binding SelectedPool.CurrentPity, Converter={x:Static vm:PityColorConverter.Instance}}" />
                                    </StackPanel>
                                    <!-- 进度条:列结构与角色行(*,56)一致,保持等长 -->
                                    <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,56" Margin="8,2,0,0">
                                        <ProgressBar Minimum="0" Maximum="80"
                                                     Height="6"
                                                     CornerRadius="3"
                                                     Value="{Binding CurrentPityBarValue}"
                                                     Foreground="{Binding SelectedPool.CurrentPity, Converter={x:Static vm:PityColorConverter.Instance}}" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding FiveStarEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gacha:FiveStarEntry">
                                    <Border Margin="0,2"
                                            Padding="8,7"
                                            Background="{DynamicResource SemiColorBg3}"
                                            CornerRadius="8">
                                        <Grid ColumnDefinitions="Auto,*,44" RowDefinitions="Auto,Auto">
                                            <Border Grid.RowSpan="2"
                                                    Width="32" Height="32"
                                                    CornerRadius="6"
                                                    Background="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagBgConverter.Instance}}"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <controls:AsyncImage ImageUrl="{Binding IconUrl}"
                                                                         Width="32" Height="32"
                                                                         Stretch="UniformToFill" />

                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Text="{Binding Record.Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2"
                                                    Grid.RowSpan="2"
                                                    CornerRadius="4"
                                                    Padding="8,2"
                                                    Background="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagConverter.Instance}}"
                                                    IsVisible="{Binding IsOffBanner, Converter={x:Static vm:UpFlagVisibleConverter.Instance}}">
                                                <TextBlock FontSize="11" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           Text="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagTextConverter.Instance}}" />
                                            </Border>
                                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,56" Margin="8,2,0,0">
                                                <ProgressBar Minimum="0" Maximum="80"
                                                             Height="6"
                                                             CornerRadius="3"
                                                             Value="{Binding PityBarValue}"
                                                             Foreground="{Binding Pity, Converter={x:Static vm:PityColorConverter.Instance}}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="6,0,0,0"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding Pity, Converter={x:Static vm:PityColorConverter.Instance}}"
                                                           ToolTip.Tip="{Binding FiveStarGapText}"
                                                           Text="{Binding Pity}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧:统计条 + 图表 -->
            <Grid Grid.Column="1" Margin="5,0,0,10">
                <ScrollViewer>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- 统计条 (8 列) -->
                        <Border Grid.ColumnSpan="2" CornerRadius="10" Padding="12,10"
                                Background="{DynamicResource SemiColorBg2}">
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="总抽数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalPulls}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="称号" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Designation}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource SemiColorPrimary}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="双金次数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DoubleCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="歪的次数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CrookedTotal}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="综合评分" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Score}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="平均出货" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                        <Run Text="{Binding AvgPulls}" /><Run Text=" 抽" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="出货率" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                        <Run Text="{Binding ActualFiveStarRate}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="7" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="记录天数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                        <Run Text="{Binding Days}" /><Run Text=" 天" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 统计图(三图合一:下拉切换 保底状态/出货占比/各卡池占比,环形) -->
                        <Border Grid.Row="1" Grid.Column="0" CornerRadius="10" Padding="12"
                                Background="{DynamicResource SemiColorBg2}">
                            <Grid RowDefinitions="Auto,*">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Grid.Column="0" Text="{Binding ChartTitle}" FontSize="13"
                                               FontWeight="Bold" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                              ItemsSource="{Binding ChartOptions}"
                                              SelectedIndex="{Binding SelectedChartIndex, Mode=TwoWay}" />
                                </Grid>

                                <!-- 面板0:保底状态 -->
                                <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding SelectedChartIndex, Converter={x:Static vm:IndexEqualsConverter.Instance}, ConverterParameter=0}">
                                    <TextBlock Text="{Binding GuaranteeHeader}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}" />
                                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding GuaranteeSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                    <Path Data="{Binding Data}" Fill="{Binding Brush}" Stretch="None" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding TotalFiveStars}" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="五星" FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding GuaranteeSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,10,2">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 面板1:出货占比 -->
                                <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding SelectedChartIndex, Converter={x:Static vm:IndexEqualsConverter.Instance}, ConverterParameter=1}">
                                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding StarRatioSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                    <Path Data="{Binding Data}" Fill="{Binding Brush}" Stretch="None" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding TotalPulls}" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="总抽数" FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding StarRatioSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,10,2">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 面板2:各卡池抽数占比 -->
                                <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0" VerticalAlignment="Center"
                                            IsVisible="{Binding SelectedChartIndex, Converter={x:Static vm:IndexEqualsConverter.Instance}, ConverterParameter=2}">
                                    <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding PoolSlices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <Grid />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                    <Path Data="{Binding Data}" Fill="{Binding Brush}" Stretch="None" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding TotalPulls}" FontSize="18" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="总抽数" FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding PoolSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel HorizontalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,10,2">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="70" />
                                                    <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 每日抽数平滑面积图(自绘:平滑曲线 + 左侧单位刻度 + 网格线) -->
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="10" Padding="12"
                                Background="{DynamicResource SemiColorBg2}">
                            <Grid RowDefinitions="Auto,*">
                                <TextBlock Text="每日抽数" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                                <controls:TimeLineChart Grid.Row="1" Height="262" Margin="0,2,0,0"
                                                        Values="{Binding TimeLineCounts}"
                                                        Labels="{Binding TimeLineLabels}"
                                                        Tips="{Binding TimeLineTips}" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
            </Grid>
            </TabItem>

            <!-- 视图2:统计卡片(Java CardCommon) -->
            <TabItem Header="统计卡片">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Pools}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="gacha:PoolStats">
                                <Border Margin="6" Padding="16,14,16,14" CornerRadius="12" MinWidth="268"
                                        Background="{DynamicResource SemiColorBg2}">
                                    <StackPanel>
                                        <!-- 顶行:池名 + 保底规则徽标 + 总抽 -->
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" />
                                                <Border CornerRadius="4" Padding="6,2"
                                                        Background="{Binding GuaranteeBadgeKind, Converter={x:Static vm:GuaranteeBadgeBrushConverter.Instance}}">
                                                    <TextBlock Text="{Binding GuaranteeBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalPulls, StringFormat=总抽 {0}}"
                                                       FontSize="13" Foreground="#64B5F6" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText3}" Margin="0,4,0,0">
                                            <Run Text="{Binding StartDate}" /><Run Text=" ~ " /><Run Text="{Binding EndDate}" />
                                        </TextBlock>

                                        <!-- HERO:预计下一抽概率(右侧保底垫抽进度条) -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Margin="0,16,0,0">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UpChanceCaption}" FontSize="12"
                                                           Foreground="{DynamicResource SemiColorText3}" />
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding NextPullUpPercent, StringFormat={}{0:0.#}}"
                                                               FontSize="30" FontWeight="ExtraBold"
                                                               Foreground="{DynamicResource SemiColorPrimary}" />
                                                    <TextBlock Text="%" FontSize="16" FontWeight="Bold"
                                                               Foreground="{DynamicResource SemiColorPrimary}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                                <ProgressBar Minimum="0" Maximum="80" Height="8" CornerRadius="4"
                                                             Value="{Binding PityProgressValue}"
                                                             Foreground="{Binding GuaranteeBadgeKind, Converter={x:Static vm:GuaranteeBadgeBrushConverter.Instance}}"
                                                             Background="{DynamicResource SemiColorBg3}" />
                                                <TextBlock HorizontalAlignment="Right" FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           Text="{Binding CurrentPity, StringFormat=已垫 {0} / 80 抽}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 数据格 2×2:垫抽 / 平均 / UP 数 / 不歪率 -->
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                              RowSpacing="14" ColumnSpacing="10" Margin="0,16,0,0">
                                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding CurrentPity}" FontSize="16" FontWeight="Bold" Foreground="#4CAF50" />
                                                    <TextBlock Text="抽" FontSize="12" Foreground="#4CAF50" Margin="0,0,0,1" />
                                                </StackPanel>
                                                <TextBlock Text="SSR 垫抽" FontSize="11" Foreground="{DynamicResource SemiColorText3}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="1">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding AveragePity, StringFormat={}{0:0}, TargetNullValue=—}"
                                                               FontSize="16" FontWeight="Bold" Foreground="#E57373" />
                                                    <TextBlock Text="抽" FontSize="12" Foreground="#E57373" Margin="0,0,0,1"
                                                               IsVisible="{Binding AveragePity}" />
                                                </StackPanel>
                                                <TextBlock Text="SSR 平均" FontSize="11" Foreground="{DynamicResource SemiColorText3}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="1" IsVisible="{Binding CanJudgeUp}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding UpCount}" FontSize="16" FontWeight="Bold" Foreground="#FF8000" />
                                                    <TextBlock Text="UP" FontSize="12" Foreground="#FF8000" Margin="0,0,0,1" />
                                                </StackPanel>
                                                <TextBlock Text="UP 数" FontSize="11" Foreground="{DynamicResource SemiColorText3}" />
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="1" IsVisible="{Binding CanJudgeUp}">
                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                    <TextBlock Text="{Binding OffBannerRate, StringFormat={}{0:P1}, TargetNullValue=—}"
                                                               FontSize="16" FontWeight="Bold" Foreground="#64B5F6" />
                                                    <TextBlock Text="%" FontSize="12" Foreground="#64B5F6" Margin="0,0,0,1"
                                                               IsVisible="{Binding OffBannerRate}" />
                                                </StackPanel>
                                                <TextBlock Text="不歪率" FontSize="11" Foreground="{DynamicResource SemiColorText3}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- 脚注:SSR/SR/R 分布 -->
                                        <Separator Height="1" Margin="0,14,0,0" Background="{DynamicResource SemiColorBg3}" />
                                        <TextBlock Margin="0,10,0,0" FontSize="13" Foreground="#FF8000">
                                            <Run Text="SSR: " /><Run Text="{Binding FiveStarCount}" /><Run Text="  SR: " /><Run Text="{Binding FourStarCount}" /><Run Text="  R: " /><Run Text="{Binding ThreeStarCount}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <!-- 视图3:表格(Java CardTableShow) -->
            <TabItem Header="表格">
                <Grid RowDefinitions="Auto,*,Auto">
                    <ComboBox Grid.Row="0" ItemsSource="{Binding TablePoolTypes}" SelectedItem="{Binding SelectedTablePool, Mode=TwoWay}" Margin="0,0,0,8" />
                    <Border Grid.Row="1" CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="10">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding TableRecords}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gacha:GachaPullEntry">
                                        <Border Margin="0,6" Padding="12,10"
                                                Background="{DynamicResource SemiColorBg3}" CornerRadius="6">
                                            <Grid ColumnDefinitions="2*,65,70,1*,55,65,160">
                                                <TextBlock Text="{Binding Record.Name}" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Record.QualityLevel, StringFormat={}{0}星}" FontSize="14"
                                                           Foreground="{Binding Record.QualityLevel, Converter={x:Static vm:QualityColorConverter.Instance}}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Record.ResourceType}" FontSize="14" Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding Record.CardPoolType}" FontSize="14" Foreground="{DynamicResource SemiColorText2}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="4" Text="{Binding BannerText}" FontSize="13" Foreground="#FF8000" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="5" Text="{Binding FiveStarGapText}" FontSize="13" Foreground="#E57373" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="6" Text="{Binding Record.Time}" FontSize="13" Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,8,0,0" ColumnSpacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Command="{Binding TableFirstCommand}" IsEnabled="{Binding CanTablePrev}" Padding="6,2">
                                <ic:FluentIcon Icon="ChevronDoubleLeft" IconVariant="Regular" IconSize="Size16" />
                            </Button>
                            <Button Command="{Binding TablePrevCommand}" IsEnabled="{Binding CanTablePrev}" Padding="6,2">
                                <ic:FluentIcon Icon="ChevronLeft" IconVariant="Regular" IconSize="Size16" />
                            </Button>
                            <TextBlock Text="{Binding TableCurrentPage, StringFormat={}{0} / }" VerticalAlignment="Center" FontSize="12" />
                            <TextBlock Text="{Binding TableTotalPages}" VerticalAlignment="Center" FontSize="12" />
                            <Button Command="{Binding TableNextCommand}" IsEnabled="{Binding CanTableNext}" Padding="6,2">
                                <ic:FluentIcon Icon="ChevronRight" IconVariant="Regular" IconSize="Size16" />
                            </Button>
                            <Button Command="{Binding TableLastCommand}" IsEnabled="{Binding CanTableNext}" Padding="6,2">
                                <ic:FluentIcon Icon="ChevronDoubleRight" IconVariant="Regular" IconSize="Size16" />
                            </Button>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="90" VerticalAlignment="Center"
                                  ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding TablePageSize, Mode=TwoWay}" />
                        <TextBlock Grid.Column="3" Text="{Binding TableTotalCount, StringFormat=共 {0} 条}" FontSize="12"
                                   Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        </Grid>
</UserControl>
