<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="520"
        x:Class="McKuro.Views.GeetestWindow"
        Title="完成滑块验证"
        Width="500" Height="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#FFF8FAFC">
  <!-- 应用内极验验证窗口:WebView 控件由代码后置按平台选择
       (macOS=WkWebViewControl,Windows=WebView2Control),验证结果仍走本地 HTTP 回调,
       页面自身负责状态提示。 -->
  <Panel>
    <ContentPresenter x:Name="WebViewHost" />
    <!-- 加载遮罩:WebView2 冷启动(环境 + 浏览器子进程 + 页面)期间盖住黑屏,渲染子窗口出现后淡出 -->
    <Panel x:Name="LoadingOverlay" Background="#FFF8FAFC" ZIndex="10">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <!-- 自绘旋转加载环:不依赖主题样式,旋转动画在代码后置驱动 -->
        <TextBlock x:Name="SpinnerGlyph" Text="◐" FontSize="34" Foreground="#FF14B8C6" HorizontalAlignment="Center">
          <TextBlock.RenderTransform>
            <RotateTransform />
          </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="LoadingText" Text="正在加载验证组件…" FontSize="14" Foreground="#FF334155"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="LoadingSub" Text="首次加载约需数秒,请稍候" FontSize="12" Foreground="#FF667085"
                   HorizontalAlignment="Center" />
      </StackPanel>
    </Panel>
  </Panel>
</Window>
