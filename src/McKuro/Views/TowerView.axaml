<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:controls="using:McKuro.Controls"
             xmlns:tower="using:McKuro.Core.Models.Tower"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:loc="clr-namespace:McKuro.Services"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.TowerView"
             x:DataType="vm:TowerViewModel">
    <UserControl.Resources>
        <!-- 增益标签(海墟/终焉矩阵共用)。
             注意:库街区部分 buff 图标是**纯白剪影**(RGB 255,255,255 + alpha,如
             buff_Img/1787186054722.png 声骸技能强化),放在浅色底上会"看不见"——
             故图标统一加一层深色底衬,白剪影与彩色图标都能看清。 -->
        <DataTemplate x:Key="BuffTemplate" x:DataType="vm:TowerBuffItem">
            <Border CornerRadius="8" Background="{DynamicResource SemiColorBg2}" Padding="8,5"
                    ToolTip.Tip="{Binding BuffDescription}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="5" ClipToBounds="True"
                            Background="#9BA0AE">
                        <controls:AsyncImage ImageUrl="{Binding BuffIcon}" Width="20" Height="20"
                                             Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="{Binding BuffName}" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource SemiColorText2}" MaxWidth="260"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 全息战略-地区 logo 徽章(演武/同步/幻痛/强袭)。
             四个地区图标是"整块彩色浮雕图",没有可着色的线稿,故选中态不换图标颜色,
             而是靠底色淡染 + 描边表达;这样两个主题下都不会把原图颜色改坏。 -->
        <Style Selector="Button.holoRegion">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,7" />
        </Style>
        <Style Selector="Button.holoRegion:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipFillHover}" />
        </Style>
        <Style Selector="Button.holoRegion.active">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipSelectedFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
        </Style>
        <!-- 选中项悬停时保持选中底色,避免"一悬停就把选中高亮冲掉" -->
        <Style Selector="Button.holoRegion.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipSelectedFill}" />
        </Style>
        <Style Selector="Button.holoRegion:disabled">
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- 全息战略-boss 卡片:整卡可点,选中用描边 + 淡染底突出 -->
        <Style Selector="Button.holoBoss">
            <Setter Property="Background" Value="{DynamicResource SemiColorBg3}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="10,9" />
        </Style>
        <Style Selector="Button.holoBoss:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipFillHover}" />
        </Style>
        <Style Selector="Button.holoBoss.active">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipSelectedFill}" />
        </Style>
        <Style Selector="Button.holoBoss.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipSelectedFill}" />
        </Style>

        <!-- 全息战略-难度刻度格。
             颜色**必须走主题令牌**:此前把色值硬编码在 VM 里(#E0B94E 浅金 / #8A8F99 浅灰),
             浅色主题下浅金压在浅底上几乎看不出来(用户反馈"当期难度文本在白色主题下不明显")。
             现在亮/暗主题各取一份 McKuroHolo* 令牌。 -->
        <Style Selector="Border.holoPip">
            <Setter Property="Background" Value="{DynamicResource McKuroHoloPipEmpty}" />
        </Style>
        <Style Selector="Border.holoPip.filled">
            <Setter Property="Background" Value="{DynamicResource McKuroHoloGoldSoft}" />
        </Style>
        <!-- 满档那一格更亮一档,把"打满了"和"打到第 5 档"一眼分开 -->
        <Style Selector="Border.holoPip.filled.max">
            <Setter Property="Background" Value="{DynamicResource McKuroHoloGold}" />
        </Style>

        <!-- 全息战略-boss 卡片的难度文案:未挑战次级灰,已挑战常规文字色 -->
        <Style Selector="TextBlock.holoDifficulty">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText3}" />
        </Style>
        <Style Selector="TextBlock.holoDifficulty.challenged">
            <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
        </Style>

        <!-- 全息战略-难度档位的「已通关」圆点(未通关透明占位,避免切换档位时行高跳动) -->
        <Style Selector="Ellipse.holoDot">
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Ellipse.holoDot.cleared">
            <Setter Property="Fill" Value="{DynamicResource McKuroHoloGold}" />
        </Style>

        <!-- 全息战略-通关时间数值 -->
        <Style Selector="TextBlock.holoTime">
            <Setter Property="Foreground" Value="{DynamicResource McKuroHoloGold}" />
        </Style>

        <!-- 全息战略-难度档位选择器(竖向 6 行)。
             行间距给足:每行是一个可点目标,贴太紧既难瞄准、也读不出"6 个独立档位";
             用 ListBoxItem 内边距做间距(比给每行加 Margin 更稳,选中高亮块会跟着一起变高)。 -->
        <Style Selector="ListBox.holoTiers ListBoxItem">
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="20,16,20,16">
        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:FluentIcon Icon="BuildingSkyscraper" IconVariant="Regular" IconSize="Size24" VerticalAlignment="Center" />
                <TextBlock Text="{loc:Localize Key=Tower.Title}" FontSize="24" FontWeight="Bold" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}" />
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}"
                    IsVisible="{Binding HasData}"
                    Padding="0" Background="Transparent" FontSize="13">
            <!-- 逆境深塔 -->
            <TabItem Header="{loc:Localize Key=Tower.TabTower}">
                <Grid RowDefinitions="Auto,*" Margin="8,8,8,8">
                    <!-- 未解锁提示 -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="8" IsVisible="{Binding !TowerUnlocked}">
                        <TextBlock Text="{loc:Localize Key=Tower.TowerLocked}" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Key=Tower.TowerLockedDesc}"
                                   FontSize="12" Foreground="{DynamicResource SemiColorText2}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" Margin="0,0,0,10"
                          IsVisible="{Binding TowerUnlocked}">
                        <TextBlock Text="{Binding TowerSeasonEndText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorText2}" />
                        <ComboBox Grid.Column="1" MinWidth="150" FontSize="14"
                                  ItemsSource="{Binding TowerDifficulties}"
                                  SelectedItem="{Binding SelectedTowerDifficulty}"
                                  DisplayMemberBinding="{Binding DifficultyName}" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" IsVisible="{Binding TowerUnlocked}"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding TowerAreas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 区域卡片固定 2 列(用户口径:「深塔应该是2列显示」)。
                                         原先用 WrapPanel + 固定 Width=512:两张卡需要 512+14+512=1038px
                                         才排得下,窗口稍窄就整排换成 1 列,看起来像"单列列表"。
                                         改用 UniformGrid 每格自动占一半可用宽,窄窗口也稳定 2 列。 -->
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <!-- 卡片间距(UniformGrid 各格紧贴,需要自己留出间隙)。
                                     只命中直接子级,避免影响卡片内部楼层/角色列表的 ContentPresenter。 -->
                                <Style Selector="ItemsControl > ContentPresenter">
                                    <Setter Property="Margin" Value="0,0,14,14" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TowerAreaItem">
                                    <Border CornerRadius="12" Background="{DynamicResource SemiColorBg3}"
                                            Padding="18,16">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <TextBlock Text="{Binding AreaName}" FontSize="18" FontWeight="Bold"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" FontSize="17" FontWeight="Bold"
                                                           Foreground="#f8c94c"
                                                           Text="{Binding StarText}" VerticalAlignment="Center" />
                                            </Grid>
                                            <!-- 楼层列表 -->
                                            <ItemsControl ItemsSource="{Binding Floors}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="14" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TowerFloorItem">
                                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10" Margin="2,0,2,0">
                                                            <TextBlock Text="{Binding FloorName}" FontSize="15"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource SemiColorText1}" />
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding FilledStars}" FontSize="18"
                                                                           Foreground="#f8c94c" />
                                                                <TextBlock Text="{Binding EmptyStars}" FontSize="18"
                                                                           Foreground="{DynamicResource SemiColorText3}"
                                                                           Opacity="0.6" />
                                                            </StackPanel>
                                                            <!-- 配队角色 -->
                                                            <ItemsControl Grid.Column="2" ItemsSource="{Binding Roles}"
                                                                          VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="tower:TowerSeasonRole">
                                                                        <Border Width="52" Height="52" CornerRadius="26"
                                                                                ClipToBounds="True"
                                                                                Background="{DynamicResource SemiColorBg2}"
                                                                                BorderBrush="{DynamicResource SemiColorText3}"
                                                                                BorderThickness="1">
                                                                            <controls:AsyncImage ImageUrl="{Binding IconUrl}"
                                                                                                 Width="52" Height="52"
                                                                                                 Stretch="UniformToFill" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 终焉矩阵(主从布局,对齐 WutheringWavesTool NewTowerView:左栏模式/历史,右栏详情) -->
            <TabItem Header="{loc:Localize Key=Tower.TabMatrix}">
                <Grid Margin="8,8,8,8" ColumnDefinitions="264,*" ColumnSpacing="14">
                    <!-- 左栏:挑战模式 + 往期历史 -->
                    <Border Grid.Column="0" CornerRadius="12" Background="{DynamicResource SemiColorBg3}" Padding="14">
                        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,*,Auto">
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="2,0,0,8">
                                <ic:FluentIcon Icon="TargetArrow" IconVariant="Regular" IconSize="Size16"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Localize Key=Tower.ChallengeMode}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding TowerModes}"
                                     SelectedItem="{Binding SelectedTowerMode}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     MaxHeight="220">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TowerModeItem">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,4">
                                            <TextBlock Text="{Binding ModeName}" FontSize="14" FontWeight="Bold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                        VerticalAlignment="Center">
                                                <!-- 固定宽度 + 右对齐/居中:每行是独立 Grid,Auto 列会按各自内容宽
                                                     排版,不固定就会出现"SSS 比 S 宽 → 分数文本左右错位" -->
                                                <TextBlock Text="{Binding ScoreText}" FontSize="14" FontWeight="Bold"
                                                           Width="62" TextAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                                <Border CornerRadius="6" Padding="0" Width="46" Height="22"
                                                        Background="{Binding RankColor}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RankText}" FontSize="11.5" FontWeight="Bold"
                                                               Foreground="Black"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               TextAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Row="2" Height="1" Background="{DynamicResource SemiColorBg2}" Margin="0,12,0,0" />
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="2,12,0,8">
                                <ic:FluentIcon Icon="History" IconVariant="Regular" IconSize="Size16"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Localize Key=Tower.History}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <ListBox Grid.Row="4" ItemsSource="{Binding NewTowerHistory}"
                                     SelectedItem="{Binding SelectedNewTowerHistory}"
                                     Background="Transparent" BorderThickness="0" Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:NewTowerHistoryItem">
                                        <!-- 时间节点 + 区间:参考实现每条历史带一个圆点节点(选中时点亮)
                                             与「起始日 → 结束日」两行;仅给一个孤立截止日看不出覆盖哪段时间。 -->
                                        <StackPanel Orientation="Horizontal" Spacing="9" Margin="2,7" >
                                            <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                                     Stroke="{DynamicResource SemiColorText3}" StrokeThickness="1.2"
                                                     Fill="Transparent" />
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="{Binding PeriodText}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource SemiColorText1}" />
                                                <TextBlock Text="{Binding Label}" FontSize="11.5"
                                                           Foreground="{DynamicResource SemiColorText3}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <!-- 选中态:节点填充(对齐参考实现 .list-cell:selected .history-marker) -->
                                    <Style Selector="ListBoxItem:selected Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource SemiColorPrimary}" />
                                        <Setter Property="Stroke" Value="{DynamicResource SemiColorPrimary}" />
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                            <TextBlock Grid.Row="5" Text="{loc:Localize Key=Tower.NoHistory}" FontSize="12.5" Margin="2,10,0,0"
                                       Foreground="{DynamicResource SemiColorText3}"
                                       IsVisible="{Binding !HasNewTowerHistory}" />
                            <TextBlock Grid.Row="6" Text="" />
                        </Grid>
                    </Border>

                    <!-- 右栏:模式详情 / 历史详情 / 等待开放空态 -->
                    <Grid Grid.Column="1">
                        <!-- 空态:本期无记录且未查看历史 -->
                        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="8" Margin="0,48,0,0"
                                    IsVisible="{Binding NewTowerShowWaiting}">
                            <TextBlock Text="{loc:Localize Key=Tower.MatrixWaitOpen}" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{loc:Localize Key=Tower.MatrixEmptyDesc}"
                                       FontSize="12.5" Foreground="{DynamicResource SemiColorText2}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- 详情卡(当前模式或历史) -->
                        <ScrollViewer IsVisible="{Binding NewTowerDetail, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <StackPanel Spacing="10" Margin="0,0,8,0">
                                <TextBlock Text="{Binding NewTowerDetailTitle}" FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource SemiColorText2}"
                                           IsVisible="{Binding NewTowerDetailTitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <Border CornerRadius="12" Background="{DynamicResource SemiColorBg3}"
                                        Padding="18,16">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NewTowerDetail.ModeName}" FontSize="17" FontWeight="Bold" />
                                                <TextBlock FontSize="12.5" Foreground="{DynamicResource SemiColorText2}">
                                                    <Run Text="{loc:Localize Key=Tower.ProgressPrefix}" /><Run Text="{Binding NewTowerDetail.ProgressText}" FontWeight="Bold" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="0" VerticalAlignment="Center"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding NewTowerDetail.ScoreText}" FontSize="26" FontWeight="Bold"
                                                           HorizontalAlignment="Right" />
                                                <TextBlock Text="{loc:Localize Key=Tower.Score}" FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText3}"
                                                           HorizontalAlignment="Right" />
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="8" Padding="12,6"
                                                    Background="{Binding NewTowerDetail.RankColor}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NewTowerDetail.RankText}" FontSize="15" FontWeight="Bold"
                                                           Foreground="Black" />
                                            </Border>
                                        </Grid>
                                        <!-- 每轮队伍分数:矩阵按轮次分队,每队独立积分/进度/角色/增益 -->
                                        <Border Height="1" Background="{DynamicResource SemiColorBg2}"
                                                IsVisible="{Binding NewTowerDetail.Rounds.Count}" />
                                        <StackPanel Spacing="10" IsVisible="{Binding NewTowerDetail.Rounds.Count}">
                                            <TextBlock Text="{loc:Localize Key=Tower.TeamsTitle}" FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                            <ItemsControl ItemsSource="{Binding NewTowerDetail.Rounds}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="12" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TowerRoundItem">
                                                        <StackPanel Spacing="6">
                                                            <!-- 轮次标题 + 本轮合计 -->
                                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                                  IsVisible="{Binding RoundText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                                <Border CornerRadius="6" Padding="8,2"
                                                                        Background="{DynamicResource SemiColorBg2}">
                                                                    <TextBlock Text="{Binding RoundText}" FontSize="12"
                                                                               FontWeight="Bold" />
                                                                </Border>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                                            Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Text="{loc:Localize Key=Tower.RoundTotal}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource SemiColorText3}"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding RoundScoreText}" FontSize="13"
                                                                               FontWeight="Bold"
                                                                               Foreground="{DynamicResource SemiColorPrimary}" />
                                                                </StackPanel>
                                                            </Grid>
                                                            <!-- 本轮各队 -->
                                                            <ItemsControl ItemsSource="{Binding Teams}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Spacing="6" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:TowerTeamItem">
                                                                        <Border CornerRadius="8"
                                                                                Background="{DynamicResource SemiColorBg2}"
                                                                                Padding="10,8">
                                                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                                                                  ColumnSpacing="10">
                                                                                <TextBlock Text="{Binding TeamNoText}"
                                                                                           FontSize="12" FontWeight="Bold"
                                                                                           VerticalAlignment="Center"
                                                                                           Foreground="{DynamicResource SemiColorText2}" />
                                                                                <!-- 分数与「分数」小字同排:两行竖排时大号数值只占块的上半,
                                                                                     视觉中心会比头像高约 5px(用户反馈「分数数据和头像需要上下对齐」)。
                                                                                     改为单行(数值 + 小字标注)后整行中心即与头像中心重合。 -->
                                                                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                                            Spacing="3"
                                                                                            VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding ScoreText}"
                                                                                               FontSize="15" FontWeight="Bold"
                                                                                               VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource SemiColorPrimary}" />
                                                                                    <TextBlock Text="{loc:Localize Key=Tower.Score}"
                                                                                               FontSize="10"
                                                                                               VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource SemiColorText3}" />
                                                                                </StackPanel>
                                                                                <!-- 该队角色:与分数块同高居中 -->
                                                                                <ItemsControl Grid.Column="2"
                                                                                              ItemsSource="{Binding Roles}"
                                                                                              Height="34"
                                                                                              VerticalAlignment="Center">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal"
                                                                                                        Spacing="6" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="tower:NewTowerRole">
                                                                                            <Border Width="34" Height="34"
                                                                                                    CornerRadius="7"
                                                                                                    ClipToBounds="True"
                                                                                                    Background="{DynamicResource SemiColorBg3}">
                                                                                                <controls:AsyncImage ImageUrl="{Binding IconUrl}"
                                                                                                                     Width="34" Height="34"
                                                                                                                     Stretch="UniformToFill" />
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                                                            Spacing="8"
                                                                                            VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding PassText}"
                                                                                               FontSize="12" FontWeight="Bold"
                                                                                               VerticalAlignment="Center"
                                                                                               Foreground="{DynamicResource SemiColorText2}" />
                                                                                    <ItemsControl ItemsSource="{Binding Buffs}"
                                                                                                  ItemTemplate="{StaticResource BuffTemplate}"
                                                                                                  VerticalAlignment="Center" />
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- 海墟 -->
            <TabItem Header="{loc:Localize Key=Tower.TabSea}">
                <Grid RowDefinitions="Auto,*" Margin="8,8,8,8">
                    <!-- 本期总积分 / 刷新倒计时(对齐 WutheringWavesTool score01/score02/endTime) -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10"
                                IsVisible="{Binding SlashHasRecord}">
                        <TextBlock Text="{loc:Localize Key=Tower.SeasonScore}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorText2}" />
                        <TextBlock Text="{Binding SlashTotalScoreText}" FontSize="17" FontWeight="Bold"
                                   VerticalAlignment="Center" IsVisible="{Binding SlashTotalScoreText,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <Border CornerRadius="7" Padding="10,4" Background="{DynamicResource SemiColorBg2}"
                                VerticalAlignment="Center" IsVisible="{Binding SlashHasTurbidScore}">
                            <TextBlock Text="{Binding SlashTurbidScoreText}" FontSize="13" FontWeight="Bold"
                                       Foreground="#f8c94c" />
                        </Border>
                        <TextBlock Text="{Binding SlashSeasonEndText}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorText2}" IsVisible="{Binding SlashSeasonEndText,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <!-- 本期无挑战记录提示 -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="8" IsVisible="{Binding !SlashHasRecord}">
                        <TextBlock Text="{loc:Localize Key=Tower.SeaEmpty}" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Key=Tower.SeaEmptyDesc}"
                                   FontSize="12" Foreground="{DynamicResource SemiColorText2}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" IsVisible="{Binding SlashHasRecord}">
                        <ItemsControl ItemsSource="{Binding SlashChallenges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- 同上:海墟关卡卡片换行后同样需要行间距,否则上下两排贴死 -->
                                    <WrapPanel ItemSpacing="14" LineSpacing="14" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SlashChallengeItem">
                                    <Border CornerRadius="12" Background="{DynamicResource SemiColorBg3}"
                                            Padding="18,16" Width="512">
                                        <StackPanel Spacing="16">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
                                                <Border CornerRadius="8" Padding="10,5" VerticalAlignment="Center"
                                                        Background="{DynamicResource SemiColorBg2}"
                                                        BorderBrush="{DynamicResource SemiColorPrimary}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding ChallengeNoText}" FontSize="14" FontWeight="Bold"
                                                               Foreground="{DynamicResource SemiColorText1}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding ChallengeName}" FontSize="18" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Grid.Column="3" Spacing="0" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding ScoreText}" FontSize="28" FontWeight="Bold"
                                                               HorizontalAlignment="Right" />
                                                    <TextBlock Text="{loc:Localize Key=Tower.Score}" FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText3}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>
                                                <Border Grid.Column="4" CornerRadius="8" Padding="13,7"
                                                        Background="{Binding RankColor}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RankText}" FontSize="16" FontWeight="Bold"
                                                               Foreground="Black" />
                                                </Border>
                                            </Grid>
                                            <!-- hairline 分隔 -->
                                            <Border Height="1" Background="{DynamicResource SemiColorBg2}" />
                                            <!-- 上/下半队伍(行间大间距) -->
                                            <ItemsControl ItemsSource="{Binding Teams}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="22" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SlashTeamItem">
                                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="12">
                                                            <TextBlock Text="{Binding TeamName}" FontSize="13.5" FontWeight="Bold"
                                                                       Foreground="{DynamicResource SemiColorText2}"
                                                                       VerticalAlignment="Center" MinWidth="34" />
                                                            <TextBlock Grid.Column="1" Text="{Binding ScoreText}" FontSize="16" FontWeight="Bold"
                                                                       VerticalAlignment="Center" MinWidth="46" />
                                                            <!-- 增益 pill -->
                                                            <Border Grid.Column="2" CornerRadius="7" Padding="8,4"
                                                                    Background="{DynamicResource SemiColorBg2}"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip.Tip="{Binding BuffDescription}"
                                                                    Margin="0,0,4,0">
                                                                <StackPanel Orientation="Horizontal" Spacing="6"
                                                                            VerticalAlignment="Center">
                                                                    <Border Width="20" Height="20" CornerRadius="5" ClipToBounds="True"
                                                                            Background="{DynamicResource SemiColorBg1}">
                                                                        <controls:AsyncImage ImageUrl="{Binding BuffIcon}" Width="20" Height="20"
                                                                                             Stretch="UniformToFill" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding BuffName}" FontSize="12.5"
                                                                               Foreground="{DynamicResource SemiColorText2}"
                                                                               VerticalAlignment="Center" MaxWidth="148"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                            </Border>
                                                            <!-- 配队角色 -->
                                                            <ItemsControl Grid.Column="3" ItemsSource="{Binding Roles}"
                                                                          HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal" Spacing="10" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="tower:NewTowerRole">
                                                                        <Border Width="52" Height="52" CornerRadius="10"
                                                                                ClipToBounds="True"
                                                                                Background="{DynamicResource SemiColorBg2}"
                                                                                BorderBrush="{DynamicResource SemiColorText3}"
                                                                                BorderThickness="1">
                                                                            <controls:AsyncImage ImageUrl="{Binding IconUrl}"
                                                                                                 Width="52" Height="52"
                                                                                                 Stretch="UniformToFill" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 全息战略(challengeIndex + challengeDetails) -->
            <TabItem Header="{loc:Localize Key=Tower.TabHolo}">
                <Grid RowDefinitions="Auto,*" Margin="8,8,8,8">
                    <!-- 未解锁提示 -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="8" IsVisible="{Binding !HologramUnlocked}">
                        <TextBlock Text="{loc:Localize Key=Tower.Holo.Locked}" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Key=Tower.Holo.LockedDesc}"
                                   FontSize="12" Foreground="{DynamicResource SemiColorText2}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 已解锁但本期无数据 -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="8" IsVisible="{Binding HologramShowEmpty}">
                        <TextBlock Text="{loc:Localize Key=Tower.Holo.Empty}" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{loc:Localize Key=Tower.Holo.EmptyDesc}"
                                   FontSize="12" Foreground="{DynamicResource SemiColorText2}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 主从布局:左列(地区菜单 / 总览 / boss 网格)+ 右列(挑战详情)。
                         详情单独占满右侧整列高度(而不是只在下半区),这样小窗口下
                         立绘、难度档位、通关时间与通关队伍能一次看全,不必在窄条里滚动。 -->
                    <Grid Grid.Row="0" Grid.RowSpan="2"
                          IsVisible="{Binding HologramHasData}"
                          ColumnDefinitions="*,312" ColumnSpacing="14">

                      <!-- 左列:地区菜单 / 总览 / boss 网格 -->
                      <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" RowSpacing="12">

                        <!-- ① 地区 logo 菜单:四个浮雕徽章(演武/同步/幻痛/强袭)。
                             接口只给"整块彩色图"的地区图标,没有可着色的线稿,故不做着色;
                             选中态用强调色描边 + 底色提亮表达(而非给图标换色,避免色偏)。
                             每个徽章下方是名称 + 该地区"已通关进度"(已打过任意档的 boss 数 / 总数)
                            + 一条细进度条,一眼看清打到哪。 -->
                        <ItemsControl Grid.Row="0" ItemsSource="{Binding HologramRegions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Styles>
                                <!-- 徽章自带内边距,外层不需要额外间距(否则选中描边会与相邻项贴住) -->
                                <Style Selector="ItemsControl > ContentPresenter">
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </ItemsControl.Styles>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HologramRegionItem">
                                    <Button Classes="holoRegion"
                                            Classes.active="{Binding IsSelected}"
                                            Command="{Binding $parent[ItemsControl].((vm:TowerViewModel)DataContext).SelectHologramRegionCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding TooltipText}">
                                        <StackPanel Spacing="4" HorizontalAlignment="Center" Width="72">
                                            <Border Width="38" Height="38" CornerRadius="10"
                                                    HorizontalAlignment="Center"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource SemiColorBg2}">
                                                <controls:AsyncImage ImageUrl="{Binding LogoUrl}"
                                                                     Width="38" Height="38"
                                                                     Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <!-- 进度:已打过任意档的 boss 数 / 总数 + 一条细进度条
                                                 (不再显示「满档」—— 用户口径:有进度就行) -->
                                            <TextBlock Text="{Binding ProgressText}" FontSize="10.5"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Value="{Binding ProgressPercent}"
                                                         Height="3" CornerRadius="1.5"
                                                         Margin="4,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- ② 总览一行(已通关 boss 统计)。库街区攻略站入口已按用户要求移除。 -->
                        <TextBlock Grid.Row="1" Text="{Binding HologramSummaryText}" FontSize="12"
                                   Margin="2,0,2,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SemiColorText2}" />

                        <!-- ③ boss 卡片网格(头像 + 名称 + 6 格难度刻度) -->
                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding HologramBosses}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="10" LineSpacing="10" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HologramBossItem">
                                        <Button Classes="holoBoss"
                                                Classes.active="{Binding IsSelected}"
                                                Command="{Binding $parent[ItemsControl].((vm:TowerViewModel)DataContext).SelectHologramBossCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Width="106" Spacing="6">
                                                <!-- 头像:不加满档金色描边(用户口径:去掉)——
                                                     "打满了"由下方 6 格难度刻度与难度文案表达。 -->
                                                <Border Width="106" Height="106" CornerRadius="11" ClipToBounds="True"
                                                        Background="{DynamicResource SemiColorBg2}">
                                                    <controls:AsyncImage ImageUrl="{Binding HeadIcon}"
                                                                         Width="106" Height="106"
                                                                         Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock Text="{Binding BossName}" FontSize="13" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding BossName}" />
                                                <!-- 难度刻度:6 格恒在,已通关上色、未通关压暗。
                                                     颜色走 Classes + 主题令牌,亮/暗主题各取一份 —— 硬编码浅金在白底上看不见。 -->
                                                <ItemsControl ItemsSource="{Binding Pips}" HorizontalAlignment="Center">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:HologramPip">
                                                            <Border Width="13" Height="5" CornerRadius="2.5"
                                                                    Margin="0,0,3,0"
                                                                    Classes="holoPip"
                                                                    Classes.filled="{Binding Filled}"
                                                                    Classes.max="{Binding IsMaxTier}"
                                                                    ToolTip.Tip="{Binding Tooltip}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <!-- 难度文案:已挑战用常规文字色,未挑战用次级灰。
                                                     此前硬编码浅灰(#8A8F99)在白色主题下几乎不可见(用户反馈)。 -->
                                                <TextBlock Text="{Binding DifficultyText}" FontSize="11"
                                                           HorizontalAlignment="Center"
                                                           Classes="holoDifficulty"
                                                           Classes.challenged="{Binding HasAnyClear}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                      </Grid>

                      <!-- 右列:选中 boss 的挑战详情。
                           布局(自上而下):① boss 大图(通栏)② 名称 + 等级
                                          ③ 通关难度(左) | 通关时间 + 通关队伍(右)。
                           大图通栏用 UniformToFill:3:2 横图铺满整宽只裁掉很少的上下边,
                           比"缩成方形卡留大片空白"更像封面;难度与队伍并排后小窗口也能一次看全。
                           内容超出时整块滚动。 -->
                      <Border Grid.Column="1" CornerRadius="12" Background="{DynamicResource SemiColorBg3}"
                              ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="0">
                                <!-- ① boss 大图:通栏封面,直接贴住卡片的上/左/右边缘
                                     (无边框、无外边距)—— 由外层 Border 的 CornerRadius + ClipToBounds 收圆角。
                                     随难度切换而换图(每个难度一张独立立绘)。 -->
                                <controls:AsyncImage ImageUrl="{Binding HologramHeroIcon}"
                                                     Height="140"
                                                     Stretch="UniformToFill"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch" />

                                <StackPanel Margin="12,10,12,12" Spacing="10">
                                <!-- ② 标题行(名称 + 等级) -->
                                <StackPanel Spacing="1">
                                    <TextBlock Text="{Binding HologramBossName}" FontSize="16" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding HologramBossLevelText}" FontSize="11.5"
                                               Foreground="{DynamicResource SemiColorText2}" />
                                </StackPanel>

                                <!-- ③ 通关难度(左列) | 通关时间 + 通关队伍(右列) -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Localize Key=Tower.Holo.DifficultyTitle}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource SemiColorText2}" />
                                        <!-- 难度竖向排列:每档一行(数字 + 已通关标记),
                                             行式比横排数字条更好点、也更省横向空间 -->
                                        <ListBox Classes="holoTiers"
                                                 ItemsSource="{Binding HologramTiers}"
                                                 SelectedItem="{Binding SelectedHologramTier}"
                                                 Background="Transparent" BorderThickness="0" Padding="0">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:HologramTierItem">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                                                          ToolTip.Tip="{Binding Tooltip}">
                                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                                   FontWeight="Bold" VerticalAlignment="Center"
                                                                   MinWidth="10" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                    Spacing="5" VerticalAlignment="Center">
                                                            <!-- 已通关标记(未通关保持占位,避免行高跳动) -->
                                                            <Ellipse Width="6" Height="6"
                                                                     VerticalAlignment="Center"
                                                                     Classes="holoDot"
                                                                     Classes.cleared="{Binding IsCleared}" />
                                                            <TextBlock Text="{Binding StateText}" FontSize="11"
                                                                       VerticalAlignment="Center"
                                                                       Classes="holoDifficulty"
                                                                       Classes.challenged="{Binding IsCleared}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <!-- 右侧:通关时间 + 通关队伍 -->
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <!-- 通关时间:三种状态——
                                             已通关 → 用时;未通关 → 「暂无挑战记录」;
                                             详情接口失败(索引仍显示打到第 N 档)→ 「挑战记录暂不可用」,
                                             绝不把"拿不到记录"渲染成"没打过"(会与左侧卡片矛盾)。 -->
                                        <Border CornerRadius="9" Background="{DynamicResource SemiColorBg2}"
                                                Padding="10,8">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{loc:Localize Key=Tower.Holo.PassTime}"
                                                           FontSize="11.5"
                                                           Foreground="{DynamicResource SemiColorText2}" />
                                                <TextBlock Text="{Binding HologramPassTimeText}"
                                                           FontSize="21" FontWeight="Bold"
                                                           Classes="holoTime"
                                                           IsVisible="{Binding HologramTierCleared}" />
                                                <TextBlock Text="{loc:Localize Key=Tower.Holo.RecordsUnavailable}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           IsVisible="{Binding !HologramRecordsAvailable}" />
                                                <TextBlock Text="{loc:Localize Key=Tower.Holo.NoRecord}"
                                                           FontSize="12.5"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           IsVisible="{Binding HologramShowNoRecord}" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 通关队伍(3 名角色:头像 + 属性图标 + 等级) -->
                                        <StackPanel Spacing="6" IsVisible="{Binding HologramTierCleared}">
                                            <TextBlock Text="{loc:Localize Key=Tower.Holo.TeamTitle}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                            <ItemsControl ItemsSource="{Binding HologramRoles}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="6" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:HologramRoleItem">
                                                        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                            <!-- 头像:圆角方形,与深塔/海墟的角色头像同一套形状语言 -->
                                                            <Border Width="34" Height="34" CornerRadius="8"
                                                                    ClipToBounds="True"
                                                                    Background="{DynamicResource SemiColorBg2}">
                                                                <controls:AsyncImage ImageUrl="{Binding HeadIcon}"
                                                                                     Width="34" Height="34"
                                                                                     Stretch="UniformToFill" />
                                                            </Border>
                                                            <!-- 属性图标(本地 Assets/attr/{id}.png,与角色页同一份) -->
                                                            <Border Grid.Column="1" Width="18" Height="18"
                                                                    CornerRadius="5" ClipToBounds="True"
                                                                    VerticalAlignment="Center"
                                                                    ToolTip.Tip="{Binding ElementName}">
                                                                <controls:AsyncImage ImageUrl="{Binding ElementIconPath}"
                                                                                     Width="18" Height="18"
                                                                                     Stretch="UniformToFill" />
                                                            </Border>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                                                        Spacing="1">
                                                                <TextBlock Text="{Binding RoleName}" FontSize="12.5"
                                                                           FontWeight="Bold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding LevelText}" FontSize="11"
                                                                           Foreground="{DynamicResource SemiColorText3}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                      </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 空/未登录状态 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    IsVisible="{Binding !HasData}">
            <TextBlock Text="{loc:Localize Key=Tower.AutoLoadHint}" FontSize="15"
                       Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
