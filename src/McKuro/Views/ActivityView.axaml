<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:controls="using:McKuro.Controls"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:loc="clr-namespace:McKuro.Services"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">
    <Grid RowDefinitions="Auto,*" Margin="20,16,20,16">
        <!-- 标题 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ic:FluentIcon Icon="CalendarStar" IconVariant="Regular" IconSize="Size24" VerticalAlignment="Center" />
                    <TextBlock Text="{loc:Localize Key=Activity.Title}" FontSize="24" FontWeight="Bold" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:Localize Key=Common.Refresh}" Classes="primary" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" IsVisible="{Binding HasData}">
                <!-- ② 换取活动(卡池)倒计时 -->
                <Border CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="TicketDiagonal" IconVariant="Regular" IconSize="Size16" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Localize Key=Activity.PoolTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{loc:Localize Key=Activity.PoolDesc}" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding PoolActivities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ActivityPoolItem">
                                    <Border CornerRadius="10" Background="{DynamicResource SemiColorBg3}"
                                            Padding="12" Margin="0,0,10,10" MinWidth="240">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <Border Width="44" Height="44" CornerRadius="6" ClipToBounds="True"
                                                        Background="{DynamicResource SemiColorBg2}">
                                                    <controls:AsyncImage ImageUrl="{Binding ImageUrl}"
                                                                         Width="44" Height="44" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                    <Border CornerRadius="4" Padding="5,1"
                                                            Background="{DynamicResource SemiColorPrimary}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Category}" FontSize="10"
                                                                   Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- 4★ 角色/武器换取信息(首张 5★ 大图之后的内容小图,对齐 Haiyu 显示 4 张) -->
                                            <StackPanel Spacing="4" IsVisible="{Binding HasFourStar}">
                                                <TextBlock Text="{loc:Localize Key=Activity.FourStar}" FontSize="10"
                                                           Foreground="{DynamicResource SemiColorText3}" />
                                                <ItemsControl ItemsSource="{Binding FourStarImages}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                                                                    Background="{DynamicResource SemiColorBg2}">
                                                                <controls:AsyncImage ImageUrl="{Binding}"
                                                                                     Width="40" Height="40" Stretch="UniformToFill" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding CountdownText}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource SemiColorPrimary}" />
                                                <TextBlock Text="{Binding TimeRangeText}" FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText3}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ① 版本活动甘特图 -->
                <Border CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="18">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:FluentIcon Icon="CalendarStar" IconVariant="Regular" IconSize="Size16" VerticalAlignment="Center" />
                                <TextBlock Text="{loc:Localize Key=Activity.VersionTitle}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{loc:Localize Key=Activity.VersionDesc}" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText3}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 甘特图主体:左列(logo+名称+时间)固定可见;仅时间轴横向滚动
                             (内容宽=完整历史 56px/天 最低 720;默认滚动到"今天"居中,左侧完成段被视口部分隐藏,拖动回看) -->
                        <Grid ColumnDefinitions="230,*" ColumnSpacing="14">
                                <!-- 左列:活动 logo + 名称 + 时间 -->
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{loc:Localize Key=Activity.GanttLabel}" FontSize="11" Foreground="{DynamicResource SemiColorText3}"
                                               Height="18" />
                                    <ItemsControl ItemsSource="{Binding VersionActivities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ActivityGanttItem">
                                                <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="8" Width="230" Height="40">
                                                    <Border Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                                                            Background="{DynamicResource SemiColorBg3}">
                                                        <controls:AsyncImage ImageUrl="{Binding ImageUrl}"
                                                                             Width="40" Height="40" Stretch="UniformToFill" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                        <Panel>
                                                            <!-- 临期(≤3天)且未忽略:标题标红并附带剩余时间 -->
                                                            <TextBlock Text="{Binding AlertTitle}" FontSize="13" FontWeight="Bold"
                                                                       Foreground="#e33737"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding IsAlertVisible}" />
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding !IsAlertVisible}" />
                                                        </Panel>
                                                        <TextBlock Text="{Binding TimeRangeText}" FontSize="11"
                                                                   Foreground="{DynamicResource SemiColorText3}" />
                                                    </StackPanel>
                                                    <!-- 忽略/取消忽略:仅临期活动显示 -->
                                                    <Button Grid.Column="2" VerticalAlignment="Center" Padding="6,2" FontSize="10"
                                                            Content="{Binding IgnoreButtonText}"
                                                            IsVisible="{Binding IsExpiringSoon}"
                                                            Command="{Binding $parent[ItemsControl].((vm:ActivityViewModel)DataContext).ToggleActivityIgnoreCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 右列:时间轴 + 甘特条(宽度=完整历史内容宽,星号列随其等比缩放;表头高 28 与左列对齐)。
                                     横向滚动只作用于本列,左列活动图片/名称始终可见 -->
                                <ScrollViewer x:Name="GanttScroll" Grid.Column="1"
                                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <Grid Width="{Binding GanttTimelineWidth}" HorizontalAlignment="Left">
                                    <Grid.RowDefinitions>
                                        <!-- 表头 34 与左列"活动"标签(18 + 间距 16)对齐 -->
                                        <RowDefinition Height="34" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- 时间轴日期刻度:约 8 个均匀分布的 MM-dd(纯像素定位)。
                                         居中视图下起止日期标签必然落在视口外,均匀刻度保证任何滚动位置
                                         都有日期参照;刻度贴表头下缘、今天芯片贴表头上缘,二者互不遮挡 -->
                                    <ItemsControl Grid.Row="0" ItemsSource="{Binding GanttTicks}"
                                                  Width="{Binding GanttTimelineWidth}" Height="34"
                                                  HorizontalAlignment="Left">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.Styles>
                                            <!-- Canvas 面板下由容器承载像素定位(Canvas.Left/Top;容器以自身左上角
                                                 为锚点,故显式钉住 Left/Top 对齐,不随默认拉伸改动) -->
                                            <Style Selector="ContentPresenter" x:DataType="vm:GanttTick">
                                                <Setter Property="Canvas.Left" Value="{Binding LeftPx}" />
                                                <Setter Property="Canvas.Top" Value="20" />
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="VerticalAlignment" Value="Top" />
                                            </Style>
                                        </ItemsControl.Styles>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:GanttTick">
                                                <TextBlock Text="{Binding Text}" FontSize="10"
                                                           Foreground="{DynamicResource SemiColorText3}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- 甘特条区:每行一个 Canvas,甘特条按像素坐标定位(56px/天) -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding VersionActivities}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="8" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ActivityGanttItem">
                                                <Canvas Height="40">
                                                    <!-- 时间轴背景轨 -->
                                                    <Border Canvas.Left="0" Canvas.Top="5" Width="{Binding RowWidthPx}"
                                                            Height="30" CornerRadius="6" Opacity="0.5"
                                                            Background="{DynamicResource SemiColorBg3}" />
                                                    <!-- 已完成段(实色,右缘=今日线) -->
                                                    <Border Canvas.Left="{Binding BarLeftPx}" Canvas.Top="5"
                                                            Width="{Binding DoneWidthPx}" Height="30"
                                                            Background="{Binding BarBrush}" CornerRadius="6,0,0,6"
                                                            IsVisible="{Binding HasDone}" />
                                                    <!-- 未进行段(半透明) -->
                                                    <Border Canvas.Left="{Binding RemainLeftPx}" Canvas.Top="5"
                                                            Width="{Binding RemainWidthPx}" Height="30"
                                                            Background="{Binding BarBrush}" Opacity="0.35"
                                                            CornerRadius="0,6,6,0" IsVisible="{Binding HasRemain}" />
                                                    <!-- 进度百分比文本(条右端内侧) -->
                                                    <TextBlock Canvas.Left="{Binding LabelLeftPx}" Canvas.Top="11"
                                                               Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                                               FontSize="9" Foreground="White" FontWeight="Bold" />
                                                </Canvas>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <!-- 今日线(与条内完成/未进行分界同一像素公式,严格对齐):仅贯穿甘特条区
                                         (表头段由今天芯片接续,视觉上仍是连续一条) -->
                                    <Canvas Grid.Row="1" IsHitTestVisible="False">
                                        <Border Canvas.Left="{Binding TodayLineX}" Width="2"
                                                Height="{Binding RowsHeightPx}" Background="#e33737" />
                                    </Canvas>
                                    <!-- 今天芯片(表头内跨今日线居中;左缘先锚在今日线上,视图在布局提交后
                                         按芯片实际宽度折算成居中位置 —— 芯片宽度随语言/字体变化,不可写死) -->
                                    <Canvas Grid.Row="0" IsHitTestVisible="False">
                                        <Border x:Name="TodayChip" Canvas.Left="{Binding TodayLineX}" Canvas.Top="2"
                                                Background="#e33737" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="{Binding GanttTodayLabel}" FontSize="9" Foreground="White"
                                                       FontWeight="Bold" />
                                        </Border>
                                    </Canvas>
                                </Grid>
                                </ScrollViewer>
                            </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 空状态 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    IsVisible="{Binding !HasData}">
            <TextBlock Text="{loc:Localize Key=Activity.Loading}" FontSize="16"
                       Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
