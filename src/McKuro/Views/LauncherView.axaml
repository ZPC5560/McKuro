<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:game="using:McKuro.Core.Models.Game"
             xmlns:controls="using:McKuro.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.LauncherView"
             x:DataType="vm:LauncherViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 全屏背景图(官方启动器封面,铺满无留白,内容叠加其上) -->
        <Grid Grid.RowSpan="3">
            <Border Background="{DynamicResource SemiColorBg1}" />
            <controls:AsyncImage ImageUrl="{Binding BackgroundImageUrl}"
                                 Stretch="UniformToFill"
                                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.5" />
        </Grid>
        <!-- 顶部进度条:仅下载/安装/修复时显示(检查更新不显示,避免默认出现) -->
        <ProgressBar IsIndeterminate="{Binding IsDownloading}"
                     IsVisible="{Binding IsDownloading}"
                     Height="3"
                     Background="Transparent" />

        <Grid Grid.Row="1" Margin="16,10,16,0">
            <!-- 左下角控制区:渠道检测(服务器下拉) + 轮播图 -->
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,8"
                        Spacing="8">
                <!-- 渠道检测:服务器下拉 -->
                <ComboBox ItemsSource="{Binding Servers}"
                          SelectedIndex="{Binding SelectedServerIndex, Mode=TwoWay}"
                          Padding="10,4"
                          CornerRadius="14"
                          MinWidth="110"
                          HorizontalAlignment="Right" />
                <!-- 左下角轮播图(Haiyu v2 风格,可隐藏) -->
                <Border Width="340" Height="190"
                        CornerRadius="12"
                        Background="{DynamicResource SemiColorBg2}"
                        ClipToBounds="True"
                        IsVisible="{Binding IsSlideShowVisible}">
                <Grid>
                    <Carousel x:Name="SlideCarousel"
                              ItemsSource="{Binding Slideshows}">
                        <Carousel.ItemTemplate>
                            <DataTemplate x:DataType="game:SlideshowItem">
                                <controls:AsyncImage ImageUrl="{Binding Url}"
                                                     Stretch="UniformToFill"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </Carousel.ItemTemplate>
                    </Carousel>

                    <!-- 轮播指示点 -->
                    <ItemsControl ItemsSource="{Binding Slideshows}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="game:SlideshowItem">
                                <Ellipse Width="7" Height="7" Fill="White" Opacity="0.5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 隐藏轮播按钮 -->
                    <Button Content="✕" Padding="6,2" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,6,6,0"
                            Background="#66000000" BorderThickness="0" Foreground="White"
                            Command="{Binding ToggleSlideShowCommand}" />
                </Grid>
                </Border>
            </StackPanel>

            <!-- 主内容区 -->
            <Grid ColumnDefinitions="*">
                <!-- 左侧:启动器操作区 -->
                <Grid RowDefinitions="*,Auto">
                    <!-- 主内容卡片(垂直排列:标题/版本/操作/下载) -->
                    <StackPanel Grid.Row="0" Spacing="10">
                    <!-- 启动器标题 毛玻璃卡片 -->
                    <Border CornerRadius="12"
                            ClipToBounds="True"
                            VerticalAlignment="Top">
                        <Grid>
                            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.55" CornerRadius="12" />
                            <Border Background="{DynamicResource SemiColorBg2}"
                                    Opacity="0.4"
                                    Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Width="48" Height="48" CornerRadius="10"
                                                Background="{DynamicResource SemiColorBg3}">
                                            <TextBlock Text="🌊" FontSize="24"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="鸣潮 · 启动器" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding InstallStateText}" FontSize="12"
                                                       Foreground="White" />
                                        </StackPanel>
                                    </Grid>
                                                                    </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 游戏版本 + 操作 毛玻璃卡片 -->
                    <Border
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,10,0,0"
                            ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.6" CornerRadius="12" />
                            <Border Background="{DynamicResource SemiColorBg2}"
                                    Opacity="0.45"
                                    Padding="16">
                                <StackPanel Spacing="12">
                                    <!-- 游戏版本(服务端/本地/状态) -->
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="服务端版本" FontSize="11" Foreground="White" />
                                            <TextBlock Text="{Binding ServerVersionText}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource SemiColorPrimary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="本地版本" FontSize="11" Foreground="White" />
                                            <TextBlock Text="{Binding GameVersionText}" FontSize="14" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="状态" FontSize="11" Foreground="White" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="13"
                                                       Foreground="{DynamicResource SemiColorPrimary}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- 操作 毛玻璃卡片(打开目录/修复游戏,悬浮背景) -->
                    <Border
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,10,0,0"
                            ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.6" CornerRadius="12" />
                            <Border Background="{DynamicResource SemiColorBg2}"
                                    Opacity="0.45"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="操作" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="📂 打开目录" Command="{Binding OpenGameFolderCommand}" />
                                        <Button Content="🔧 修复游戏" Command="{Binding RepairGameCommand}"
                                                IsEnabled="{Binding IsInstalled}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 下载进度面板 -->
                    <Border
                            CornerRadius="12"
                            Background="{DynamicResource SemiColorBg2}"
                            Padding="16"
                            Margin="0,10,0,0"
                            IsVisible="{Binding IsDownloading}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="下载进度" FontSize="14" FontWeight="SemiBold" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="{Binding PauseResumeText}"
                                            Command="{Binding TogglePauseDownloadCommand}"
                                            Padding="10,2" FontSize="11" />
                                    <TextBlock Text="{Binding SpeedText}" FontSize="12"
                                               Foreground="{DynamicResource SemiColorPrimary}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="10"
                                         CornerRadius="5" />
                            <TextBlock Text="{Binding ProgressText}" FontSize="12"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock Text="{Binding CurrentFileText}" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText3}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    </StackPanel>

                    <!-- 底部:预下载环 + 启动大按钮 -->
                    <Grid Grid.Row="1" ColumnDefinitions="120,*" ColumnSpacing="18" Margin="0,12,0,20">
                        <!-- 预下载环(仅存在预下载时显示,避免默认显示 0%) -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding HasPredownload}">
                            <Grid Width="96" Height="96">
                                <Border Width="96" Height="96" CornerRadius="48"
                                        BorderThickness="6"
                                        BorderBrush="{DynamicResource SemiColorBg3}">
                                    <Border Width="96" Height="96" CornerRadius="48"
                                            BorderThickness="6"
                                            BorderBrush="{DynamicResource SemiColorPrimary}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                                            <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                                       FontSize="16" FontWeight="Bold"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="预下载" FontSize="10"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </Grid>
                            <Button Content="预下载" Classes="primary"
                                    Command="{Binding PreDownloadCommand}"
                                    IsEnabled="{Binding HasUpdate}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- 启动/安装大按钮 (窄 20%,右下角,文字居中) -->
                        <StackPanel Grid.Column="1" Width="220" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                            <Button Height="56"
                                    Padding="0"
                                    Classes="primary"
                                    FontSize="15"
                                    Command="{Binding InstallCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    IsVisible="{Binding !IsInstalled}"
                                    HorizontalAlignment="Stretch">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="下载安装" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ServerVersionText}" FontSize="11" Opacity="0.85" />
                                </StackPanel>
                            </Button>
                            <Button Height="56"
                                    Padding="0"
                                    FontSize="15"
                                    Background="#52C41A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="8"
                                    Command="{Binding LaunchCommand}"
                                    IsEnabled="{Binding IsInstalled}"
                                    HorizontalAlignment="Stretch">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="#66BB6A" />
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="#66BB6A" />
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="启动游戏" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ServerVersionText}" FontSize="11" Opacity="0.85" />
                                </StackPanel>
                            </Button>
                            <Button Content="安装更新"
                                    Command="{Binding InstallCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    IsVisible="{Binding ShowInstallUpdate}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Grid>


            </Grid>
        </Grid>
    </Grid>
</UserControl>
