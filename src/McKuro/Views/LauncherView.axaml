<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:game="using:McKuro.Core.Models.Game"
             xmlns:controls="using:McKuro.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.LauncherView"
             x:DataType="vm:LauncherViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 全屏背景图(官方启动器封面,铺满无留白,内容叠加其上) -->
        <Grid Grid.RowSpan="3">
            <Border Background="{DynamicResource SemiColorBg1}" />
            <controls:VideoBackgroundControl VideoUrl="{Binding BackgroundVideoUrl}"
                                              FallbackImageUrl="{Binding BackgroundImageUrl}"
                                              IsVideoEnabled="{Binding VideoEnabled}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
            <Border Background="#000000" Opacity="0.18" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,16,0" Padding="12,7" CornerRadius="14"
                Background="{DynamicResource McKuroGlassFillStrong}"
                BorderBrush="{DynamicResource McKuroGlassStroke}" BorderThickness="1"
                IsVisible="{Binding !NativeGameManagementSupported}">
            <TextBlock Text="{Binding PlatformGameNotice}" FontSize="12"
                       Foreground="{DynamicResource McKuroTextOnWallpaper}"
                       TextWrapping="Wrap" MaxWidth="360" />
        </Border>

        <!-- 内容区:上半区(标题/操作) + 下半区(轮播图/进度卡/启动按钮 三者底对齐) -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,Auto" Margin="16,10,16,0">
            <!-- 上半区:启动器主内容(标题/版本/操作) -->
            <Grid Grid.Row="0" ColumnDefinitions="*,3*" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <!-- 启动器标题 毛玻璃卡片 -->
                    <Border CornerRadius="12" ClipToBounds="True" VerticalAlignment="Top">
                        <Grid>
                            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.75" CornerRadius="12" />
                            <Border Background="{DynamicResource SemiColorBg2}"
                                    Opacity="0.6"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Width="40" Height="40" CornerRadius="8"
                                                Background="{DynamicResource SemiColorBg3}">
                                            <ic:FluentIcon Icon="Play" IconVariant="Regular" IconSize="Size20"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="鸣潮 · 启动器" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                            <TextBlock Text="{Binding InstallStateText}" FontSize="11"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- 版本信息(本地/服务端) -->
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="服务端版本" FontSize="9"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBlock Text="{Binding ServerVersionText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="本地版本" FontSize="9"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBlock Text="{Binding GameVersionText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- 操作 毛玻璃卡片(打开目录/修复游戏,紧凑布局) -->
                    <Border CornerRadius="10" Padding="10" Margin="0,6,0,0" ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.75" CornerRadius="10" />
                            <Border Background="{DynamicResource SemiColorBg2}"
                                    Opacity="0.6"
                                    Padding="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="操作" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Command="{Binding OpenGameFolderCommand}"
                                                Background="{DynamicResource McKuroGlassFillStrong}"
                                                BorderBrush="{DynamicResource McKuroGlassStroke}" BorderThickness="1"
                                                CornerRadius="14" Padding="12,5"
                                                Foreground="{DynamicResource McKuroTextOnWallpaper}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ic:FluentIcon Icon="Folder" IconVariant="Regular" IconSize="Size16"
                                                               Foreground="{DynamicResource McKuroTextOnWallpaper}" VerticalAlignment="Center" />
                                                <TextBlock Text="打开目录" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RepairGameCommand}"
                                                IsEnabled="{Binding IsInstalled}"
                                                IsVisible="{Binding ShowRepairButton}"
                                                Background="{DynamicResource McKuroGlassFillStrong}"
                                                BorderBrush="{DynamicResource McKuroGlassStroke}" BorderThickness="1"
                                                CornerRadius="14" Padding="12,5"
                                                Foreground="{DynamicResource McKuroTextOnWallpaper}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <ic:FluentIcon Icon="Wrench" IconVariant="Regular" IconSize="Size16"
                                                               Foreground="{DynamicResource McKuroTextOnWallpaper}" VerticalAlignment="Center" />
                                                <TextBlock Text="修复游戏" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 下半区(高200): 轮播图 | 进度卡片 | 启动按钮 (三者底部对齐) -->
            <Grid Grid.Row="1" ColumnDefinitions="340,*,220" ColumnSpacing="16" Margin="0,8,0,0">
                <!-- 轮播图(信息横幅) -->
                <Border Grid.Column="0"
                        Width="340" Height="190"
                        VerticalAlignment="Bottom" Margin="0,0,0,8"
                        CornerRadius="12"
                        Background="{DynamicResource SemiColorBg2}"
                        ClipToBounds="True"
                        IsVisible="{Binding IsSlideShowVisible}">
                    <Grid>
                        <Carousel x:Name="SlideCarousel" ItemsSource="{Binding Slideshows}">
                            <Carousel.ItemTemplate>
                                <DataTemplate x:DataType="game:SlideshowItem">
                                    <controls:AsyncImage ImageUrl="{Binding Url}"
                                                         Stretch="UniformToFill"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch" />
                                </DataTemplate>
                            </Carousel.ItemTemplate>
                        </Carousel>
                        <ItemsControl ItemsSource="{Binding Slideshows}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="game:SlideshowItem">
                                    <Ellipse Width="7" Height="7" Fill="White" Opacity="0.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Padding="6,2" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,6,6,0"
                                Background="#66000000" BorderThickness="0"
                                Foreground="{DynamicResource McKuroTextOnWallpaper}"
                                Command="{Binding ToggleSlideShowCommand}">
                            <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16"
                                           Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 进度卡片(半透明,高度190,内容压缩适配不溢出) -->
                <Border Grid.Column="1"
                        Width="430" Height="190"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,8"
                        CornerRadius="12" ClipToBounds="True"
                        IsVisible="{Binding ShowDownloadCard}">
                    <Grid>
                        <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.7" CornerRadius="12" />
                        <Border Background="{DynamicResource SemiColorBg2}"
                                Opacity="0.65"
                                Padding="12"
                                CornerRadius="12">
                            <StackPanel Spacing="5" VerticalAlignment="Center">
                                <!-- 速度/进度文本(在曲线上方) -->
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding ProgressText}" FontSize="12"
                                                   Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                        <TextBlock Text="{Binding SpeedText}" FontSize="12"
                                                   Foreground="{DynamicResource SemiColorPrimary}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="{Binding RemainingTimeText}" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   IsVisible="{Binding RemainingTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding DownloadSizeText}" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   IsVisible="{Binding DownloadSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{Binding DiskSpaceText}" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorText3}"
                                                   IsVisible="{Binding DiskSpaceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- 速度波动曲线 -->
                                <controls:SpeedTrendChart Height="38"
                                                          Values="{Binding DownloadSpeedHistory}" />
                                <!-- 预下载环(显示%) + 合并下载按钮,横排 -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Margin="0,2,0,0">
                                    <Grid Width="56" Height="56" Grid.Column="0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <controls:RingProgress Width="56" Height="56"
                                                               Value="{Binding ProgressPercent}"
                                                               Thickness="5"
                                                               ShowText="True"
                                                               FontSize="13" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <Button Content="{Binding PreDownloadButtonText}"
                                                Classes="primary"
                                                Command="{Binding TogglePreDownloadCommand}"
                                                IsEnabled="{Binding PreDownloadButtonEnabled}"
                                                HorizontalAlignment="Left"
                                                Padding="14,6" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 启动/安装大按钮(从底部排列,底边与轮播图/进度卡对齐,无背景) -->
                <StackPanel Grid.Column="2" Width="220"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="10"
                            Margin="0,0,0,8">
                    <Button Height="56"
                            Padding="0"
                            FontSize="15"
                            Background="#8C000000"
                            BorderBrush="#4DFFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            Foreground="#F2F6FF"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            IsVisible="{Binding ShowInstallButton}"
                            HorizontalAlignment="Stretch">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="下载安装" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ServerVersionText}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button Height="56"
                            Padding="0"
                            FontSize="15"
                            Background="#52C41A"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="18"
                            Command="{Binding LaunchCommand}"
                            IsEnabled="{Binding IsInstalled}"
                            IsVisible="{Binding ShowLaunchButton}"
                            HorizontalAlignment="Stretch">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#66BB6A" />
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#66BB6A" />
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="启动游戏" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ServerVersionText}" FontSize="11" />
                        </StackPanel>
                    </Button>
                    <Button Height="56"
                            Padding="0"
                            FontSize="15"
                            Background="#E89B2D"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="18"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            IsVisible="{Binding ShowInstallUpdate}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="安装更新" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ServerVersionText}" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
