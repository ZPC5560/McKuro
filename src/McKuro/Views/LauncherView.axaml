<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:game="using:McKuro.Core.Models.Game"
             xmlns:controls="using:McKuro.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:loc="clr-namespace:McKuro.Services"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.LauncherView"
             x:DataType="vm:LauncherViewModel">
    <UserControl.Styles>
        <!-- (原「操作区胶囊按钮 opBtn」样式已删除:它唯一的用户——游戏功能菜单按键——
             已并入全站共享的 Button.mcChrome(定义在 App.axaml),留着就是死代码) -->
        <!-- 横幅关闭按钮:常态弱深色底,悬停加深(修正悬停/常态观感颠倒) -->
        <Style Selector="Button.bannerClose">
            <Setter Property="Background" Value="#33000000" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.bannerClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#99000000" />
        </Style>
        <!-- 资源等级切换按键直接用全站共享的 Button.mcChrome(定义在 App.axaml),
             与主页昵称旁的账号切换按键外观完全一致;这里只补自己的圆角与内边距。 -->
        <!-- 资源等级卡片:与账号切换弹窗的列表项同一套语言 ——
             常态用主题令牌半透明底(不再硬编码白色 #33FFFFFF,亮色主题下会发灰脏),
             当前等级(选中项)用主题强调色淡染底 + 强调色描边,一眼可辨。 -->
        <Style Selector="Button.levelCard">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource McKuroSwitchChipStroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Button.levelCard:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipFillHover}" />
        </Style>
        <Style Selector="Button.levelCard.selected">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipSelectedFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource McKuroSwitchChipSelectedStroke}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>
        <!-- 选中项悬停时保持强调色底,避免"一悬停就把选中高亮冲掉" -->
        <Style Selector="Button.levelCard.selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipSelectedFill}" />
        </Style>
        <Style Selector="Button.levelCard.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource McKuroSwitchChipSelectedText}" />
        </Style>
        <Style Selector="Button.levelCard.selected TextBlock.dim">
            <Setter Property="Foreground" Value="{DynamicResource McKuroSwitchChipSelectedText}" />
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style Selector="Button.levelCard.selected ic|FluentIcon">
            <Setter Property="Foreground" Value="{DynamicResource McKuroSwitchChipSelectedText}" />
        </Style>
        <Style Selector="Button.levelCard:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.levelCard:disabled">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <!-- 左侧菜单项:整行可点,悬停提亮 -->
        <Style Selector="Button.menuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="{DynamicResource McKuroTextOnWallpaper}" />
        </Style>
        <!-- 菜单项悬停:用与资源等级卡片同族的令牌(原硬编码 #33FFFFFF 在亮色主题下会糊成一块白) -->
        <Style Selector="Button.menuItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource McKuroSwitchChipFillHover}" />
        </Style>
        <Style Selector="Button.menuItem:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 全屏背景图(官方启动器封面,铺满无留白,内容叠加其上) -->
        <Grid Grid.RowSpan="3">
            <Border Background="{DynamicResource SemiColorBg1}" />
            <controls:VideoBackgroundControl VideoUrl="{Binding BackgroundVideoUrl}"
                                              FallbackImageUrl="{Binding BackgroundImageUrl}"
                                              IsVideoEnabled="{Binding VideoEnabled}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
            <!-- 版本标语(诗句):与 Haiyu 相同的 background.Slogan 资源(透明画布,诗句画在右缘)。
                 仅用位置变换把图片左移,让诗句本体(非整幅画布)落到画面水平居中、靠上;
                 不修改 AsyncImage 控件。RenderTransform 只影响渲染不占布局。
                 注:必须用嵌套 TranslateTransform 形式(与 MainWindow 一致),Avalonia 对字符串
                 translate(...) 形式在编译绑定下会运行时解析失败导致本视图空白。
                 自定义动态壁纸生效时隐藏:官方诗句美术与自定义视频不匹配。 -->
            <controls:AsyncImage ImageUrl="{Binding VersionLogoUrl}"
                                 IsVisible="{Binding !IsCustomVideoActive}"
                                 Stretch="Uniform"
                                 MaxWidth="840"
                                 MaxHeight="470"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Top"
                                 Margin="0,56,0,0"
                                 IsHitTestVisible="False">
                <controls:AsyncImage.RenderTransform>
                    <TranslateTransform X="-297" Y="0" />
                </controls:AsyncImage.RenderTransform>
            </controls:AsyncImage>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" ZIndex="2" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,16,0" Padding="12,7" CornerRadius="14"
                Background="{DynamicResource McKuroGlassFillStrong}"
                BorderBrush="{DynamicResource McKuroGlassStroke}" BorderThickness="1"
                IsVisible="{Binding !NativeGameManagementSupported}">
            <TextBlock Text="{Binding PlatformGameNotice}" FontSize="12"
                       Foreground="{DynamicResource McKuroTextOnWallpaper}"
                       TextWrapping="Wrap" MaxWidth="360" />
        </Border>

        <!-- 内容区:上半区(标题/操作) + 下半区(轮播图/进度卡/启动按钮 三者底对齐) + 底部状态栏
             状态栏是本页所有操作(检查更新/修复/检查重复文件/创建快捷方式/强制退出)的唯一反馈出口。
             【回归背景 2026-10】用户反馈"启动页手动点击时没有进度和对应的反馈":
             本页此前<b>完全没有绑定 StatusText</b>(其它 6 个页面都有),于是 ViewModel 里
             写了 20 多处状态文案全落进没人显示的地方 —— 表现为点了菜单项毫无反应。 -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="*,Auto,Auto" Margin="16,10,16,0">
            <!-- 上半区:启动器主内容(标题/版本/操作) -->
            <Grid Grid.Row="0" ColumnDefinitions="*,3*" VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <!-- 启动器标题卡 毛玻璃:版本一致(无更新)时整体不显示,与版本信息一致 -->
                    <Border CornerRadius="12" ClipToBounds="True" VerticalAlignment="Top"
                            IsVisible="{Binding HasUpdate}">
                        <Grid>
                            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.75" CornerRadius="12" />
                            <Border Background="{DynamicResource SemiColorBg2}"
                                    Opacity="0.6"
                                    Padding="12">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Border Width="40" Height="40" CornerRadius="8"
                                                Background="{DynamicResource SemiColorBg3}">
                                            <ic:FluentIcon Icon="Play" IconVariant="Regular" IconSize="Size20"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{loc:Localize Key=Launcher.Title}" FontSize="14" FontWeight="Bold"
                                                       Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                            <TextBlock Text="{Binding InstallStateText}" FontSize="11"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- 版本信息(本地/服务端):整卡由 HasUpdate 控制显隐 -->
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{loc:Localize Key=Launcher.ServerVersion}" FontSize="9"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBlock Text="{Binding ServerVersionText}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="{loc:Localize Key=Launcher.LocalVersion}" FontSize="9"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBlock Text="{Binding GameVersionText}" FontSize="12" FontWeight="Bold"
                                                       Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- 操作区:左侧菜单按钮(点击展开功能项,对齐官方启动器左上角菜单)。
                         原「打开目录/修复游戏」已并入菜单,保持界面简洁。
                         外层 Grid 无列定义 → 菜单面板是纯覆盖层:它再宽也不会改变按钮的布局尺寸
                         (曾与按钮同处一个 Auto 列,面板 MinWidth 把该列撑宽导致按钮拉伸、图标位移)。 -->
                    <Grid Margin="0,6,0,0">
                        <!-- 游戏功能菜单按键:与资源分级、账号切换同一套(mcChrome 透明底 + 半透明图标)。
                             它同样<b>直接压在视频上、没有自己的面板底</b>,所以前景用不随主题翻转的
                             McKuroTextOnVideo + 反向投影阴影,否则亮色主题下暗场景里会看不见。 -->
                        <Button HorizontalAlignment="Left" VerticalAlignment="Top"
                                Classes="mcChrome" Padding="10,8"
                                Foreground="{DynamicResource McKuroTextOnVideo}"
                                AutomationProperties.Name="{loc:Localize Key=Launcher.Menu.Open}"
                                Command="{Binding ToggleGameMenuCommand}">
                            <ic:FluentIcon Icon="LineHorizontal3" IconVariant="Regular" IconSize="Size20"
                                           controls:VideoTextChrome.Shadow="True"
                                           Foreground="{DynamicResource McKuroTextOnVideo}" />
                        </Button>

                        <!-- 功能菜单(点击左侧按钮展开;绝对覆盖在按钮下方,不参与按钮测量)。
                             材质用全站共享的 Border.mcPanel —— 与右下角资源等级展开面板、
                             账号/版本弹窗同一份面色描边,不再各自重述背景导致观感不一致。 -->
                        <Border ZIndex="20"
                                Classes="mcPanel"
                                Margin="0,52,0,0"
                                MinWidth="176"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsVisible="{Binding IsGameMenuOpen}">
                            <StackPanel Spacing="2" Margin="6">
                                <Button Classes="menuItem" Command="{Binding CheckGameUpdateCommand}">
                                    <TextBlock Text="{loc:Localize Key=Launcher.Menu.CheckUpdate}" FontSize="12" />
                                </Button>
                                <!-- 外部渠道(官方启动器)更新后版本记录滞后:手动指定本地实际版本 -->
                                <Button Classes="menuItem" Command="{Binding SelectVersionCommand}"
                                        IsEnabled="{Binding IsInstalled}">
                                    <TextBlock Text="{loc:Localize Key=Launcher.Menu.SelectVersion}" FontSize="12" />
                                </Button>
                                <Button Classes="menuItem" Command="{Binding RepairGameFromMenuCommand}"
                                        IsEnabled="{Binding IsInstalled}">
                                    <TextBlock Text="{loc:Localize Key=Launcher.Menu.Repair}" FontSize="12" />
                                </Button>
                                <!-- 手动体积自检:每次断连/修复都会留下备份与半成品,给用户一个随时可用的入口 -->
                                <Button Classes="menuItem" Command="{Binding CheckResidueFromMenuCommand}"
                                        IsEnabled="{Binding IsInstalled}">
                                    <TextBlock Text="{loc:Localize Key=Launcher.Menu.CheckResidue}" FontSize="12" />
                                </Button>
                                <Button Classes="menuItem" Command="{Binding CreateDesktopShortcutCommand}">
                                    <TextBlock Text="{loc:Localize Key=Launcher.Menu.CreateShortcut}" FontSize="12" />
                                </Button>
                                <Button Classes="menuItem" Command="{Binding ForceExitGameCommand}"
                                        IsEnabled="{Binding CanForceExitGame}">
                                    <TextBlock Text="{loc:Localize Key=Launcher.Menu.ForceExit}" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 下半区(高200): 轮播图 | 进度卡片 | 启动按钮 (三者底部对齐)
                 列宽口径:进度卡是信息密集区,固定拿设计宽度 430(内部排版就按这个宽度调的);
                 启动按钮列固定 220;轮播图纯装饰,吃掉剩下的"弹性"宽度并封顶 340。
                 窗口缩到 MinWidth(900)时内容区约 788,430+220+间距 32 = 682,轮播图压到 ~106 ——
                 仍不重叠。旧版三列全写死(340 / * / 220)且卡片再写死 430,900 宽下卡片必然
                 顶进「下载安装」按钮。 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,430,220" ColumnSpacing="16" Margin="0,8,0,0">
                <!-- 轮播图(信息横幅) -->
                <Border Grid.Column="0"
                        MaxWidth="340" Height="190"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom" Margin="0,0,0,8"
                        CornerRadius="12"
                        Background="{DynamicResource SemiColorBg2}"
                        ClipToBounds="True"
                        IsVisible="{Binding IsSlideShowVisible}">
                    <Grid>
                        <!-- 双击轮播图 → 在默认浏览器打开该图的 jumpUrl(官方 slideshow 的跳转链接) -->
                        <Carousel x:Name="SlideCarousel" ItemsSource="{Binding Slideshows}"
                                  DoubleTapped="OnSlideshowDoubleTapped">
                            <Carousel.ItemTemplate>
                                <DataTemplate x:DataType="game:SlideshowItem">
                                    <controls:AsyncImage ImageUrl="{Binding Url}"
                                                         Stretch="UniformToFill"
                                                         HorizontalAlignment="Stretch"
                                                         VerticalAlignment="Stretch" />
                                </DataTemplate>
                            </Carousel.ItemTemplate>
                        </Carousel>
                        <ItemsControl ItemsSource="{Binding Slideshows}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Bottom"
                                      Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="game:SlideshowItem">
                                    <Ellipse Width="7" Height="7" Fill="White" Opacity="0.5" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 轮播图关闭按键:同样直接压在图片/视频上,与资源分级按键同一套处理
                             (恒定浅色 + 反向投影阴影),否则亮色主题下暗场景里会看不见。
                             阴影只加在图标上:加在 Button 上会把它那块自带深色底一并推进离屏渲染,白费一层。 -->
                        <Button Classes="bannerClose" Padding="6,2" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,6,6,0"
                                Foreground="{DynamicResource McKuroTextOnVideo}"
                                AutomationProperties.Name="{loc:Localize Key=Launcher.SlideClose}"
                                Command="{Binding ToggleSlideShowCommand}">
                            <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16"
                                           controls:VideoTextChrome.Shadow="True"
                                           Foreground="{DynamicResource McKuroTextOnVideo}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- 进度卡片(半透明,高度 190)。布局按"信息优先级"重排(用户反馈 2026-10:
                     网速与进度都不明显):
                     ① 第一眼 —— 大号速度数值 + 小号单位(左) / 峰值(右)
                     ② 第二眼 —— 抖动的速度曲线(自适应放大,能看出掉速)
                     ③ 第三眼 —— 环形进度(百分比在环内) + 已下载/剩余/磁盘 + 暂停
                     旧实现把速度、时间、磁盘、进度全塞成 11~12px 的同一行小字,视觉上没有主次。

                     宽度:所在列固定 430(设计宽度);内部各元素按这个宽度排,不要再改小 ——
                     窗口窄时由左边轮播图列让位(见上方列定义注释)。 -->
                <Border Grid.Column="1"
                        MaxWidth="430" Height="190"
                        HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="0,0,0,8"
                        CornerRadius="12" ClipToBounds="True"
                        IsVisible="{Binding ShowDownloadCard}">
                    <Grid>
                        <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.7" CornerRadius="12" />
                        <Border Background="{DynamicResource SemiColorBg2}"
                                Opacity="0.65"
                                Padding="14,11"
                                CornerRadius="12">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                                <!-- ① 网速:大字数值 + 小号单位,右侧峰值 -->
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                                VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding SpeedValueText}"
                                                   FontSize="26" FontWeight="Bold"
                                                   Foreground="{DynamicResource McKuroSpeedValue}"
                                                   VerticalAlignment="Bottom"
                                                   FontFeatures="tnum" />
                                        <TextBlock Text="{Binding SpeedUnitText}" FontSize="11"
                                                   Foreground="{DynamicResource McKuroSpeedUnit}"
                                                   VerticalAlignment="Bottom" Margin="0,0,0,4" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PeakSpeedText}"
                                               FontSize="10.5"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               VerticalAlignment="Bottom" Margin="0,0,0,5" />
                                </Grid>

                                <!-- ② 速度波动曲线(自适应放大;占满中间剩余高度,才能真正看出"在抖") -->
                                <controls:SpeedTrendChart Grid.Row="1"
                                                          MinHeight="40"
                                                          MaxPoints="120"
                                                          VerticalAlignment="Stretch"
                                                          Values="{Binding DownloadSpeedHistory}"
                                                          LineBrush="{DynamicResource McKuroChartLine}"
                                                          FillBrush="{DynamicResource McKuroChartFill}"
                                                          BaselineBrush="{DynamicResource McKuroChartBaseline}" />

                                <!-- ③ 底部行:环形进度(百分比在环内) + 文件/剩余/磁盘 + 暂停按钮。
                                     进度坚持用环形(用户要求):环内百分比避免"另起一行小字"的拥挤,
                                     环本身放大到 58 并加粗环宽,一眼能看出下了多少。 -->
                                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <controls:RingProgress Grid.Column="0"
                                                           Width="58" Height="58"
                                                           VerticalAlignment="Center"
                                                           Value="{Binding ProgressPercent}"
                                                           IsIndeterminate="{Binding ShowIndeterminateProgress}"
                                                           Thickness="6"
                                                           ShowText="True"
                                                           FontSize="15"
                                                           TrackBrush="{DynamicResource McKuroProgressTrack}"
                                                           ForegroundBrush="{DynamicResource McKuroProgressFill}"
                                                           TextBrush="{DynamicResource McKuroSpeedValue}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding ProgressText}" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding RemainingTimeText}" FontSize="10.5"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       IsVisible="{Binding RemainingTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="{Binding DownloadSizeText}" FontSize="10.5"
                                                       Foreground="{DynamicResource SemiColorText2}"
                                                       IsVisible="{Binding DownloadSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            <TextBlock Text="{Binding DiskSpaceText}" FontSize="10.5"
                                                       Foreground="{DynamicResource SemiColorText3}"
                                                       IsVisible="{Binding DiskSpaceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- 仅在真正可暂停的下载阶段显示暂停/继续;
                                         校验/差分合成/解压/资源安装阶段暂停是空操作,整体隐藏。 -->
                                    <Button Grid.Column="2"
                                            Content="{Binding PreDownloadButtonText}"
                                            Classes="primary"
                                            Command="{Binding TogglePreDownloadCommand}"
                                            IsEnabled="{Binding PreDownloadButtonEnabled}"
                                            IsVisible="{Binding PreDownloadButtonVisible}"
                                            VerticalAlignment="Center"
                                            Padding="12,6" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 资源等级卡片列表(对齐官方启动器:默认收起,点「高清 ▾」小按钮后向上弹出)
                     与进度卡互斥(下载/切换期间整体隐藏),避免同列两块面板叠在一起。
                     材质用全站共享的 Border.mcPanel,与左上角功能菜单/账号/版本弹窗同一份面色描边。 -->
                <Border Grid.Column="2"
                        Classes="mcPanel"
                        MinWidth="240"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,0,128"
                        IsVisible="{Binding ShowResourceLevelPanel}">
                    <StackPanel Spacing="8" MaxWidth="300" Margin="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{loc:Localize Key=Launcher.LevelPanelTitle}" FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                            <TextBlock Text="{loc:Localize Key=Launcher.LevelPanelHint}" FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <!-- 官方「画质怎么选」说明页:链接由 index.json 根节点提供,
                                 该渠道没给就整行隐藏(不要自己编一个链接)。 -->
                            <Button Classes="mcLink"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding OpenResourceLevelHintCommand}"
                                    IsVisible="{Binding HasResourceLevelHint}">
                                <TextBlock Text="{loc:Localize Key=Launcher.LevelHintLink}" FontSize="10"
                                           TextDecorations="Underline"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                            </Button>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ResourceLevelItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResourceLevelItem">
                                    <!-- Classes.selected 绑当前等级:与账号切换弹窗同一套强调色选中表达 -->
                                    <Button Classes="levelCard"
                                            Classes.selected="{Binding IsCurrent}"
                                            Command="{Binding $parent[ItemsControl].((vm:LauncherViewModel)DataContext).SelectResourceLevelCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding $parent[ItemsControl].((vm:LauncherViewModel)DataContext).ResourceLevelEnabled}"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch"
                                            Margin="0,3">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                                <TextBlock Classes="dim" Text="{Binding SizeText}" FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}" />
                                                <!-- 「需下载」只算本地缺失的包:已装好的共享包不重复计入。
                                                     已安装的那一档没有这行(没有"还需下载"这回事)。 -->
                                                <TextBlock Classes="dim" Text="{Binding DownloadText}" FontSize="11"
                                                           Foreground="{DynamicResource SemiColorPrimary}"
                                                           IsVisible="{Binding ShowDownloadNeed}" />
                                                <StackPanel Orientation="Horizontal" Spacing="4"
                                                            IsVisible="{Binding ShowInstalledBadge}">
                                                    <ic:FluentIcon Icon="CheckmarkCircle" IconVariant="Filled"
                                                                   IconSize="Size12"
                                                                   Foreground="{DynamicResource SemiColorPrimary}"
                                                                   VerticalAlignment="Center" />
                                                    <TextBlock Classes="dim"
                                                               Text="{loc:Localize Key=Launcher.LevelInstalledBadge}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource SemiColorText2}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </StackPanel>
                                            <ic:FluentIcon Grid.Column="1" Icon="Checkmark" IconVariant="Regular"
                                                           IconSize="Size16"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource McKuroTextOnWallpaper}"
                                                           IsVisible="{Binding IsCurrent}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 画质包管理面板(回收磁盘):与等级面板同一套材质/定位,两者互斥展开。
                     只列出已安装的包,共享包(common)标注不可删原因;可回收空间在标题处汇总。 -->
                <Border Grid.Column="2"
                        Classes="mcPanel"
                        MinWidth="240"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,0,128"
                        IsVisible="{Binding ShowPackManager}">
                    <StackPanel Spacing="8" MaxWidth="320" Margin="14">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{loc:Localize Key=Launcher.PackPanelTitle}" FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                <TextBlock Grid.Column="1" Text="{Binding ReclaimableText}" FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText2}" />
                            </Grid>
                            <TextBlock Text="{loc:Localize Key=Launcher.PackPanelHint}" FontSize="10"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ResourcePackItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResourcePackItem">
                                    <!-- 用本视图自己的玻璃材质(LauncherView 没有 SettingsView 的 Border.row 样式,
                                         写 Classes="row" 在这里是空操作、不会上任何底色)。 -->
                                    <Border Margin="0,2" Padding="10,8" CornerRadius="10"
                                            Background="{DynamicResource McKuroGlassFillStrong}"
                                            BorderBrush="{DynamicResource McKuroGlassStroke}"
                                            BorderThickness="1">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource McKuroTextOnWallpaper}" />
                                                    <Border Background="{DynamicResource SemiColorFill0}"
                                                            CornerRadius="4" Padding="4,1"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TagText}" FontSize="9"
                                                                   Foreground="{DynamicResource SemiColorText2}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Classes="dim" Text="{Binding SizeText}" FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}" />
                                                <!-- 不可删原因:如实展示(共享包 / 当前唯一等级) -->
                                                <TextBlock Text="{Binding BlockReason}" FontSize="10"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource McKuroWarning}"
                                                           IsVisible="{Binding ShowBlockReason}" />
                                            </StackPanel>
                                            <Button Grid.Column="1"
                                                    Classes="mcChrome"
                                                    VerticalAlignment="Center"
                                                    Padding="8,3"
                                                    Content="{loc:Localize Key=Launcher.PackDeleteConfirmOk}"
                                                    FontSize="11"
                                                    Command="{Binding $parent[ItemsControl].((vm:LauncherViewModel)DataContext).DeleteResourcePackCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanDelete}"
                                                    IsVisible="{Binding CanDelete}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 没有可删的包时给一句说明,而不是留个空面板 -->
                        <TextBlock Text="{loc:Localize Key=Launcher.PackNoDeletable}" FontSize="10"
                                   Foreground="{DynamicResource SemiColorText2}"
                                   IsVisible="{Binding !HasDeletablePacks}" />
                    </StackPanel>
                </Border>

                <!-- 启动/安装大按钮(从底部排列,底边与轮播图/进度卡对齐,无背景) -->
                <StackPanel Grid.Column="2" Width="220"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Spacing="10"
                            Margin="0,0,0,8">
                    <!-- 画质包管理入口:仅在存在可删除的包时显示,避免给一个点了没用的按钮 -->
                    <Button Classes="mcChrome"
                            HorizontalAlignment="Right"
                            CornerRadius="14" Padding="10,4"
                            Foreground="{DynamicResource McKuroTextOnVideo}"
                            AutomationProperties.Name="{loc:Localize Key=Launcher.PackManage}"
                            Command="{Binding TogglePackManagerCommand}"
                            IsVisible="{Binding HasDeletablePacks}">
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    controls:VideoTextChrome.Shadow="True">
                            <ic:FluentIcon Icon="Delete" IconVariant="Regular" IconSize="Size12"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource McKuroTextOnVideo}" />
                            <TextBlock Text="{loc:Localize Key=Launcher.PackManage}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource McKuroTextOnVideo}" />
                        </StackPanel>
                    </Button>
                    <!-- 资源等级小按钮(对齐官方启动器:仅显示当前等级,点击才展开卡片列表)
                         箭头随展开状态翻转,让"这是可展开的选择器"一眼可读。
                         前景用 McKuroTextOnVideo(不随主题翻转)+ 容器级反向投影阴影:
                         这个按键直接压在官方视频上,亮色主题下若跟主题取深色字,
                         遇到暗场景就彻底看不见(2026-10 用户反馈)。 -->
                    <Button Classes="mcChrome"
                            HorizontalAlignment="Right"
                            CornerRadius="14" Padding="10,4"
                            Foreground="{DynamicResource McKuroTextOnVideo}"
                            AutomationProperties.Name="{loc:Localize Key=Launcher.LevelPanelTitle}"
                            Command="{Binding ToggleResourceLevelPickerCommand}"
                            IsVisible="{Binding ShowResourceLevelPill}">
                        <StackPanel Orientation="Horizontal" Spacing="6"
                                    controls:VideoTextChrome.Shadow="True">
                            <TextBlock Text="{Binding CurrentResourceLevelText}" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource McKuroTextOnVideo}" />
                            <Panel Width="12" Height="12" VerticalAlignment="Center">
                                <ic:FluentIcon Icon="ChevronUp" IconVariant="Regular" IconSize="Size12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding ShowResourceLevelPanel}"
                                               Foreground="{DynamicResource McKuroTextOnVideo}" />
                                <ic:FluentIcon Icon="ChevronDown" IconVariant="Regular" IconSize="Size12"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !ShowResourceLevelPanel}"
                                               Foreground="{DynamicResource McKuroTextOnVideo}" />
                            </Panel>
                        </StackPanel>
                    </Button>
                    <Button Height="56"
                            Padding="0"
                            FontSize="15"
                            Background="#8C000000"
                            BorderBrush="#4DFFFFFF"
                            BorderThickness="1"
                            CornerRadius="18"
                            Foreground="#F2F6FF"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            IsVisible="{Binding ShowInstallButton}"
                            HorizontalAlignment="Stretch">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Localize Key=Launcher.DownloadInstall}" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <!-- 版本号基线对齐:小字号与大字号在 StackPanel 里按行盒居中时视觉上会偏高,
                                 显式居中 + 轻微下移补偿字体度量差(对齐官方按钮内版本号观感)。 -->
                            <TextBlock Text="{Binding ServerVersionText}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Height="56"
                            Padding="0"
                            FontSize="15"
                            Background="#52C41A"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="18"
                            Command="{Binding LaunchCommand}"
                            IsEnabled="{Binding LaunchButtonEnabled}"
                            IsVisible="{Binding ShowLaunchButton}"
                            HorizontalAlignment="Stretch">
                        <Button.Styles>
                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                <Setter Property="Background" Value="#66BB6A" />
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="#66BB6A" />
                                <Setter Property="Opacity" Value="1" />
                            </Style>
                        </Button.Styles>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LaunchButtonText}" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerVersionText}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Height="56"
                            Padding="0"
                            FontSize="15"
                            Background="#E89B2D"
                            Foreground="White"
                            BorderThickness="0"
                            CornerRadius="18"
                            Command="{Binding InstallCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            IsVisible="{Binding ShowInstallUpdate}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Localize Key=Launcher.InstallUpdate}" FontSize="15" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ServerVersionText}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,2,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 底部状态栏:本页所有操作的统一反馈出口(仅在有文案时占位,不挤压内容)。
                 用 McKuroTextOnVideo + 反向投影:它压在全屏视频/壁纸上,不跟主题翻转,
                 亮色主题下遇到暗场景也不会变成"黑字压黑底"(与启动页其它裸压在视频上的元素同一套处理)。
                 忙碌时在文案左侧转一个不确定态细环,让"正在做事"与"什么都没发生"可区分。 -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8"
                  Margin="2,8,2,10" VerticalAlignment="Center"
                  IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <controls:RingProgress Grid.Column="0"
                                       Width="14" Height="14"
                                       VerticalAlignment="Center"
                                       Thickness="2"
                                       ShowText="False"
                                       IsIndeterminate="True"
                                       IsVisible="{Binding IsBusy}"
                                       ForegroundBrush="{DynamicResource McKuroTextOnVideo}"
                                       TrackBrush="{DynamicResource McKuroChartBaseline}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MaxLines="2"
                           VerticalAlignment="Center"
                           controls:VideoTextChrome.Shadow="True"
                           Foreground="{DynamicResource McKuroTextOnVideo}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
