<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:game="using:McKuro.Core.Models.Game"
             xmlns:controls="using:McKuro.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:ic="using:FluentIcons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="McKuro.Views.LauncherView"
             x:DataType="vm:LauncherViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 全屏背景图(官方启动器封面,铺满无留白,内容叠加其上) -->
        <Grid Grid.RowSpan="3">
            <Border Background="{DynamicResource SemiColorBg1}" />
            <controls:VideoBackgroundControl VideoUrl="{Binding BackgroundVideoUrl}"
                                              FallbackImageUrl="{Binding BackgroundImageUrl}"
                                              IsVideoEnabled="{Binding VideoEnabled}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.5" />
        </Grid>
        <!-- 顶部进度条:仅下载/安装/修复时显示(检查更新不显示,避免默认出现) -->
        <ProgressBar IsIndeterminate="{Binding IsDownloading}"
                     IsVisible="{Binding IsDownloading}"
                     Height="3"
                     Background="Transparent" />

        <Border Grid.Row="1" Grid.Column="0" ZIndex="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,10,16,0" Padding="12,7" CornerRadius="14"
                Background="{DynamicResource McKuroGlassFillStrong}"
                BorderBrush="{DynamicResource McKuroGlassStroke}" BorderThickness="1"
                IsVisible="{Binding !NativeGameManagementSupported}">
            <TextBlock Text="{Binding PlatformGameNotice}" FontSize="12"
                       Foreground="{DynamicResource McKuroTextOnWallpaper}"
                       TextWrapping="Wrap" MaxWidth="360" />
        </Border>

        <Grid Grid.Row="1" Grid.Column="0" ZIndex="1" Margin="16,10,16,0">
            <!-- 左下角轮播图(Haiyu v2 风格,可隐藏) -->
            <Border HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Width="340" Height="190"
                    Margin="0,0,0,8"
                    CornerRadius="12"
                    Background="{DynamicResource SemiColorBg2}"
                    ClipToBounds="True"
                    IsVisible="{Binding IsSlideShowVisible}">
                <Grid>
                    <Carousel x:Name="SlideCarousel"
                              ItemsSource="{Binding Slideshows}">
                        <Carousel.ItemTemplate>
                            <DataTemplate x:DataType="game:SlideshowItem">
                                <controls:AsyncImage ImageUrl="{Binding Url}"
                                                     Stretch="UniformToFill"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </Carousel.ItemTemplate>
                    </Carousel>

                    <!-- 轮播指示点 -->
                    <ItemsControl ItemsSource="{Binding Slideshows}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="game:SlideshowItem">
                                <Ellipse Width="7" Height="7" Fill="White" Opacity="0.5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 隐藏轮播按钮 -->
                    <Button Padding="6,2" FontSize="11"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,6,6,0"
                            Background="#66000000" BorderThickness="0" Foreground="White"
                            Command="{Binding ToggleSlideShowCommand}">
                        <ic:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size16" Foreground="White" />
                    </Button>
                </Grid>
                </Border>

            <!-- 主内容区 -->
            <Grid ColumnDefinitions="*">
                <!-- 左侧:启动器操作区 -->
                <Grid RowDefinitions="*,Auto">
                    <!-- 主内容卡片(垂直排列:标题/版本/操作/下载) -->
                    <StackPanel Grid.Row="0" Spacing="10">
                    <!-- 启动器标题 毛玻璃卡片 -->
                    <Border CornerRadius="12"
                            ClipToBounds="True"
                            VerticalAlignment="Top">
                        <Grid>
                            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.75" CornerRadius="12" />
                            <Border Background="{DynamicResource SemiColorBg2}"
                                    Opacity="0.6"
                                    Padding="18">
                                <StackPanel Spacing="12">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Width="48" Height="48" CornerRadius="10"
                                                Background="{DynamicResource SemiColorBg3}">
                                            <ic:FluentIcon Icon="Play" IconVariant="Regular" IconSize="Size24"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="White" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="鸣潮 · 启动器" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding InstallStateText}" FontSize="12"
                                                       Foreground="White" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- 版本信息(本地/服务端,对齐 Haiyu 标题区) -->
                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="16">
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="服务端版本" FontSize="10" Foreground="#BFFFFFFF" />
                                            <TextBlock Text="{Binding ServerVersionText}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="1">
                                            <TextBlock Text="本地版本" FontSize="10" Foreground="#BFFFFFFF" />
                                            <TextBlock Text="{Binding GameVersionText}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="White" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <!-- 操作 毛玻璃卡片(打开目录/修复游戏,悬浮背景) -->
                    <Border
                            CornerRadius="12"
                            Padding="16"
                            Margin="0,10,0,0"
                            ClipToBounds="True">
                        <Grid>
                            <Border Background="{DynamicResource SemiColorBg1}" Opacity="0.75" CornerRadius="12" />
                            <Border Background="{DynamicResource SemiColorBg2}"
                                    Opacity="0.6"
                                    Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="操作" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Command="{Binding OpenGameFolderCommand}"
                                                Background="#8C000000" BorderBrush="#4DFFFFFF" BorderThickness="1"
                                                CornerRadius="18" Padding="18,7" Foreground="White">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ic:FluentIcon Icon="Folder" IconVariant="Regular" IconSize="Size16"
                                                               Foreground="White" VerticalAlignment="Center" />
                                                <TextBlock Text="打开目录" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding RepairGameCommand}"
                                                IsEnabled="{Binding IsInstalled}"
                                                IsVisible="{Binding NativeGameManagementSupported}"
                                                Background="#8C000000" BorderBrush="#4DFFFFFF" BorderThickness="1"
                                                CornerRadius="18" Padding="18,7" Foreground="White">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ic:FluentIcon Icon="Wrench" IconVariant="Regular" IconSize="Size16"
                                                               Foreground="White" VerticalAlignment="Center" />
                                                <TextBlock Text="修复游戏" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    </StackPanel>

                    <!-- 底部:速度曲线+文本 | 预下载环+合并按钮 | 启动/安装大按钮(三列) -->
                    <Grid Grid.Row="1" ColumnDefinitions="3*,1.6*,220" ColumnSpacing="24" Margin="0,16,0,20"
                          VerticalAlignment="Bottom">
                        <!-- 左:速度波动曲线(窄,文本显示在曲线上方) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="6"
                                    HorizontalAlignment="Left">
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding ProgressText}" FontSize="12"
                                               Foreground="{DynamicResource SemiColorText2}" />
                                    <TextBlock Text="{Binding SpeedText}" FontSize="12"
                                               Foreground="{DynamicResource SemiColorPrimary}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding RemainingTimeText}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               IsVisible="{Binding RemainingTimeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    <TextBlock Text="{Binding DownloadSizeText}" FontSize="11"
                                               Foreground="{DynamicResource SemiColorText2}"
                                               IsVisible="{Binding DownloadSizeText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </StackPanel>
                            <controls:SpeedTrendChart Height="56"
                                                      Values="{Binding DownloadSpeedHistory}" />
                        </StackPanel>

                        <!-- 中:预下载进度环(显示%) + 合并下载按钮 -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding IsPreDownloadActive}">
                            <controls:RingProgress Width="72" Height="72"
                                                   Value="{Binding ProgressPercent}"
                                                   Thickness="6"
                                                   ShowText="True"
                                                   FontSize="15" />
                            <Button Content="{Binding PreDownloadButtonText}"
                                    Classes="primary"
                                    Command="{Binding TogglePreDownloadCommand}"
                                    IsEnabled="{Binding PreDownloadButtonEnabled}"
                                    HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding DiskSpaceText}" FontSize="10"
                                       Foreground="{DynamicResource SemiColorText3}"
                                       HorizontalAlignment="Center"
                                       IsVisible="{Binding DiskSpaceText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <!-- 右:启动/安装大按钮 -->
                        <StackPanel Grid.Column="2" Width="220" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="10">
                            <Button Height="56"
                                    Padding="0"
                                    FontSize="15"
                                    Background="#8C000000"
                                    BorderBrush="#4DFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    Foreground="#F2F6FF"
                                    Command="{Binding InstallCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    IsVisible="{Binding ShowInstallButton}"
                                    HorizontalAlignment="Stretch">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="下载安装" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ServerVersionText}" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Height="56"
                                    Padding="0"
                                    FontSize="15"
                                    Background="#52C41A"
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="18"
                                    Command="{Binding LaunchCommand}"
                                    IsEnabled="{Binding IsInstalled}"
                                    IsVisible="{Binding NativeGameManagementSupported}"
                                    HorizontalAlignment="Stretch">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                        <Setter Property="Background" Value="#66BB6A" />
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                    <Style Selector="Button:pointerover">
                                        <Setter Property="Background" Value="#66BB6A" />
                                        <Setter Property="Opacity" Value="1" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="启动游戏" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ServerVersionText}" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <Button Content="安装更新"
                                    Command="{Binding InstallCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    IsVisible="{Binding ShowInstallUpdate}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Grid>


            </Grid>
        </Grid>
    </Grid>
</UserControl>
