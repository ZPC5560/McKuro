<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:McKuro.ViewModels"
             xmlns:controls="using:McKuro.Controls"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="700"
             x:Class="McKuro.Views.WikiView"
             x:DataType="vm:WikiViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <!-- 标题 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,8">
            <StackPanel Spacing="2">
                <TextBlock Text="📖 图鉴" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding StatusText}" FontSize="12"
                           Foreground="{DynamicResource SemiColorText2}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="刷新" Command="{Binding LoadCommand}"
                        IsEnabled="{Binding !IsBusy}" />
            </StackPanel>
        </Grid>

        <!-- Banner 轮播 -->
        <Grid Grid.Row="1" Margin="20,0,20,8">
            <Border CornerRadius="14" ClipToBounds="True" Height="180">
                <Carousel ItemsSource="{Binding Banners}">
                    <Carousel.ItemTemplate>
                        <DataTemplate x:DataType="vm:WikiBannerItem">
                            <controls:AsyncImage ImageUrl="{Binding Url}" Stretch="UniformToFill" />
                        </DataTemplate>
                    </Carousel.ItemTemplate>
                </Carousel>
            </Border>
        </Grid>

        <!-- 快捷入口 (参考 WutheringWavesTool 图鉴菜单) -->
        <ItemsControl Grid.Row="2" Margin="20,0,20,8" ItemsSource="{Binding WebLinks}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WikiLinkItem">
                    <Button Margin="0,0,8,6" Padding="12,6" CornerRadius="8"
                            Background="{DynamicResource SemiColorBg2}"
                            Command="{Binding $parent[ItemsControl].((vm:WikiViewModel)DataContext).OpenLinkCommand}"
                            CommandParameter="{Binding Url}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Description}" FontSize="10"
                                           Foreground="{DynamicResource SemiColorText3}" />
                            </StackPanel>
                            <TextBlock Text="↗" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 提示 -->
        <TextBlock Grid.Row="3" Margin="20,0,20,8" FontSize="12"
                   Foreground="{DynamicResource SemiColorText3}"
                   Text="图鉴数据来自库街区 wiki 接口(点击条目可跳转网页查看详情)" />


        <!-- 内容:公告 + 图片卡片同一行 -->
        <Grid Grid.Row="4" ColumnDefinitions="2*,1*" ColumnSpacing="14" Margin="20,0,20,16">
            <!-- 左:公告 -->
            <Border CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="📢 公告" FontSize="16" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Announcements}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WikiTextItem">
                                <Border CornerRadius="8" Background="{DynamicResource SemiColorBg3}"
                                        Padding="10,8" Margin="0,0,0,8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Sub}" FontSize="11"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 右:图片卡片(图鉴 Banner 图) -->
            <Border Grid.Column="1" CornerRadius="12" Background="{DynamicResource SemiColorBg2}" Padding="14">
                <StackPanel Spacing="10">
                    <TextBlock Text="🖼 图片" FontSize="16" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Banners}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WikiBannerItem">
                                <Border CornerRadius="8" Height="90" ClipToBounds="True"
                                        Background="{DynamicResource SemiColorBg3}">
                                    <controls:AsyncImage ImageUrl="{Binding Url}" Stretch="UniformToFill" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>