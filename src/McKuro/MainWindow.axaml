<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:McKuro.ViewModels"
        xmlns:views="using:McKuro.Views"
        xmlns:ic="using:FluentIcons.Avalonia"
        xmlns:controls="using:McKuro.Controls"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="McKuro.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="656"
        MinWidth="900" MinHeight="509"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Title="McKuro · 鸣潮启动器"
        Icon="avares://McKuro/Assets/app.ico"
        Background="Transparent">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LauncherViewModel}">
            <views:LauncherView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GachaViewModel}">
            <views:GachaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolesViewModel}">
            <views:RolesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SignViewModel}">
            <views:SignView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <views:ActivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WikiViewModel}">
            <views:WikiView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RedemptionCodeViewModel}">
            <views:RedemptionCodeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayTimeViewModel}">
            <views:PlayTimeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TowerViewModel}">
            <views:TowerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountViewModel}">
            <views:AccountView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- 系统材质模式(Mica/Acrylic/毛玻璃,由 SystemMaterialService 在代码侧加 os-material 类):
             纯色底座让位给 OS 原生背景,背景涂抹层改为弱化染色以露出系统材质。
             若实际透明级别未启用(如远程桌面),代码侧会移除 os-material 类回退到现有纯色设计。 -->
        <Style Selector="Grid.os-material #BackdropBase" x:SetterTargetType="Border">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.os-material #BackdropTint" x:SetterTargetType="Border">
            <Setter Property="Background" Value="{DynamicResource McKuroBackdropTintMaterial}" />
        </Style>
        <Style Selector="Grid.os-material #NavRail" x:SetterTargetType="Border">
            <Setter Property="Background" Value="{DynamicResource McKuroNavFillMaterial}" />
        </Style>
        <Style Selector="Grid.os-material #ContentHost" x:SetterTargetType="Border">
            <Setter Property="Background" Value="{DynamicResource McKuroContentTintMaterial}" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootShell">
        <!-- 全局背景:纯色底座 + 氛围遮罩 + 双彩色光斑。
             光斑是液态玻璃的"折射源":玻璃后面的色彩梯度让边缘高光/暗影可见(纯平底色上看不出玻璃)。 -->
        <Grid IsHitTestVisible="False">
            <Border x:Name="BackdropBase" Background="{DynamicResource McKuroBackdropBase}" />
            <!-- 主题 accent 光斑:左上蓝 / 右下青,低饱和大半径,亮暗主题通用 -->
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2E5A8DEE" Offset="0" />
                        <GradientStop Color="#0014B8C6" Offset="0.42" />
                        <GradientStop Color="#2614B8C6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="BackdropTint" Background="{DynamicResource McKuroBackdropTint}" />
        </Grid>

        <Grid ColumnDefinitions="76,*">
        <!-- 左侧 76px 图标导航:液态玻璃质感。
             分层光学:半透明底色 → 顶部光斑 → 左缘受光亮线+右缘背光暗线(折射立体感) → 内容。
             选中态:Apple 液态玻璃滑动胶囊——玻璃胶囊在导航项间平滑滑动(代码后置驱动)。 -->
        <Border x:Name="NavRail" Grid.Column="0"
                Background="{DynamicResource McKuroNavFill}"
                BorderThickness="0">
            <Panel x:Name="NavGlassPanel">
                <!-- 顶部径向光斑:光源从上方射入玻璃的漫反射 -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush GradientOrigin="0.5,0.0" Center="0.5,0.0"
                                             RadiusX="1.1" RadiusY="0.55">
                            <GradientStop Color="#3DFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <!-- 玻璃边缘折射:左缘亮(受光)/右缘暗(背光)+ 底部渐隐收光 -->
                <Border IsHitTestVisible="False"
                        BorderThickness="1,0,1,0"
                        BorderBrush="#59FFFFFF">
                    <Border IsHitTestVisible="False" Margin="0,0,1,0"
                            BorderThickness="0,0,1,0"
                            BorderBrush="#1A000000" />
                </Border>
                <!-- 滑动选中胶囊:位置由代码后置按选中项实时驱动,BackEase 缓动模拟液态玻璃惯性 -->
                <Border x:Name="NavPill" IsHitTestVisible="False"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Width="64" Height="48" CornerRadius="13"
                        RenderTransformOrigin="50%, 50%"
                        Background="{DynamicResource McKuroGlassFillStrong}"
                        BorderBrush="#4A8CA3C4" BorderThickness="1"
                        BoxShadow="inset 0 1 0 0 #66FFFFFF, 0 3 12 0 #2E0A1428"
                        IsVisible="False">
                    <Border.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform />
                            <ScaleTransform />
                        </TransformGroup>
                    </Border.RenderTransform>
                </Border>
                <DockPanel>
                    <!-- 顶部账号头像:登录后显示库街区真实头像(磁盘缓存),未登录/无缓存显示守岸人默认图标 -->
                    <Border DockPanel.Dock="Top"
                            Width="46" Height="46"
                            CornerRadius="23"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,14"
                            Background="#33FFFFFF"
                            BorderThickness="1"
                            BorderBrush="#809AA8BC"
                            BoxShadow="0 2 10 0 #2E0A1428">
                        <Panel>
                            <Border Width="42" Height="42" CornerRadius="21" ClipToBounds="True"
                                    BorderThickness="1" BorderBrush="#40FFFFFF"
                                    IsVisible="{Binding !HasNavAvatar}">
                                <Image Source="avares://McKuro/Assets/shorekeeper_icon.png"
                                       Stretch="UniformToFill" />
                            </Border>
                            <Border Width="42" Height="42" CornerRadius="21" ClipToBounds="True"
                                    BorderThickness="1" BorderBrush="#40FFFFFF"
                                    IsVisible="{Binding HasNavAvatar}">
                                <controls:AsyncImage ImageUrl="{Binding NavAvatarPath}" Stretch="UniformToFill" />
                            </Border>
                        </Panel>
                    </Border>
                    <!-- 导航项:自然高度堆叠 + 窗口居中(替代原 12 行强制均分);矮窗口走 Viewbox 缩放 -->
                    <ListBox x:Name="NavList"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="8,0"
                             Margin="0"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <!-- 12 行垂直均分:任意窗口高度下导航项铺满导航栏(不滚动不留白) -->
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="12" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:NavigationItem">
                                <!-- 外层 Viewbox:窗口高度不足时单项内容等比缩小(不裁切) -->
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <StackPanel Width="56" Spacing="3">
                                        <Viewbox Width="24" Height="24" Stretch="Uniform"
                                                 HorizontalAlignment="Center">
                                            <ic:FluentIcon Icon="{Binding Icon}"
                                                           IconVariant="Regular"
                                                           IconSize="Size24"
                                                           HorizontalAlignment="Center" />
                                        </Viewbox>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SemiColorText2}" />
                                    </StackPanel>
                                </Viewbox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <!-- 选中高亮由 NavPill 滑动胶囊承担:项背景保持透明,胶囊在项下层滑动 -->
                                <Setter Property="Padding" Value="0,2" />
                                <Setter Property="Margin" Value="4,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <!-- 图标统一着色:常态灰 / 选中主题蓝 -->
                            <Style Selector="ListBoxItem Viewbox ic|FluentIcon">
                                <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected Viewbox ic|FluentIcon">
                                <Setter Property="Foreground" Value="{DynamicResource McKuroAccent}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="#1EFFFFFF" />
                                <Setter Property="CornerRadius" Value="12" />
                            </Style>
                        </ListBox.Styles>
                    </ListBox>
                </DockPanel>
            </Panel>
        </Border>

        <!-- 内容区 -->
        <Border x:Name="ContentHost" Grid.Column="1" Background="{DynamicResource McKuroContentTint}">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
        </Grid>

        <!-- 应用更新询问弹窗(启动自动检查触发;「自动下载安装」开启时不弹,直接静默升级) -->
        <Panel Background="#66000000" IsVisible="{Binding AppUpdatePromptVisible}" ZIndex="200">
            <Border MaxWidth="420" Padding="28,24" CornerRadius="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{DynamicResource McKuroDialogFill}" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"
                    BoxShadow="0 16 64 0 #40000000">
                <StackPanel Spacing="10">
                    <TextBlock Text="发现新版本" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="{Binding SettingsPage.AppUpdateVersionText}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource SemiColorPrimary}" />
                    <TextBlock Text="{Binding SettingsPage.AppUpdateStatusText}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="跳过此版本" Command="{Binding UpdateSkipCommand}" />
                        <Button Content="稍后再说" Command="{Binding UpdateLaterCommand}" />
                        <Button Classes="primary" Content="立即更新" Command="{Binding UpdateNowCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>
    </Grid>
</Window>
