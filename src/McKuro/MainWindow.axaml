<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:McKuro.ViewModels"
        xmlns:views="using:McKuro.Views"
        xmlns:controls="using:McKuro.Controls"
        xmlns:ic="using:FluentIcons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="McKuro.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1150" Height="650"
        MinWidth="900" MinHeight="509"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Title="McKuro · 鸣潮启动器"
        Icon="avares://McKuro/Assets/app.ico"
        Background="Transparent">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LauncherViewModel}">
            <views:LauncherView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GachaViewModel}">
            <views:GachaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolesViewModel}">
            <views:RolesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SignViewModel}">
            <views:SignView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <views:ActivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WikiViewModel}">
            <views:WikiView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RedemptionCodeViewModel}">
            <views:RedemptionCodeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayTimeViewModel}">
            <views:PlayTimeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TowerViewModel}">
            <views:TowerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountViewModel}">
            <views:AccountView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Grid>
        <!-- 全局壁纸宿主：普通页面只使用这一处模糊，保证性能和跨平台表现一致。 -->
        <Grid IsHitTestVisible="False">
            <Border Background="{DynamicResource McKuroBackdropBase}" />
            <controls:AsyncImage ImageUrl="{Binding WallpaperPath}"
                                 IsVisible="{Binding HasWallpaper}"
                                 Stretch="UniformToFill"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />
            <controls:AsyncImage ImageUrl="{Binding WallpaperPath}"
                                 IsVisible="{Binding IsWallpaperBlurred}"
                                 Stretch="UniformToFill"
                                 Effect="{DynamicResource McKuroWallpaperBlurEffect}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch" />
            <Border Background="{DynamicResource McKuroBackdropTint}" />
        </Grid>

        <Grid ColumnDefinitions="60,*">
        <!-- 左侧 60px 图标导航 (参照 Java 项目:顶部圆形应用 Logo + 导航项图标) -->
        <Border Grid.Column="0"
                Background="{DynamicResource McKuroNavFill}"
                BorderBrush="{DynamicResource McKuroGlassStroke}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 顶部应用 Logo:守岸人,圆形裁剪 (参照 WutheringWavesTool MainView 的 icon + Circle clip) -->
                <Border DockPanel.Dock="Top"
                        Width="42" Height="42"
                        CornerRadius="21"
                        ClipToBounds="True"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource SemiColorPrimary}"
                        HorizontalAlignment="Center"
                        Margin="0,14,0,12">
                    <Image Source="avares://McKuro/Assets/shorekeeper_icon.png"
                           Stretch="UniformToFill" />
                </Border>
                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         Margin="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                            <StackPanel Width="60" Spacing="2">
                                <ic:FluentIcon Icon="{Binding Icon}"
                                               IconVariant="Regular"
                                               IconSize="Size20"
                                               HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource SemiColorText2}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <!-- 图标统一着色:常态灰 / 选中主题蓝(参照效果预览页) -->
                        <Style Selector="ListBoxItem ic|FluentIcon">
                            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected ic|FluentIcon">
                            <Setter Property="Foreground" Value="{DynamicResource McKuroAccent}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <!-- 选中:浅色主题蓝底(图标为蓝色时保持可见,对齐效果预览页) -->
                            <Setter Property="Background" Value="#2E5A8DEE" />
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource McKuroGlassFill}" />
                            <Setter Property="CornerRadius" Value="8" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <Border Grid.Column="1" Background="{DynamicResource McKuroContentTint}">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
        </Grid>
    </Grid>
</Window>
