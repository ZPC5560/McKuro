<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:McKuro.ViewModels"
        xmlns:views="using:McKuro.Views"
        xmlns:ic="using:FluentIcons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="McKuro.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="650"
        MinWidth="900" MinHeight="509"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        Title="McKuro · 鸣潮启动器"
        Icon="avares://McKuro/Assets/app.ico"
        Background="Transparent">

    <Window.DataTemplates>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LauncherViewModel}">
            <views:LauncherView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GachaViewModel}">
            <views:GachaView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RolesViewModel}">
            <views:RolesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SignViewModel}">
            <views:SignView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <views:ActivityView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WikiViewModel}">
            <views:WikiView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RedemptionCodeViewModel}">
            <views:RedemptionCodeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlayTimeViewModel}">
            <views:PlayTimeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TowerViewModel}">
            <views:TowerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountViewModel}">
            <views:AccountView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <!-- 系统材质模式(Mica/Acrylic/毛玻璃,由 SystemMaterialService 在代码侧加 os-material 类):
             纯色底座让位给 OS 原生背景,背景涂抹层改为弱化染色以露出系统材质。
             若实际透明级别未启用(如远程桌面),代码侧会移除 os-material 类回退到现有纯色设计。 -->
        <Style Selector="Grid.os-material #BackdropBase" x:SetterTargetType="Border">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.os-material #BackdropTint" x:SetterTargetType="Border">
            <Setter Property="Background" Value="{DynamicResource McKuroBackdropTintMaterial}" />
        </Style>
        <Style Selector="Grid.os-material #NavRail" x:SetterTargetType="Border">
            <Setter Property="Background" Value="{DynamicResource McKuroNavFillMaterial}" />
        </Style>
        <Style Selector="Grid.os-material #ContentHost" x:SetterTargetType="Border">
            <Setter Property="Background" Value="{DynamicResource McKuroContentTintMaterial}" />
        </Style>
    </Window.Styles>

    <Grid x:Name="RootShell">
        <!-- 全局背景：固定纯色底座 + 轻量氛围遮罩(壁纸与动态色板功能已移除)。 -->
        <Grid IsHitTestVisible="False">
            <Border x:Name="BackdropBase" Background="{DynamicResource McKuroBackdropBase}" />
            <Border x:Name="BackdropTint" Background="{DynamicResource McKuroBackdropTint}" />
        </Grid>

        <Grid ColumnDefinitions="76,*">
        <!-- 左侧 76px 图标导航 (参照 Java 项目:顶部圆形应用 Logo + 导航项图标) -->
        <Border x:Name="NavRail" Grid.Column="0"
                Background="{DynamicResource McKuroNavFill}"
                BorderBrush="{DynamicResource McKuroNavDivider}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- 顶部应用 Logo:守岸人,圆形裁剪 (参照 WutheringWavesTool MainView 的 icon + Circle clip) -->
                <Border DockPanel.Dock="Top"
                        Width="44" Height="44"
                        CornerRadius="22"
                        ClipToBounds="True"
                        BorderThickness="2"
                        BorderBrush="{DynamicResource SemiColorPrimary}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,10">
                    <Image Source="avares://McKuro/Assets/shorekeeper_icon.png"
                           Stretch="UniformToFill" />
                </Border>
                <!-- 导航项:Grid 12 行星行均分填满导航栏(任意窗口高度下 12 项均匀铺满,无留白/无滚动);
                     图标用 Viewbox 钳到 24×24,避免图标字体行高把项撑到 86px 高(否则默认高度下滚动) -->
                <ListBox x:Name="NavList"
                         ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         Padding="0"
                         Margin="0"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="12" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavigationItem">
                            <!-- 外层 Viewbox:窗口高度低于导航所需时整体等比缩小(不裁切);
                                 默认/更大高度时自然缩放,始终 12 项占满、无滚动 -->
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                     Margin="0,2">
                                <StackPanel Width="68" Spacing="5" VerticalAlignment="Center">
                                    <Viewbox Width="24" Height="24" Stretch="Uniform"
                                             HorizontalAlignment="Center">
                                        <ic:FluentIcon Icon="{Binding Icon}"
                                                       IconVariant="Regular"
                                                       IconSize="Size24"
                                                       HorizontalAlignment="Center" />
                                    </Viewbox>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource SemiColorText2}" />
                                </StackPanel>
                            </Viewbox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="0,6" />
                            <Setter Property="Margin" Value="4,2" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                        <!-- 图标统一着色:常态灰 / 选中主题蓝(参照效果预览页) -->
                        <Style Selector="ListBoxItem Viewbox ic|FluentIcon">
                            <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected Viewbox ic|FluentIcon">
                            <Setter Property="Foreground" Value="{DynamicResource McKuroAccent}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <!-- 选中:浅色主题蓝底(图标为蓝色时保持可见,对齐效果预览页) -->
                            <Setter Property="Background" Value="#2E5A8DEE" />
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource McKuroGlassFill}" />
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </ListBox.Styles>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 内容区 -->
        <Border x:Name="ContentHost" Grid.Column="1" Background="{DynamicResource McKuroContentTint}">
            <ContentControl Content="{Binding CurrentPage}" />
        </Border>
        </Grid>
    </Grid>
</Window>
