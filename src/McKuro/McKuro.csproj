<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows 使用无控制台桌面程序；macOS/Linux 使用普通桌面入口，避免把发布行为锁死在 WinExe。 -->
    <OutputType>Exe</OutputType>
    <OutputType Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')">app.manifest</ApplicationManifest>
    <!-- 应用图标(守岸人,多尺寸 ICO) -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- 内置 COM:默认关闭(NativeAOT 不支持);无 RID 的常规 JIT 构建开启,
         供应用内极验窗口反射调用官方 WebView2 包装器;AOT 发布(RID 构建)保持关闭并回退系统浏览器 -->
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <BuiltInComInteropSupport Condition="'$(RuntimeIdentifier)' == ''">true</BuiltInComInteropSupport>

    <!-- Native AOT 发布 (win-x64 需在 Windows 上发布;osx-arm64 可本地验证) -->
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <Version>1.3.7.3</Version>
    <!-- 注意:不要启用 InvariantGlobalization —— Semi 主题需要 zh-CN 文化支持 -->
    <!-- IL2104: 第三方 HanumanInstitute.LibMpv 自身产生的裁剪警告;本项目仅用其
         原生库加载/符号解析路径(无反射),该警告对本用法不适用 -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- 应用内极验窗口(Windows):只取原生 WebView2Loader.dll。ExcludeAssets=all 避免把
         CsWinRT 互操作程序集拉进编译闭包(与 Native AOT 不兼容);COM 接口在
         Controls/WebView2Control.cs 手写互操作(与 macOS WKWebView 控件同思路)。 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" ExcludeAssets="all" GeneratePathProperty="true" />
    <PackageReference Include="Semi.Avalonia" Version="12.1.0.1" />
    <!-- 统一单色线框图标:替代全部 emoji 图标。FluentIcons.Avalonia 2.1.337(依赖 Avalonia 12.0.0,net10.0,Native AOT 实测 0 警告)。 -->
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.337" />
    <!-- 背景视频封面(可选):libmpv 嵌入式渲染 API(MPV_RENDER_API_TYPE_SW)软件渲染到托管位图,
         比 LibVLC vmem 回调稳定(Native AOT 安全:LoadLibrary + GetProcAddress → Marshal.GetDelegateForFunctionPointer,无反射)。
         Windows native 库由 Endpne.LibMPV.Windows 内置(自动拷到输出 libmpv\win-x64\libmpv-2.dll);
         mac/Linux 用系统/Homebrew libmpv(resolver 内置搜索 + MpvApi.RootPath 兜底)。 -->
    <!-- Live2D Cubism 渲染控件:不再用 NuGet 包(0.1.1 的 dll 针对旧 Avalonia 11.x 编译,
         Avalonia 12 下 MissingFieldException 启动即崩),改用 vendored 源码工程按 Avalonia 12.1.1 重新编译,
         见 src/ThirdParty/Sparkle.Live2DView/。 -->
    <ProjectReference Include="..\ThirdParty\Sparkle.Live2DView\Sparkle.Live2DView.csproj" />
    <PackageReference Include="HanumanInstitute.LibMpv" Version="0.10.1" />
    <PackageReference Include="Endpne.LibMPV.Windows" Version="0.41.0" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')" />
  </ItemGroup>

  <!-- Endpne.LibMPV.Windows 自带 targets 的 glob 是 libmpv.*(只匹配 libmpv.lib),匹配不到实际文件名 libmpv-2.dll,
       因此 native 库不会自动拷到输出目录。这里手动把 libmpv-2.dll 拷到 libmpv\win-x64\(或 win-arm64\),
       与 libmpv Windows resolver 的搜索路径(MpvApi.RootPath)对齐。 -->
  <ItemGroup>
    <None Include="$(NuGetPackageRoot)endpne.libmpv.windows\0.41.0\build\x64\libmpv-2.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')" Link="libmpv\win-x64\libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)endpne.libmpv.windows\0.41.0\build\arm64\libmpv-2.dll" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" Link="libmpv\win-arm64\libmpv-2.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- WebView2Loader.dll(应用内极验窗口):按 RID 拷到输出根目录,DllImport("WebView2Loader") 解析 -->
  <ItemGroup>
    <None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-arm64\native\WebView2Loader.dll" Condition="'$(RuntimeIdentifier)' == 'win-arm64'" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" />
    <!-- 官方托管包装器(netcoreapp3.0,.NET 5+ 应用默认引用的构建):WebView2Control 反射加载它,
         以全托管链路创建环境/Controller。实测 .NET 10 上裸 P/Invoke 与 net462 内置 COM 互操作均无法
         拉起浏览器子进程,netcoreapp3.0 官方包装器正常。NativeAOT 下内置 COM 互操作被禁用,
         加载即抛异常 → 自动回退系统浏览器,不影响 AOT 发布。 -->
    <None Include="$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll" Link="Microsoft.Web.WebView2.Core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- DI 容器 + 日志(AOT 兼容) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McKuro.Core\McKuro.Core.csproj" />
  </ItemGroup>

  <!-- 多语言资源:内嵌 JSON,由 LanguageService 加载 -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\lang\*.json" />
  </ItemGroup>

  <!-- avares 资源:窗口图标 + 导航栏 Logo(Window.Icon 通过 avares:// 解析;ApplicationIcon 只管 exe 图标,两者独立) -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\shorekeeper_icon.png" />
  </ItemGroup>

  <!-- 极验滑块页 + 本地脚本 + 属性图标:发布到输出目录 -->
  <ItemGroup>
    <None Include="Assets\geetest.html" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Js\*.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\attr\*.png" CopyToOutputDirectory="PreserveNewest" />
    <!-- 每日数据官方图标(波片/结晶单质/活跃度/战令/战歌同奏,参照 Haiyu Assets/GameAssets/Waves 与 Java 版 WutheringWavesTool) -->
    <None Include="Assets\waves\*.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\HpatchzResource\hpatchz.exe" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\HpatchzResource\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\HpatchzResource\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    内置 Live2D 运行环境与「心」双形态模型:随包分发到输出目录的 live2d/ 子目录,
    正是 Live2DLocator.ProgramDir 探测的位置,因此用户零配置即可在首页看到模型。

    平台范围:Windows / macOS / Linux 都随包分发。渲染控件是 Avalonia 的
    OpenGlControlBase(不绑定 Windows),Cubism Core 三平台各有官方产物:
    Live2DCubismCore.dll(Windows)、libLive2DCubismCore.dylib(macOS universal)、
    libLive2DCubismCore.so(Linux x64)。三个文件同名目录并列存放,
    运行时由 Live2DLocator.CoreFileName 按平台挑名字。
    (dylib 的 .so 对其它平台是无害的多余文件,体积各约 120~270KB。)

    为什么可以随包分发 Cubism Core:官方 SDK 的 Core/RedistributableFiles.txt 明确把
    dll/windows/x86_64/Live2DCubismCore.dll、dll/macos/libLive2DCubismCore.dylib、
    dll/linux/x86_64/libLive2DCubismCore.so 都列为 "available for redistribution"
    (依据 Live2D Proprietary Software License Agreement 第 5 条)。分发时须保留
    许可声明并让用户同意等效条款 —— 见 Assets/live2d/NOTICE.txt。

    必须 Remove + Include(而不是只 Update):
    · 默认 glob <None Include="**/*"> 已收下这些文件,且它的 %(RecursiveDir) 是相对
      【项目根】的整段路径(Assets/live2d/心-红黑/),直接拿来拼 Link 会得到
      live2d/Assets/live2d/... 的错位路径。
    · 先 Remove 掉默认项,再用 <None Include="Assets/live2d/**/*"> 重新收一遍,
      此时 %(RecursiveDir) 才是相对该 glob 的 <模型>/<子目录>/,Link 结果正好是
      live2d/<模型>/... ,与 Live2DLocator.ProgramDir 一致。
    · 不 Remove 会因同一文件被收两次而报 NETSDK1022。

    shim/ 子目录是**构建工具**(shim.c + build-live2d-shim.sh),不是运行时资源:
    macOS/Linux 的 Core 已按平台预编译好放在 live2d/ 下,用户无需这些源码。
    故显式 Exclude 掉,避免给安装包平白多出源码文件。
  -->
  <ItemGroup>
    <None Remove="Assets\live2d\**\*" />
    <None Include="Assets\live2d\**\*"
          Exclude="Assets\live2d\shim\**\*"
          CopyToOutputDirectory="PreserveNewest"
          Link="live2d\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- macOS 构建后自动打包 libmpv + 依赖到 libmpv/ 子目录(仅构建脚本存在时,不阻断构建) -->
  <Target Name="BundleMpvMacOS" AfterTargets="AfterBuild" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Exec Command="bash &quot;$(MSBuildProjectDirectory)/bundle-mpv-macos.sh&quot; &quot;$(TargetDir)&quot;" Condition="Exists('$(MSBuildProjectDirectory)/bundle-mpv-macos.sh')" ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
