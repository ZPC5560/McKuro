<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:donet.ViewModels"
             xmlns:game="using:donet.Core.Models.Game"
             xmlns:controls="using:donet.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="donet.Views.LauncherView"
             x:DataType="vm:LauncherViewModel">
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部进度条 -->
        <ProgressBar IsIndeterminate="{Binding IsBusy}"
                     IsVisible="{Binding IsBusy}"
                     Height="3"
                     Background="Transparent" />

        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="16,10,16,0">
            <!-- 封面轮播 (Haiyu FlipView 风格) -->
            <Border Grid.Row="0"
                    Height="190"
                    CornerRadius="12"
                    Background="{DynamicResource SemiColorBg2}"
                    ClipToBounds="True">
                <Grid>
                    <Carousel x:Name="SlideCarousel"
                              ItemsSource="{Binding Slideshows}">
                        <Carousel.ItemTemplate>
                            <DataTemplate x:DataType="game:SlideshowItem">
                                <controls:AsyncImage ImageUrl="{Binding Url}"
                                                     Stretch="UniformToFill"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Stretch" />
                            </DataTemplate>
                        </Carousel.ItemTemplate>
                    </Carousel>

                    <!-- 轮播指示点 -->
                    <ItemsControl ItemsSource="{Binding Slideshows}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="game:SlideshowItem">
                                <Ellipse Width="7" Height="7" Fill="White" Opacity="0.5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 服务器选择 (覆盖左上) -->
                    <ComboBox ItemsSource="{Binding Servers}"
                              SelectedIndex="{Binding SelectedServerIndex, Mode=TwoWay}"
                              Margin="12,12,0,0"
                              Padding="10,4"
                              CornerRadius="14"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              MinWidth="110" />
                </Grid>
            </Border>

            <!-- 主内容区 -->
            <Grid Grid.Row="1" ColumnDefinitions="*,360" ColumnSpacing="14" Margin="0,12,0,0">
                <!-- 左侧:启动器操作区 -->
                <Grid RowDefinitions="*,Auto">
                    <!-- 游戏状态卡片 (Haiyu 左下玩家卡片风格) -->
                    <Border Grid.Row="0"
                            CornerRadius="12"
                            ClipToBounds="True"
                            VerticalAlignment="Top">
                        <Grid>
                            <!-- 官方背景封面:优先视频(可选),回退首帧图(氛围底图) -->
                            <controls:VideoBackgroundControl VideoUrl="{Binding BackgroundVideoUrl}"
                                                             FallbackImageUrl="{Binding BackgroundImageUrl}"
                                                             IsVideoEnabled="{Binding VideoEnabled}"
                                                             Opacity="0.25" />
                            <Border Background="{DynamicResource SemiColorBg2}"
                                    Opacity="0.9"
                                    Padding="18">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Border Width="48" Height="48" CornerRadius="10"
                                                Background="{DynamicResource SemiColorBg3}">
                                            <TextBlock Text="🌊" FontSize="24"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="鸣潮 · 启动器" FontSize="16" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding InstallStateText}" FontSize="12"
                                                       Foreground="{DynamicResource SemiColorText2}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="服务端版本" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBlock Text="{Binding ServerVersionText}" FontSize="15" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="状态" FontSize="11" Foreground="{DynamicResource SemiColorText2}" />
                                            <TextBlock Text="{Binding StatusText}" FontSize="13"
                                                       Foreground="{DynamicResource SemiColorPrimary}" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="检查更新" Command="{Binding CheckUpdateCommand}"
                                                IsEnabled="{Binding !IsBusy}" />
                                        <Button Content="打开目录" Command="{Binding OpenGameFolderCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 下载进度面板 -->
                    <Border Grid.Row="0"
                            CornerRadius="12"
                            Background="{DynamicResource SemiColorBg2}"
                            Padding="16"
                            Margin="0,10,0,0"
                            IsVisible="{Binding IsDownloading}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="下载进度" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding SpeedText}" FontSize="12"
                                           Foreground="{DynamicResource SemiColorPrimary}" />
                            </Grid>
                            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="10"
                                         CornerRadius="5" />
                            <TextBlock Text="{Binding ProgressText}" FontSize="12"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock Text="{Binding CurrentFileText}" FontSize="11"
                                       Foreground="{DynamicResource SemiColorText3}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- 底部:预下载环 + 启动大按钮 -->
                    <Grid Grid.Row="1" ColumnDefinitions="110,*" ColumnSpacing="18" Margin="0,12,0,0">
                        <!-- 预下载环 -->
                        <Grid Width="104" Height="104" HorizontalAlignment="Center">
                            <Border Width="92" Height="92" CornerRadius="46"
                                    BorderThickness="7"
                                    BorderBrush="{DynamicResource SemiColorBg3}">
                                <Border Width="92" Height="92" CornerRadius="46"
                                        BorderThickness="7"
                                        BorderBrush="{DynamicResource SemiColorPrimary}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}"
                                                   FontSize="17" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="预下载" FontSize="10"
                                                   Foreground="{DynamicResource SemiColorText2}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Border>
                            <Button Content="预下载" Classes="primary"
                                    Command="{Binding PreDownloadCommand}"
                                    IsEnabled="{Binding HasUpdate}"
                                    VerticalAlignment="Bottom"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,-12" />
                        </Grid>

                        <!-- 启动/安装大按钮 (Haiyu 绿色 60px) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                            <Button Height="64"
                                    Padding="24,0"
                                    Classes="primary"
                                    FontSize="18"
                                    Command="{Binding InstallCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    IsVisible="{Binding !IsInstalled}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Grid Width="40" Height="40">
                                        <TextBlock Text="⬇" FontSize="24" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <controls:AsyncImage ImageUrl="{Binding VersionLogoUrl}"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Stretch" />
                                    </Grid>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="下载安装" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ServerVersionText}" FontSize="11" Opacity="0.85" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Height="64"
                                    Padding="24,0"
                                    Classes="primary"
                                    FontSize="18"
                                    Command="{Binding LaunchCommand}"
                                    IsEnabled="{Binding IsInstalled}"
                                    HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <Grid Width="40" Height="40">
                                        <TextBlock Text="▶" FontSize="24" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <controls:AsyncImage ImageUrl="{Binding VersionLogoUrl}"
                                                             Stretch="Uniform"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Stretch" />
                                    </Grid>
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="启动游戏" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ServerVersionText}" FontSize="11" Opacity="0.85" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button Content="安装更新"
                                    Command="{Binding InstallCommand}"
                                    IsEnabled="{Binding !IsBusy}"
                                    IsVisible="{Binding HasUpdate}"
                                    HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 右侧:公告 / 活动 / 新闻 -->
                <Border Grid.Column="1"
                        CornerRadius="12"
                        Background="{DynamicResource SemiColorBg2}"
                        Padding="16">
                    <Grid RowDefinitions="Auto,Auto,*">
                        <TextBlock Text="📢 公告与活动" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <TextBlock Text="公告" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorPrimary}" />
                            <TextBlock Text="活动" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock Text="新闻" FontSize="12" Foreground="{DynamicResource SemiColorText2}" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden">
                            <StackPanel Spacing="4">
                                <TextBlock Text="公告" FontSize="11" Foreground="{DynamicResource SemiColorText3}"
                                           Margin="0,2,0,2" IsVisible="{Binding Notices.Count}" />
                                <ItemsControl ItemsSource="{Binding Notices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="game:AnnouncementItem">
                                            <Border Padding="6,4" CornerRadius="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding Time}" FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText3}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SemiColorText2}" />
                                                    <TextBlock Grid.Column="2" Text="›" FontSize="12"
                                                               Foreground="{DynamicResource SemiColorPrimary}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="活动" FontSize="11" Foreground="{DynamicResource SemiColorText3}"
                                           Margin="0,6,0,2" IsVisible="{Binding Activities.Count}" />
                                <ItemsControl ItemsSource="{Binding Activities}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="game:AnnouncementItem">
                                            <Border Padding="6,4" CornerRadius="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding Time}" FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText3}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SemiColorText2}" />
                                                    <TextBlock Grid.Column="2" Text="›" FontSize="12"
                                                               Foreground="{DynamicResource SemiColorPrimary}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="新闻" FontSize="11" Foreground="{DynamicResource SemiColorText3}"
                                           Margin="0,6,0,2" IsVisible="{Binding News.Count}" />
                                <ItemsControl ItemsSource="{Binding News}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="game:AnnouncementItem">
                                            <Border Padding="6,4" CornerRadius="6">
                                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding Time}" FontSize="11"
                                                               Foreground="{DynamicResource SemiColorText3}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="12"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SemiColorText2}" />
                                                    <TextBlock Grid.Column="2" Text="›" FontSize="12"
                                                               Foreground="{DynamicResource SemiColorPrimary}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="暂无公告内容(离线或未加载)" FontSize="12"
                                           Foreground="{DynamicResource SemiColorText3}"
                                           HorizontalAlignment="Center" Margin="0,20"
                                           IsVisible="{Binding !Notices.Count}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
