<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:donet.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="donet.Views.HomeView"
             x:DataType="vm:HomeViewModel">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- 欢迎横幅 (Haiyu 风格:渐变卡片) -->
        <Border Grid.Row="0"
                CornerRadius="10"
                Background="{DynamicResource SemiColorPrimary}"
                Padding="30,40"
                Margin="0,0,0,20">
            <StackPanel Spacing="8">
                <TextBlock Text="🌊 donet · 鸣潮启动器"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="White" />
                <TextBlock Text="整合 Haiyu 界面与鸣潮助手:游戏更新 / 抽卡分析 / 角色数据"
                           FontSize="15"
                           Foreground="#CCFFFFFF" />
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,12,0,0">
                    <StackPanel Spacing="2">
                        <TextBlock Text="安装状态" FontSize="12" Foreground="#AAFFFFFF" />
                        <TextBlock Text="{Binding InstallStateText}" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                    <StackPanel Spacing="2">
                        <TextBlock Text="服务器渠道" FontSize="12" Foreground="#AAFFFFFF" />
                        <TextBlock Text="{Binding ServerTypeText}" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                    </StackPanel>
                    <Button Content="刷新状态"
                            Background="#33FFFFFF"
                            BorderThickness="0"
                            Foreground="White"
                            VerticalAlignment="Bottom"
                            Command="{Binding RefreshCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 功能卡片 -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="16">
            <Border CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="🌊" FontSize="28" />
                    <TextBlock Text="游戏更新" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="检查更新、预下载与安装,断点续传 + MD5 校验 + 并发下载。"
                               FontSize="13"
                               Foreground="{DynamicResource SemiColorText2}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="🎴" FontSize="28" />
                    <TextBlock Text="抽卡分析" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="解析游戏日志获取抽卡记录,统计保底、歪率、评分与称号,本地存储。"
                               FontSize="13"
                               Foreground="{DynamicResource SemiColorText2}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" CornerRadius="10" Background="{DynamicResource SemiColorBg2}" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="👤" FontSize="28" />
                    <TextBlock Text="角色养成" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="库街区同步或本地解析,原生显示角色等级、武器、技能与共鸣链。"
                               FontSize="13"
                               Foreground="{DynamicResource SemiColorText2}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
