<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:roles="using:donet.Core.Models.Roles"
             xmlns:vm="using:donet.ViewModels"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="700"
             x:Class="donet.Views.RolesView"
             x:DataType="vm:RolesViewModel">
    <UserControl.Resources>
        <vm:BoolToBrushConverter x:Key="BoolToBrush" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Margin="28">
        <!-- 标题 -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="角色养成" FontSize="26" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{Binding StatusText}"
                           FontSize="13"
                           Foreground="{DynamicResource SemiColorText2}" />
                <TextBlock Text="{Binding SourceText}"
                           FontSize="13"
                           Foreground="{DynamicResource SemiColorPrimary}" />
            </StackPanel>
        </StackPanel>

        <!-- 操作 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
            <Button Content="从库街区同步" Classes="primary"
                    Command="{Binding LoadFromKujiequCommand}"
                    IsEnabled="{Binding !IsBusy}" />
            <Button Content="读取本地数据" Command="{Binding LoadFromLocalCommand}" />
            <TextBlock VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource SemiColorText3}"
                       Text="库街区同步需要 Token 与角色 ID(见设置页)" />
        </StackPanel>

        <!-- 内容:角色列表 + 详情 -->
        <Grid Grid.Row="2" ColumnDefinitions="300,*" ColumnSpacing="16"
              IsVisible="{Binding HasRoles}">
            <!-- 角色列表 -->
            <ListBox Grid.Column="0"
                     ItemsSource="{Binding Roles}"
                     SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="roles:RoleDetail">
                        <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                                Background="{DynamicResource SemiColorBg2}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{Binding RoleName}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}">
                                    <Run Text="Lv." /><Run Text="{Binding Role.Level}" />
                                    <Run Text=" · " /><Run Text="{Binding AttributeName}" />
                                    <Run Text=" · 链" /><Run Text="{Binding ChainCount}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 角色详情 -->
            <ScrollViewer Grid.Column="1">
                <Border CornerRadius="12"
                        Background="{DynamicResource SemiColorBg2}"
                        Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding SelectedRole.RoleName}" FontSize="22" FontWeight="Bold" />
                            <TextBlock FontSize="13" Foreground="{DynamicResource SemiColorText2}">
                                <Run Text="等级 " /><Run Text="{Binding SelectedRole.Role.Level}" />
                                <Run Text=" · 突破 " /><Run Text="{Binding SelectedRole.Role.Breach}" />
                                <Run Text=" · 属性 " /><Run Text="{Binding SelectedRole.AttributeName}" />
                            </TextBlock>
                        </StackPanel>

                        <Separator />

                        <!-- 武器 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="武器" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <TextBlock FontSize="15">
                                <Run Text="{Binding SelectedRole.WeaponData.DisplayName}" />
                                <Run Text=" Lv." /><Run Text="{Binding SelectedRole.WeaponData.Level}" />
                                <Run Text=" 精炼 " /><Run Text="{Binding SelectedRole.WeaponData.Rank}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- 技能 -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="技能等级" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText2}" />
                            <ItemsControl ItemsSource="{Binding SelectedRole.Skills}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="roles:SkillInfo">
                                        <Border CornerRadius="8" Background="{DynamicResource SemiColorBg3}"
                                                Padding="10,6" Margin="0,0,8,8">
                                            <TextBlock FontSize="13">
                                                <Run Text="{Binding SkillName}" />
                                                <Run Text=" Lv." /><Run Text="{Binding SkillLevel}" />
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- 共鸣链 -->
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SemiColorText2}">
                                <Run Text="共鸣链 " />
                                <Run Text="{Binding SelectedRole.UnlockedChainCount}" />
                                <Run Text="/" />
                                <Run Text="{Binding SelectedRole.ChainCount}" />
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding SelectedRole.Chains}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="roles:ChainInfo">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                            <TextBlock Text="{Binding ChainNum, StringFormat=链{0}}" Width="36"
                                                       FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ChainName}" FontSize="12"
                                                       Foreground="{Binding IsUnlock, Converter={StaticResource BoolToBrush}}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- 空状态 -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                    IsVisible="{Binding !HasRoles}">
            <TextBlock Text="暂无角色数据" FontSize="18" Foreground="{DynamicResource SemiColorText2}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="点击「从库街区同步」拉取当前账号角色,或「读取本地数据」解析游戏本地缓存。"
                       FontSize="13" Foreground="{DynamicResource SemiColorText3}"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
