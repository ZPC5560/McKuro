<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:donet.ViewModels"
             xmlns:gacha="using:donet.Core.Models.Gacha"
             xmlns:controls="using:donet.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="donet.Views.GachaView"
             x:DataType="vm:GachaViewModel">

    <Grid RowDefinitions="Auto,*">
        <!-- 标题 + 同步按钮 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,20,12">
            <StackPanel Spacing="2">
                <TextBlock Text="🎴 抽卡分析" FontSize="24" FontWeight="Bold" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding StatusText}" FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}" />
                    <TextBlock Text="{Binding PlayerIdText, StringFormat=玩家: {0}}" FontSize="12"
                               Foreground="{DynamicResource SemiColorPrimary}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="从日志同步" Classes="primary"
                    VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="300,*">
            <!-- 左侧:卡池 + 五星列表 -->
            <Border Grid.Column="0"
                    Margin="0,0,5,10"
                    Padding="12"
                    Background="{DynamicResource SemiColorBg2}"
                    CornerRadius="10">
                <Grid RowDefinitions="Auto,Auto,*">
                    <ComboBox ItemsSource="{Binding Pools}"
                              SelectedItem="{Binding SelectedPool, Mode=TwoWay}"
                              Margin="0,0,0,8">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="gacha:PoolStats">
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="1"
                               Margin="4,0,4,8"
                               FontSize="12"
                               Foreground="{DynamicResource SemiColorText2}">
                        <Run Text="平均出货: " /><Run Text="{Binding StarAvgValue, StringFormat={}{0:0.#}}" /><Run Text=" 抽" />
                        <Run Text="  ·  当前垫 " /><Run Text="{Binding SelectedPool.CurrentPity}" />
                    </TextBlock>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding FiveStarEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gacha:FiveStarEntry">
                                    <Border Margin="0,4"
                                            Padding="10"
                                            Background="{DynamicResource SemiColorBg3}"
                                            CornerRadius="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                            <Border Grid.RowSpan="2"
                                                    Width="36" Height="36"
                                                    CornerRadius="6"
                                                    Background="{DynamicResource SemiColorBg2}"
                                                    ClipToBounds="True">
                                                <controls:AsyncImage ImageUrl="{Binding IconUrl}"
                                                                     Width="36" Height="36"
                                                                     Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Margin="8,0,0,0"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Record.Name}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Grid.Column="2"
                                                    Grid.RowSpan="2"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Background="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagConverter.Instance}}">
                                                <TextBlock FontSize="11" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           Text="{Binding IsOffBanner, Converter={x:Static vm:FiveStarFlagTextConverter.Instance}}" />
                                            </Border>
                                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" Margin="8,2,0,0">
                                                <ProgressBar Minimum="0" Maximum="80"
                                                             Height="8"
                                                             CornerRadius="4"
                                                             Value="{Binding Pity}"
                                                             Foreground="{Binding IsOffBanner, Converter={x:Static vm:PityBarBrushConverter.Instance}}" />
                                                <TextBlock Grid.Column="1"
                                                           Margin="6,0,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SemiColorText2}"
                                                           Text="{Binding Pity, StringFormat={}{0} 抽}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧:统计条 + 图表 -->
            <Grid Grid.Column="1" Margin="5,0,0,10">
                <ScrollViewer>
                    <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                        <!-- 统计条 (8 列) -->
                        <Border Grid.ColumnSpan="3" CornerRadius="10" Padding="10,14"
                                Background="{DynamicResource SemiColorBg2}">
                            <Grid ColumnDefinitions="*,*,*,*,*,*,*,*">
                                <StackPanel HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="总抽数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalPulls}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="称号" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Designation}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource SemiColorPrimary}" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="双金次数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DoubleCount}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="歪的次数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CrookedTotal}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="综合评分" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding Score}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="5" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="平均出货" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                        <Run Text="{Binding AvgPulls}" /><Run Text=" 抽" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="6" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="出货率" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                        <Run Text="{Binding ActualFiveStarRate}" /><Run Text="%" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="7" HorizontalAlignment="Center" Spacing="2">
                                    <TextBlock Text="记录天数" FontSize="11" Foreground="{DynamicResource SemiColorText2}" HorizontalAlignment="Center" />
                                    <TextBlock FontSize="18" FontWeight="Bold" HorizontalAlignment="Center">
                                        <Run Text="{Binding Days}" /><Run Text=" 天" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 保底状态饼图 -->
                        <Border Grid.Row="1" CornerRadius="10" Padding="12"
                                Background="{DynamicResource SemiColorBg2}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding GuaranteeHeader}" FontSize="13" FontWeight="SemiBold" />
                                <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding GuaranteeSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                <Path Data="{Binding Data}" Fill="{Binding Brush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{Binding TotalFiveStars}" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="五星" FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <!-- 图例 -->
                                <ItemsControl ItemsSource="{Binding GuaranteeSlices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PieSliceViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,10,2">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 出货占比饼图 -->
                        <Border Grid.Row="1" Grid.Column="1" CornerRadius="10" Padding="12"
                                Background="{DynamicResource SemiColorBg2}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="出货占比" FontSize="13" FontWeight="SemiBold" />
                                <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding StarRatioSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                <Path Data="{Binding Data}" Fill="{Binding Brush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                                        <TextBlock Text="{Binding TotalPulls}" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="总抽数" FontSize="11" Foreground="{DynamicResource SemiColorText2}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding StarRatioSlices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PieSliceViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,10,2">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 各卡池占比饼图 -->
                        <Border Grid.Row="1" Grid.Column="2" CornerRadius="10" Padding="12"
                                Background="{DynamicResource SemiColorBg2}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="各卡池抽数占比" FontSize="13" FontWeight="SemiBold" />
                                <Grid Width="140" Height="140" HorizontalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding PoolSlices}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Grid />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PieSliceViewModel">
                                                <Path Data="{Binding Data}" Fill="{Binding Brush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding PoolSlices}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PieSliceViewModel">
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,2,10,2">
                                                <Ellipse Width="8" Height="8" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="70" />
                                                <TextBlock Text="{Binding Value}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SemiColorText2}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- 每日抽数折线图 (自绘 Path) -->
                        <Border Grid.Row="2" Grid.ColumnSpan="3" CornerRadius="10" Padding="12"
                                Background="{DynamicResource SemiColorBg2}">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <TextBlock Text="每日抽数" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Grid.Row="1" Height="150" Margin="0,0,0,6">
                                    <Path Data="{Binding TimeLinePathData}"
                                          Fill="#221677FF"
                                          Stroke="#1677FF"
                                          StrokeThickness="2"
                                          Stretch="Fill" />
                                </Grid>
                                <!-- 日期标签 -->
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding TimeLineLabels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Grid ColumnDefinitions="*" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontSize="10"
                                                       Foreground="{DynamicResource SemiColorText3}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
